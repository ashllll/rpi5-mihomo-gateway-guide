# Local tool state: CodeGraph index and cognitive-graph index notes.
# Never published, and must stay ignored so the publication gates keep
# scanning tracked files only (tools/validate_public.py also lists untracked
# files, and the CI archive check allows exactly one binary file).
.codegraph/
.lingshu/
.ruff_cache/
.archify/

# Live box forensics: raw snapshot from the running rp5 (real LAN/ISP/
# subscription data) and the design contract derived from it. Scratch inputs
# only, never published.
_live/
_scratch/

# Local MCP tool state (Serena); never published.
.serena/

# Short-lived temp roots used by the gate when TMPDIR is too long for AF_UNIX.
.preflight-tmp/
.audit-tmp/
