+package measurementbudget
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"time"
+)
+
+const (
+	Protocol        = "mihomo-budget-v1"
+	SocketEnv       = "MIHOMO_MEASUREMENT_SOCKET"
+	DefaultSocket   = "/run/mihomo-measurements/budget.sock"
+	ioTimeout       = time.Second
+	maxResponseSize = 4 * 1024
+)
+
+var ErrDenied = errors.New("measurement budget denied")
+
+type request struct {
+	Protocol   string `json:"protocol"`
+	Name       string `json:"name"`
+	Addr       string `json:"addr"`
+	Dialer     string `json:"dialer"`
+	DeadlineMS int64  `json:"deadline_ms"`
+}
+
+type response struct {
+	Protocol string `json:"protocol"`
+	Allowed  *bool  `json:"allowed"`
+}
+
+func SocketPath() string {
+	if path := os.Getenv(SocketEnv); path != "" {
+		return path
+	}
+	return DefaultSocket
+}
+
+// Check requires an explicit admission response before a URL health check can dial.
+func Check(ctx context.Context, name, addr, dialer string) error {
+	if ctx.Err() != nil {
+		return ErrDenied
+	}
+
+	deadline := time.Now().Add(ioTimeout)
+	if ctxDeadline, ok := ctx.Deadline(); ok {
+		if !ctxDeadline.After(time.Now()) {
+			return ErrDenied
+		}
+		if ctxDeadline.Before(deadline) {
+			deadline = ctxDeadline
+		}
+	}
+
+	requestDeadlineMS := int64(0)
+	if ctxDeadline, ok := ctx.Deadline(); ok {
+		requestDeadlineMS = ctxDeadline.UnixMilli()
+	}
+	req := request{
+		Protocol:   Protocol,
+		Name:       name,
+		Addr:       addr,
+		Dialer:     dialer,
+		DeadlineMS: requestDeadlineMS,
+	}
+
+	ioCtx, cancel := context.WithDeadline(ctx, deadline)
+	defer cancel()
+	conn, err := (&net.Dialer{}).DialContext(ioCtx, "unix", SocketPath())
+	if err != nil {
+		return ErrDenied
+	}
+	defer conn.Close()
+	if err := conn.SetDeadline(deadline); err != nil {
+		return ErrDenied
+	}
+
+	watchStop := make(chan struct{})
+	watchDone := make(chan struct{})
+	go func() {
+		defer close(watchDone)
+		select {
+		case <-ctx.Done():
+			_ = conn.SetDeadline(time.Now())
+		case <-watchStop:
+		}
+	}()
+	defer func() {
+		close(watchStop)
+		<-watchDone
+	}()
+
+	if err := json.NewEncoder(conn).Encode(req); err != nil {
+		return ErrDenied
+	}
+	reader := bufio.NewReader(io.LimitReader(conn, maxResponseSize+1))
+	body, err := reader.ReadBytes('\n')
+	if err != nil || len(body) > maxResponseSize || reader.Buffered() != 0 {
+		return ErrDenied
+	}
+	var reply response
+	if json.Unmarshal(body, &reply) != nil || reply.Protocol != Protocol || reply.Allowed == nil || !*reply.Allowed {
+		return ErrDenied
+	}
+	if ctx.Err() != nil {
+		return ErrDenied
+	}
+	return nil
+}
