+package provider_test
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/provider"
+	"github.com/metacubex/mihomo/component/resource"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+	T "github.com/metacubex/mihomo/tunnel"
+)
+
+type statusAliasTunnel struct {
+	C.Tunnel
+	providers map[string]P.ProxyProvider
+}
+
+func (t *statusAliasTunnel) Providers() map[string]P.ProxyProvider { return t.providers }
+
+func aliasStatusServer(t *testing.T) *httptest.Server {
+	t.Helper()
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(503)
+	}))
+	t.Cleanup(s.Close)
+	return s
+}
+
+func TestConfiguredStatusAppliesToParsedGlobalAlias(t *testing.T) {
+	statusAdmission(t)
+	s := aliasStatusServer(t)
+	tunnel := &statusAliasTunnel{providers: make(map[string]P.ProxyProvider)}
+	node := map[string]any{"name": "Synthetic A", "type": "direct"}
+	global, err := adapter.ParseProxy(node, adapter.WithTunnelForAPI(tunnel))
+	if err != nil {
+		t.Fatal(err)
+	}
+	p, err := provider.ParseProxyProvider("owned", map[string]any{
+		"type": "inline", "payload": []map[string]any{node},
+		"health-check": map[string]any{"enable": false, "url": s.URL, "expected-status": "204"},
+	}, tunnel)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = p.(*provider.InlineProvider).Close() })
+	tunnel.providers["owned"] = p
+	managed := p.Proxies()[0]
+	if global == managed {
+		t.Fatal("fixture must reproduce distinct global and inline-provider proxy objects")
+	}
+	p.HealthCheck()
+	for _, expected := range []string{"", "*", "200-599", "503"} {
+		if _, err := global.URLTest(context.Background(), s.URL, statusRanges(t, expected)); err == nil || global.AliveForTestUrl(s.URL) {
+			t.Fatalf("parsed global alias relaxed configured status with expected=%q: %v", expected, err)
+		}
+		if managed.AliveForTestUrl(s.URL) {
+			t.Fatal("global alias retest revived managed provider health")
+		}
+	}
+	if _, err := global.URLTest(context.Background(), s.URL+"/ad-hoc", nil); err != nil {
+		t.Fatalf("distinct ad-hoc URL inherited alias contract: %v", err)
+	}
+	_ = p.(*provider.InlineProvider).Close()
+	if _, err := global.URLTest(context.Background(), s.URL, nil); err != nil {
+		t.Fatalf("closed provider contract remained attached to global alias: %v", err)
+	}
+}
+
+func TestConfiguredStatusGlobalAliasConcurrentProviderRefresh(t *testing.T) {
+	statusAdmission(t)
+	s := aliasStatusServer(t)
+	tunnel := &statusAliasTunnel{providers: make(map[string]P.ProxyProvider)}
+	node := map[string]any{"name": "Synthetic A", "type": "direct"}
+	global, err := adapter.ParseProxy(node, adapter.WithTunnelForAPI(tunnel))
+	if err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(t.TempDir(), "provider.yaml")
+	parser := func(_ []byte) ([]C.Proxy, error) {
+		var proxies []C.Proxy
+		for i := 0; i < 15; i++ {
+			name := "Synthetic A"
+			if i != 0 {
+				name = fmt.Sprintf("Synthetic B%02d", i)
+			}
+			p, err := adapter.ParseProxy(map[string]any{"name": name, "type": "direct"}, adapter.WithTunnelForAPI(tunnel), adapter.WithProviderName("owned"))
+			if err != nil {
+				return nil, err
+			}
+			proxies = append(proxies, p)
+		}
+		return proxies, nil
+	}
+	hc := provider.NewHealthCheck(nil, s.URL, 1000, 0, false, statusRanges(t, "204"))
+	p, err := provider.NewProxySetProvider("owned", 0, nil, parser, resource.NewFileVehicle(path), hc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = p.Close() })
+	tunnel.providers["owned"] = p
+	update := func(i int) {
+		t.Helper()
+		if err := os.WriteFile(path, []byte(fmt.Sprint(i)), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := p.Update(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	update(-1)
+	var wg sync.WaitGroup
+	wg.Add(3)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 30; i++ {
+			update(i)
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 30; i++ {
+			if _, err := global.URLTest(context.Background(), s.URL, nil); err == nil {
+				t.Error("global alias escaped active configured status during provider refresh")
+			}
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		p.HealthCheck()
+	}()
+	wg.Wait()
+}
+
+type aliasIdentityAdapter struct {
+	C.ProxyAdapter
+	name string
+	addr string
+	tp   C.AdapterType
+	info C.ProxyInfo
+}
+
+func (a *aliasIdentityAdapter) Name() string           { return a.name }
+func (a *aliasIdentityAdapter) Addr() string           { return a.addr }
+func (a *aliasIdentityAdapter) Type() C.AdapterType    { return a.tp }
+func (a *aliasIdentityAdapter) ProxyInfo() C.ProxyInfo { return a.info }
+
+func TestConfiguredStatusAliasRequiresMatchingIdentity(t *testing.T) {
+	statusAdmission(t)
+	s := aliasStatusServer(t)
+	tunnel := &statusAliasTunnel{providers: make(map[string]P.ProxyProvider)}
+	global, err := adapter.ParseProxy(map[string]any{"name": "Synthetic A", "type": "direct"}, adapter.WithTunnelForAPI(tunnel))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, field := range []string{"name", "type", "address", "dialer", "interface"} {
+		t.Run(field, func(t *testing.T) {
+			identity := &aliasIdentityAdapter{ProxyAdapter: global.Adapter(), name: global.Name(), addr: global.Addr(), tp: global.Type(), info: global.ProxyInfo()}
+			switch field {
+			case "name":
+				identity.name = "Unrelated"
+			case "type":
+				identity.tp = C.Http
+			case "address":
+				identity.addr = "different.invalid:443"
+			case "dialer":
+				identity.info.DialerProxy = "Different"
+			case "interface":
+				identity.info.Interface = "Different"
+			}
+			other := adapter.NewProxy(identity)
+			p := statusProvider(t, []C.Proxy{other}, s.URL, "204")
+			tunnel.providers["candidate"] = p
+			if _, err := global.URLTest(context.Background(), s.URL, nil); err != nil {
+				t.Fatalf("different %s inherited an unrelated contract: %v", field, err)
+			}
+		})
+	}
+}
+
+func TestConfiguredStatusAliasConcurrentTunnelReload(t *testing.T) {
+	statusAdmission(t)
+	s := aliasStatusServer(t)
+	oldProxies, oldProviders := T.Proxies(), T.Providers()
+	t.Cleanup(func() { T.UpdateProxies(oldProxies, oldProviders) })
+	node := map[string]any{"name": "Synthetic A", "type": "direct"}
+	parse := func() C.Proxy {
+		t.Helper()
+		p, err := adapter.ParseProxy(node, adapter.WithTunnelForAPI(T.Tunnel))
+		if err != nil {
+			t.Fatal(err)
+		}
+		return p
+	}
+	global := parse()
+	first := statusProvider(t, []C.Proxy{parse()}, s.URL, "204")
+	second := statusProvider(t, []C.Proxy{parse()}, s.URL, "204")
+	maps := []map[string]P.ProxyProvider{{"first": first}, {"second": second}}
+	T.UpdateProxies(nil, maps[0])
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 100; i++ {
+			T.UpdateProxies(nil, maps[i%2])
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 30; i++ {
+			if _, err := global.URLTest(context.Background(), s.URL, nil); err == nil {
+				t.Error("alias escaped configured status during tunnel reload")
+			}
+		}
+	}()
+	wg.Wait()
+}
