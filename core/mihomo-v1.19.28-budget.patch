+func (bp *baseProvider) HealthCheckStatus(proxy C.Proxy, url string, status uint16) (owned, accepted bool) {
+	bp.mutex.RLock()
+	defer bp.mutex.RUnlock()
+	accepted = true
+	info := proxy.ProxyInfo()
+	info.ProviderName = ""
+	for _, alias := range bp.proxies {
+		aliasInfo := alias.ProxyInfo()
+		aliasInfo.ProviderName = ""
+		if alias.Name() != proxy.Name() || alias.Type() != proxy.Type() || alias.Addr() != proxy.Addr() || aliasInfo != info {
+			continue
+		}
+		if checker, ok := alias.(interface {
+			HealthCheckStatus(string, uint16) (bool, bool)
+		}); ok {
+			aliasOwned, aliasAccepted := checker.HealthCheckStatus(url, status)
+			owned = owned || aliasOwned
+			accepted = accepted && aliasAccepted
+		}
+	}
+	return
