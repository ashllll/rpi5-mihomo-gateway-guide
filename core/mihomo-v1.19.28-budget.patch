@@ -0,0 +1,414 @@
+package adapter
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	syncatomic "sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outbound"
+	"github.com/metacubex/mihomo/common/atomic"
+	"github.com/metacubex/mihomo/common/queue"
+	"github.com/metacubex/mihomo/component/measurementbudget"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+const budgetTestURL = "https://health.example/"
+
+type budgetTestAdapter struct {
+	C.ProxyAdapter
+	dialCount syncatomic.Int32
+	info      C.ProxyInfo
+}
+
+func (a *budgetTestAdapter) Name() string           { return "test-proxy" }
+func (a *budgetTestAdapter) Addr() string           { return "proxy.example:443" }
+func (a *budgetTestAdapter) ProxyInfo() C.ProxyInfo { return a.info }
+func (a *budgetTestAdapter) DialContext(context.Context, *C.Metadata) (C.Conn, error) {
+	a.dialCount.Add(1)
+	return nil, errors.New("dial failed")
+}
+
+func newBudgetTestProxy() (*Proxy, *budgetTestAdapter) {
+	adapter := &budgetTestAdapter{info: C.ProxyInfo{DialerProxy: "upstream"}}
+	return &Proxy{
+		ProxyAdapter: adapter,
+		alive:        atomic.NewBool(true),
+		history:      queue.New[C.DelayHistory](defaultHistoriesNum),
+	}, adapter
+}
+
+type budgetTestRequest struct {
+	Protocol   string `json:"protocol"`
+	Name       string `json:"name"`
+	Addr       string `json:"addr"`
+	Dialer     string `json:"dialer"`
+	DeadlineMS int64  `json:"deadline_ms"`
+}
+
+func startBudgetTestServer(t *testing.T, respond func(net.Conn)) (string, <-chan budgetTestRequest) {
+	t.Helper()
+
+	dir, err := os.MkdirTemp("/tmp", "mihomo-budget-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+
+	socketPath := filepath.Join(dir, "budget.sock")
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = listener.Close() })
+
+	requests := make(chan budgetTestRequest, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+
+		var request budgetTestRequest
+		if err := json.NewDecoder(conn).Decode(&request); err != nil {
+			return
+		}
+		requests <- request
+		respond(conn)
+	}()
+
+	t.Setenv(measurementbudget.SocketEnv, socketPath)
+	return socketPath, requests
+}
+
+func receiveBudgetTestRequest(t *testing.T, requests <-chan budgetTestRequest) budgetTestRequest {
+	t.Helper()
+	select {
+	case request := <-requests:
+		if request.Protocol != "mihomo-budget-v1" || request.Name != "test-proxy" || request.Addr != "proxy.example:443" || request.Dialer != "upstream" {
+			t.Fatalf("unexpected budget request: %+v", request)
+		}
+		return request
+	case <-time.After(time.Second):
+		t.Fatal("budget request was not received")
+		return budgetTestRequest{}
+	}
+}
+
+func seedBudgetTestHistory(p *Proxy, url string) ([]C.DelayHistory, []C.DelayHistory) {
+	record := C.DelayHistory{Time: time.Unix(123, 0), Delay: 7}
+	p.history.Put(record)
+	state := &internalProxyState{
+		alive:   atomic.NewBool(true),
+		history: queue.New[C.DelayHistory](defaultHistoriesNum),
+	}
+	state.history.Put(record)
+	p.extra.Store(url, state)
+	return p.DelayHistory(), p.DelayHistoryForTestUrl(url)
+}
+
+func TestURLTestBudgetDenialsPreserveHealthState(t *testing.T) {
+	tests := []struct {
+		name     string
+		response string
+		hold     bool
+		missing  bool
+	}{
+		{name: "missing socket", missing: true},
+		{name: "rejected", response: `{"protocol":"mihomo-budget-v1","allowed":false}`},
+		{name: "wrong protocol", response: `{"protocol":"other","allowed":true}`},
+		{name: "wrong field type", response: `{"protocol":1,"allowed":true}`},
+		{name: "oversized response", response: `{"protocol":"mihomo-budget-v1","allowed":true,"padding":"` + strings.Repeat("x", 4096) + `"}`},
+		{name: "deadline", hold: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var requests <-chan budgetTestRequest
+			release := make(chan struct{})
+			if !tt.missing {
+				_, requests = startBudgetTestServer(t, func(conn net.Conn) {
+					if tt.hold {
+						<-release
+						return
+					}
+					_, _ = conn.Write([]byte(tt.response + "\n"))
+				})
+				t.Cleanup(func() { close(release) })
+			} else {
+				dir, err := os.MkdirTemp("/tmp", "mihomo-budget-missing-")
+				if err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() { _ = os.RemoveAll(dir) })
+				t.Setenv(measurementbudget.SocketEnv, filepath.Join(dir, "missing.sock"))
+			}
+
+			p, adapter := newBudgetTestProxy()
+			baseHistory, urlHistory := seedBudgetTestHistory(p, budgetTestURL)
+			ctx := context.Background()
+			var cancel context.CancelFunc
+			if tt.hold {
+				ctx, cancel = context.WithTimeout(ctx, 35*time.Millisecond)
+				defer cancel()
+			}
+
+			started := time.Now()
+			_, err := p.URLTest(ctx, budgetTestURL, nil)
+			if !tt.missing {
+				request := receiveBudgetTestRequest(t, requests)
+				if tt.hold {
+					wantDeadline, _ := ctx.Deadline()
+					if request.DeadlineMS != wantDeadline.UnixMilli() {
+						t.Fatalf("deadline_ms = %d, want %d", request.DeadlineMS, wantDeadline.UnixMilli())
+					}
+				} else if request.DeadlineMS < started.Add(30*time.Second).UnixMilli() || request.DeadlineMS > started.Add(31*time.Second).UnixMilli() {
+					t.Fatalf("deadline_ms = %d, want deadline at the 30 second URLTest cap", request.DeadlineMS)
+				}
+			}
+			if !errors.Is(err, measurementbudget.ErrDenied) {
+				t.Fatalf("URLTest error = %v, want measurement budget denial", err)
+			}
+			if got := adapter.dialCount.Load(); got != 0 {
+				t.Fatalf("DialContext called %d times after budget denial", got)
+			}
+			if !p.alive.Load() || !p.AliveForTestUrl(budgetTestURL) {
+				t.Fatal("budget denial changed existing alive state")
+			}
+			if got := p.DelayHistory(); !reflect.DeepEqual(got, baseHistory) {
+				t.Fatalf("base health history changed: got %+v, want %+v", got, baseHistory)
+			}
+			if got := p.DelayHistoryForTestUrl(budgetTestURL); !reflect.DeepEqual(got, urlHistory) {
+				t.Fatalf("URL health history changed: got %+v, want %+v", got, urlHistory)
+			}
+		})
+	}
+}
+
+func TestURLTestBudgetCancellationDoesNotDial(t *testing.T) {
+	received := make(chan struct{})
+	release := make(chan struct{})
+	_, requests := startBudgetTestServer(t, func(net.Conn) {
+		close(received)
+		<-release
+	})
+	defer close(release)
+
+	p, adapter := newBudgetTestProxy()
+	baseHistory, urlHistory := seedBudgetTestHistory(p, budgetTestURL)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() {
+		_, err := p.URLTest(ctx, budgetTestURL, nil)
+		done <- err
+	}()
+
+	select {
+	case <-received:
+	case <-time.After(time.Second):
+		t.Fatal("budget request was not received")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, measurementbudget.ErrDenied) {
+			t.Fatalf("URLTest error = %v, want measurement budget denial", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("URLTest did not stop after context cancellation")
+	}
+	if got := adapter.dialCount.Load(); got != 0 {
+		t.Fatalf("DialContext called %d times after cancellation", got)
+	}
+	if got := p.DelayHistory(); !reflect.DeepEqual(got, baseHistory) {
+		t.Fatalf("base health history changed: got %+v, want %+v", got, baseHistory)
+	}
+	if got := p.DelayHistoryForTestUrl(budgetTestURL); !reflect.DeepEqual(got, urlHistory) {
+		t.Fatalf("URL health history changed: got %+v, want %+v", got, urlHistory)
+	}
+	_ = receiveBudgetTestRequest(t, requests)
+}
+
+func TestURLTestAdmittedDialFailureMarksProxyDead(t *testing.T) {
+	parentDeadline := time.Now().Add(time.Minute)
+	_, requests := startBudgetTestServer(t, func(conn net.Conn) {
+		_, _ = fmt.Fprintln(conn, `{"protocol":"mihomo-budget-v1","allowed":true}`)
+	})
+	ctx, cancel := context.WithDeadline(context.Background(), parentDeadline)
+	defer cancel()
+
+	p, adapter := newBudgetTestProxy()
+	started := time.Now()
+	_, err := p.URLTest(ctx, budgetTestURL, nil)
+	if err == nil || err.Error() != "dial failed" {
+		t.Fatalf("URLTest error = %v, want underlying dial failure", err)
+	}
+	if got := adapter.dialCount.Load(); got != 1 {
+		t.Fatalf("DialContext called %d times, want 1", got)
+	}
+	if p.alive.Load() || p.AliveForTestUrl(budgetTestURL) {
+		t.Fatal("post-admission dial failure did not mark proxy dead")
+	}
+	if got := p.DelayHistory(); len(got) != 1 || got[0].Delay != 0 {
+		t.Fatalf("base history = %+v, want one dead record", got)
+	}
+	if got := p.DelayHistoryForTestUrl(budgetTestURL); len(got) != 1 || got[0].Delay != 0 {
+		t.Fatalf("URL history = %+v, want one dead record", got)
+	}
+	request := receiveBudgetTestRequest(t, requests)
+	if request.DeadlineMS < started.Add(30*time.Second).UnixMilli() || request.DeadlineMS > started.Add(31*time.Second).UnixMilli() {
+		t.Fatalf("deadline_ms = %d, want the capped 30 second deadline", request.DeadlineMS)
+	}
+}
+
+type budgetHTTPAdapter struct {
+	*budgetTestAdapter
+	dialAddr string
+}
+
+func (a *budgetHTTPAdapter) DialContext(ctx context.Context, _ *C.Metadata) (C.Conn, error) {
+	a.dialCount.Add(1)
+	conn, err := (&net.Dialer{}).DialContext(ctx, "tcp", a.dialAddr)
+	if err != nil {
+		return nil, err
+	}
+	return outbound.NewConn(conn, a), nil
+}
+
+func enableUnifiedDelayForBudgetTest(t *testing.T) {
+	t.Helper()
+	wasEnabled := UnifiedDelay.Load()
+	UnifiedDelay.Store(true)
+	t.Cleanup(func() { UnifiedDelay.Store(wasEnabled) })
+}
+
+func TestURLTestUnifiedDelayCancellationDoesNotRecordSuccess(t *testing.T) {
+	enableUnifiedDelayForBudgetTest(t)
+	for _, tt := range []struct {
+		name      string
+		timeout   time.Duration
+		cancelRun bool
+		wantErr   error
+	}{
+		{name: "deadline", timeout: 1500 * time.Millisecond, wantErr: context.DeadlineExceeded},
+		{name: "canceled", timeout: 5 * time.Second, cancelRun: true, wantErr: context.Canceled},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			var requests syncatomic.Int32
+			secondRequest := make(chan struct{})
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != http.MethodHead {
+					t.Errorf("request method = %q, want HEAD", r.Method)
+				}
+				if requests.Add(1) == 1 {
+					w.WriteHeader(http.StatusNoContent)
+					return
+				}
+				if requests.Load() == 2 {
+					close(secondRequest)
+				}
+				<-r.Context().Done()
+			}))
+			defer server.Close()
+
+			_, budgetRequests := startBudgetTestServer(t, func(conn net.Conn) {
+				_, _ = fmt.Fprintln(conn, `{"protocol":"mihomo-budget-v1","allowed":true}`)
+			})
+
+			base := &budgetTestAdapter{info: C.ProxyInfo{DialerProxy: "upstream"}}
+			adapter := &budgetHTTPAdapter{budgetTestAdapter: base, dialAddr: strings.TrimPrefix(server.URL, "http://")}
+			p := NewProxy(adapter)
+			ctx, cancel := context.WithTimeout(context.Background(), tt.timeout)
+			defer cancel()
+
+			done := make(chan error, 1)
+			go func() {
+				_, err := p.URLTest(ctx, "http://health.example/", nil)
+				done <- err
+			}()
+			_ = receiveBudgetTestRequest(t, budgetRequests)
+			select {
+			case <-secondRequest:
+			case <-time.After(time.Second):
+				t.Fatal("second HEAD request did not reach the local HTTP fixture")
+			}
+			if tt.cancelRun {
+				cancel()
+			}
+
+			var err error
+			select {
+			case err = <-done:
+			case <-time.After(2 * time.Second):
+				t.Fatal("URLTest did not return after cancellation or deadline")
+			}
+			if got := requests.Load(); got != 2 {
+				t.Fatalf("HTTP requests = %d, want two HEAD requests", got)
+			}
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("URLTest error = %v, want %v", err, tt.wantErr)
+			}
+			if p.AliveForTestUrl("http://health.example/") {
+				t.Fatal("canceled or expired unified delay check marked the proxy alive")
+			}
+			if got := p.DelayHistory(); len(got) != 1 || got[0].Delay != 0 {
+				t.Fatalf("base history = %+v, want one failed check", got)
+			}
+			if got := p.DelayHistoryForTestUrl("http://health.example/"); len(got) != 1 || got[0].Delay != 0 {
+				t.Fatalf("URL history = %+v, want one failed check", got)
+			}
+		})
+	}
+}
+
+func TestURLTestUnifiedDelayKeepsFirstResponseOnSecondRequestFailure(t *testing.T) {
+	enableUnifiedDelayForBudgetTest(t)
+	var requests syncatomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if requests.Add(1) == 1 {
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+		time.Sleep(25 * time.Millisecond)
+		conn, _, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			t.Errorf("hijack second request: %v", err)
+			return
+		}
+		_ = conn.Close()
+	}))
+	defer server.Close()
+
+	_, budgetRequests := startBudgetTestServer(t, func(conn net.Conn) {
+		_, _ = fmt.Fprintln(conn, `{"protocol":"mihomo-budget-v1","allowed":true}`)
+	})
+
+	base := &budgetTestAdapter{info: C.ProxyInfo{DialerProxy: "upstream"}}
+	adapter := &budgetHTTPAdapter{budgetTestAdapter: base, dialAddr: strings.TrimPrefix(server.URL, "http://")}
+	p := NewProxy(adapter)
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+
+	_, err := p.URLTest(ctx, "http://health.example/", nil)
+	_ = receiveBudgetTestRequest(t, budgetRequests)
+	if err != nil {
+		t.Fatalf("URLTest error = %v, want first response success", err)
+	}
+	if !p.AliveForTestUrl("http://health.example/") {
+		t.Fatal("ordinary second request failure did not preserve first response success")
+	}
+	if got := p.DelayHistoryForTestUrl("http://health.example/"); len(got) != 1 || got[0].Delay == 0 {
+		t.Fatalf("URL history = %+v, want successful delay from first response", got)
+	}
+}
