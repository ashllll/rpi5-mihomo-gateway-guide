+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+// Only the transport endpoint is substituted; health checks and group selection are real.
+type localStatusAdapter struct {
+	*outbound.Base
+	endpoint string
+}
+
+func (a *localStatusAdapter) DialContext(ctx context.Context, _ *C.Metadata) (C.Conn, error) {
+	c, err := (&net.Dialer{}).DialContext(ctx, "tcp", a.endpoint)
+	if err != nil {
+		return nil, err
+	}
+	return outbound.NewConn(c, a), nil
+}
+
+func statusProxy(t *testing.T, name string, status int) C.Proxy {
+	t.Helper()
+	s := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodHead {
+			t.Errorf("method = %s, want HEAD", r.Method)
+		}
+		time.Sleep(3 * time.Millisecond)
+		w.WriteHeader(status)
+	}))
+	t.Cleanup(s.Close)
+	return adapter.NewProxy(&localStatusAdapter{
+		Base:     outbound.NewBase(outbound.BaseOption{Name: name, Addr: "fixture.invalid:443", Type: C.Direct}),
+		endpoint: strings.TrimPrefix(s.URL, "http://"),
+	})
+}
+
+func statusRanges(t *testing.T, expected string) utils.IntRanges[uint16] {
+	t.Helper()
+	r, err := utils.NewUnsignedRanges[uint16](expected)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return r
+}
+
+func statusProvider(t *testing.T, proxies []C.Proxy, url, expected string) *provider.CompatibleProvider {
+	t.Helper()
+	hc := provider.NewHealthCheck(proxies, url, 1000, 0, false, statusRanges(t, expected))
+	p, err := provider.NewCompatibleProvider("owned", proxies, hc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = p.Close() })
+	return p
+}
+
+func statusAdmission(t *testing.T) *atomic.Int32 {
+	t.Helper()
+	dir, err := os.MkdirTemp("/tmp", "mihomo-status-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	socket := filepath.Join(dir, "budget.sock")
+	l, err := net.Listen("unix", socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan struct{})
+	t.Cleanup(func() { _ = l.Close(); <-done })
+	t.Setenv(measurementbudget.SocketEnv, socket)
+	count := new(atomic.Int32)
+	go func() {
+		defer close(done)
+		for {
+			c, err := l.Accept()
+			if err != nil {
+				return
+			}
+			_ = c.SetDeadline(time.Now().Add(time.Second))
+			var request struct {
+				Protocol   string `json:"protocol"`
+				DeadlineMS int64  `json:"deadline_ms"`
+			}
+			if err := json.NewDecoder(c).Decode(&request); err != nil || request.Protocol != measurementbudget.Protocol || request.DeadlineMS <= time.Now().UnixMilli() {
+				t.Errorf("invalid admission request: %+v, %v", request, err)
+			} else {
+				count.Add(1)
+				_, _ = fmt.Fprintln(c, `{"protocol":"mihomo-budget-v1","allowed":true}`)
+			}
+			_ = c.Close()
+		}
+	}()
+	return count
+}
+
+func TestConfiguredStatusCannotBeRelaxedByRetest(t *testing.T) {
+	admissions := statusAdmission(t)
+	const url = "http://health.invalid/owned"
+	a, b := statusProxy(t, "A", 503), statusProxy(t, "B", 204)
+	p := statusProvider(t, []C.Proxy{a, b}, url, "204")
+	p.HealthCheck()
+	f, err := outboundgroup.NewFallback(outboundgroup.GroupCommonOption{Name: "Download", URL: url, ExpectedStatus: "204"}, outboundgroup.FallbackOption{}, b, []P.ProxyProvider{p})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, expected := range []string{"", "*", "200-599", "503"} {
+		t.Run("group/"+expected, func(t *testing.T) {
+			delays, err := f.URLTest(context.Background(), url, statusRanges(t, expected))
+			if _, ok := delays["A"]; ok {
+				t.Fatalf("503 node returned as a successful group delay: %v (error %v)", delays, err)
+			}
+			if a.AliveForTestUrl(url) || (expected != "503" && f.Now() != "B") {
+				t.Fatalf("503 node revived by retest; alive=%t selected=%s", a.AliveForTestUrl(url), f.Now())
+			}
+		})
+		t.Run("leaf/"+expected, func(t *testing.T) {
+			_, err := a.URLTest(context.Background(), url, statusRanges(t, expected))
+			if err == nil || a.AliveForTestUrl(url) {
+				t.Fatalf("503 leaf retest succeeded: error=%v alive=%t", err, a.AliveForTestUrl(url))
+			}
+			history := a.DelayHistory()
+			if history[len(history)-1].Delay != 0 {
+				t.Fatalf("503 leaf stored successful base history: %v", history)
+			}
+		})
+	}
+	if _, err := a.URLTest(context.Background(), "http://health.invalid/ad-hoc", nil); err != nil {
+		t.Fatalf("distinct ad-hoc URL lost native wildcard semantics: %v", err)
+	}
+	if a.AliveForTestUrl(url) {
+		t.Fatal("ad-hoc test overwrote the owned URL health")
+	}
+	if got := admissions.Load(); got != 15 {
+		t.Fatalf("admissions = %d, want all 15 real leaf attempts charged", got)
+	}
+}
+
+func TestConfiguredStatusPaddedURLCannotBeRelaxed(t *testing.T) {
+	statusAdmission(t)
+	const url = "http://health.invalid/owned"
+	for _, padding := range []string{"  ", "\t", "\u00a0"} {
+		t.Run(fmt.Sprintf("%q", padding), func(t *testing.T) {
+			a := statusProxy(t, "A", 503)
+			p := statusProvider(t, []C.Proxy{a}, padding+url+padding, "204")
+			p.RegisterHealthCheckTask(url, statusRanges(t, "*"), "", 0)
+			if _, err := a.URLTest(context.Background(), url, nil); err == nil || a.AliveForTestUrl(url) {
+				t.Fatalf("padded provider URL lost its status contract: err=%v alive=%t", err, a.AliveForTestUrl(url))
+			}
+			if p.HealthCheckURL() != url {
+				t.Fatalf("provider URL = %q, want %q", p.HealthCheckURL(), url)
+			}
+		})
+	}
+}
+
+func TestConfiguredStatusFollowsOwnerLifecycle(t *testing.T) {
+	statusAdmission(t)
+	const url = "http://health.invalid/owned"
+	a := statusProxy(t, "A", 503)
+	old := statusProvider(t, []C.Proxy{a}, url, "204")
+	if _, err := a.URLTest(context.Background(), url, nil); err == nil {
+		t.Fatal("configured contract was absent before the first provider check")
+	}
+	current := statusProvider(t, []C.Proxy{a}, url, "503")
+	if _, err := a.URLTest(context.Background(), url, nil); err == nil {
+		t.Fatal("second owner relaxed a still-active owner contract")
+	}
+	_ = old.Close()
+	if _, err := a.URLTest(context.Background(), url, nil); err != nil {
+		t.Fatalf("closed owner's 204 contract remained active: %v", err)
+	}
+	_ = old.Close()
+	if _, err := a.URLTest(context.Background(), url, statusRanges(t, "204")); err == nil {
+		t.Fatal("old provider close removed the current owner's contract")
+	}
+	_ = current.Close()
+	if _, err := a.URLTest(context.Background(), url, nil); err != nil {
+		t.Fatalf("contract survived all owners closing: %v", err)
+	}
+}
+
+func TestConfiguredStatusFollowsProviderRefresh(t *testing.T) {
+	statusAdmission(t)
+	const url = "http://health.invalid/owned"
+	a, b := statusProxy(t, "old", 503), statusProxy(t, "new", 503)
+	path := filepath.Join(t.TempDir(), "provider.yaml")
+	write := func(value string) {
+		t.Helper()
+		if err := os.WriteFile(path, []byte(value), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	parser := func(buf []byte) ([]C.Proxy, error) {
+		if string(buf) == "old" {
+			return []C.Proxy{a}, nil
+		}
+		return []C.Proxy{b}, nil
+	}
+	hc := provider.NewHealthCheck(nil, url, 1000, 0, false, statusRanges(t, "204"))
+	p, err := provider.NewProxySetProvider("refresh", 0, nil, parser, resource.NewFileVehicle(path), hc)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = p.Close() })
+	write("old")
+	if err := p.Update(); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := a.URLTest(context.Background(), url, nil); err == nil {
+		t.Fatal("provider update did not install the configured contract")
+	}
+	write("new")
+	if err := p.Update(); err != nil {
+		t.Fatal(err)
+	}
+	if got := p.Proxies(); len(got) != 1 || got[0] != b {
+		t.Fatalf("refreshed proxies = %v, want new proxy", got)
+	}
+	if _, err := b.URLTest(context.Background(), url, nil); err == nil {
+		t.Fatal("refreshed proxy escaped the configured status contract")
+	}
+	if _, err := a.URLTest(context.Background(), url, nil); err != nil {
+		t.Fatalf("detached proxy retained its old provider's contract: %v", err)
+	}
+	_ = p.Close()
+	if _, err := b.URLTest(context.Background(), url, nil); err != nil {
+		t.Fatalf("refreshed proxy retained a closed owner's contract: %v", err)
+	}
+}
+
+func TestConfiguredExtraStatusRetainsFiltersAndPriority(t *testing.T) {
+	statusAdmission(t)
+	const mainURL, extraURL = "http://health.invalid/main", "http://health.invalid/extra"
+	a, b := statusProxy(t, "A", 503), statusProxy(t, "B", 503)
+	p := statusProvider(t, []C.Proxy{a, b}, mainURL, "*")
+	p.RegisterHealthCheckTask(extraURL, statusRanges(t, "204"), "^A$", 0)
+	if _, err := a.URLTest(context.Background(), extraURL, nil); err == nil {
+		t.Fatal("filtered extra check contract was absent before execution")
+	}
+	if _, err := b.URLTest(context.Background(), extraURL, nil); err != nil {
+		t.Fatalf("extra check contract leaked to a non-matching proxy: %v", err)
+	}
+	p.RegisterHealthCheckTask(extraURL, statusRanges(t, "503"), "^B$", 0)
+	if _, err := b.URLTest(context.Background(), extraURL, nil); err == nil {
+		t.Fatal("later registration weakened the first extra check's status contract")
+	}
+	p.HealthCheck()
+	if !a.AliveForTestUrl(mainURL) || !b.AliveForTestUrl(mainURL) || a.AliveForTestUrl(extraURL) || b.AliveForTestUrl(extraURL) {
+		t.Fatal("provider main/extra checks did not retain independent URL status contracts")
+	}
+}
+
+func TestConfiguredStatusConcurrentRetestsAndRegistration(t *testing.T) {
+	statusAdmission(t)
+	const url = "http://health.invalid/owned"
+	a := statusProxy(t, "A", 503)
+	p := statusProvider(t, []C.Proxy{a}, url, "204")
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 20; i++ {
+			if _, err := a.URLTest(context.Background(), url, nil); err == nil {
+				t.Error("concurrent retest relaxed the configured contract")
+			}
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 20; i++ {
+			p.RegisterHealthCheckTask("http://health.invalid/extra", statusRanges(t, "204"), "^A$", 0)
+			p.HealthCheck()
+		}
+	}()
+	wg.Wait()
+}
+
+func TestConfiguredStatusBudgetDenialPreservesHealth(t *testing.T) {
+	statusAdmission(t)
+	const url = "http://health.invalid/owned"
+	a := statusProxy(t, "A", 204)
+	statusProvider(t, []C.Proxy{a}, url, "204")
+	if _, err := a.URLTest(context.Background(), url, nil); err != nil {
+		t.Fatal(err)
+	}
+	before, extraBefore := a.DelayHistory(), a.ExtraDelayHistories()
+	t.Setenv(measurementbudget.SocketEnv, filepath.Join(t.TempDir(), "absent.sock"))
+	if _, err := a.URLTest(context.Background(), url, statusRanges(t, "503")); !errors.Is(err, measurementbudget.ErrDenied) {
+		t.Fatalf("budget denial = %v", err)
+	}
+	if !a.AliveForTestUrl(url) || !reflect.DeepEqual(a.DelayHistory(), before) || !reflect.DeepEqual(a.ExtraDelayHistories(), extraBefore) {
+		t.Fatal("denied retest modified configured URL health/history")
+	}
+}
+
+func TestConfiguredStatusFallbackSetRetest(t *testing.T) {
+	admissions := statusAdmission(t)
+	const url = "http://health.invalid/owned"
+	a, b := statusProxy(t, "A", 503), statusProxy(t, "B", 204)
+	p := statusProvider(t, []C.Proxy{a, b}, url, "204")
+	p.HealthCheck()
+	f, err := outboundgroup.NewFallback(outboundgroup.GroupCommonOption{Name: "Download", URL: url, ExpectedStatus: "*"}, outboundgroup.FallbackOption{}, b, []P.ProxyProvider{p})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Set("A"); err != nil {
+		t.Fatal(err)
+	}
+	if a.AliveForTestUrl(url) || f.Now() != "B" || admissions.Load() != 3 {
+		t.Fatalf("fallback Set relaxed owner status or skipped admission: alive=%t selected=%s admissions=%d", a.AliveForTestUrl(url), f.Now(), admissions.Load())
+	}
+}
