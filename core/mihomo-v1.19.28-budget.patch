+
+// SetHealthCheckContracts replaces only this health-check owner's current URL contracts.
+func (p *Proxy) SetHealthCheckContracts(owner context.Context, contracts map[string]utils.IntRanges[uint16]) {
+	p.contractMu.Lock()
+	defer p.contractMu.Unlock()
+	if len(contracts) == 0 || owner.Err() != nil {
+		delete(p.contracts, owner)
+		return
+	}
+	if p.contracts == nil {
+		p.contracts = make(map[context.Context]map[string]utils.IntRanges[uint16])
+	}
+	copy := make(map[string]utils.IntRanges[uint16], len(contracts))
+	for url, expected := range contracts {
+		copy[url] = append(utils.IntRanges[uint16](nil), expected...)
+	}
+	p.contracts[owner] = copy
+}
+
+// HealthCheckStatus checks only contracts directly registered on this proxy.
+func (p *Proxy) HealthCheckStatus(url string, status uint16) (owned, accepted bool) {
+	p.contractMu.Lock()
+	defer p.contractMu.Unlock()
+	accepted = true
+	for owner, contracts := range p.contracts {
+		if owner.Err() != nil {
+			delete(p.contracts, owner)
+			continue
+		}
+		if expected, ok := contracts[url]; ok {
+			owned = true
+			accepted = accepted && expected.Check(status)
+		}
+	}
+	return
+}
+
+func (p *Proxy) healthCheckStatus(url string, status uint16) (owned, accepted bool) {
+	owned, accepted = p.HealthCheckStatus(url, status)
+	if p.providers != nil {
+		// Parsed global and provider copies can represent the same native leaf.
+		for _, provider := range p.providers.Providers() {
+			if checker, ok := provider.(interface {
+				HealthCheckStatus(C.Proxy, string, uint16) (bool, bool)
+			}); ok {
+				aliasOwned, aliasAccepted := checker.HealthCheckStatus(p, url, status)
+				owned = owned || aliasOwned
+				accepted = accepted && aliasAccepted
+			}
+		}
+	}
+	return
 }
 
