# Least-privilege site file for mihomo-alert (installed as /etc/mihomo-alert.env,
# mode 0600). Fill only the paths you use.
#
# ServerChan: sending key from https://sct.ftqq.com (SendKey, never the account key).
# If ServerChan's own "default channel" is Bark, leave BARK_URL empty below -
# otherwise every alert arrives twice.
SERVERCHAN_SENDKEY=
# Optional: force the delivery channel instead of the site default. Bark iOS = 8.
# Use SERVERCHAN_CHANNEL=8 and no BARK_URL when Bark is configured inside ServerChan.
SERVERCHAN_CHANNEL=
# Bark, pushed directly and independently of ServerChan. Set BARK_URL only when
# ServerChan does NOT already deliver to Bark.
BARK_URL=
# Optional: title prefix, and an alternative ServerChan-compatible base URL.
ALERT_TITLE=
SERVERCHAN_BASE=
# Identical messages are sent at most once per cooldown.
ALERT_COOLDOWN=600
# Health transitions oscillate on flaky upstreams; this key gets a longer one so
# a flapping gate cannot burn the ServerChan daily quota.
ALERT_COOLDOWN_HEALTH=1800
# Thresholds for mihomo-watch (gateway-wide anomaly checks, edge-triggered).
WATCH_TEMP_C=80
WATCH_DISK_PCT=90
WATCH_MEM_MB=512
WATCH_WAN_IF=wan0
