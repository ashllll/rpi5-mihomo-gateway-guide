# Deployment parameters for the gateway automation layer.
#
# Install as /etc/mihomo-automation.env (mode 0600) and keep it out of version
# control: it is the only place where this deployment's addresses live.  It
# carries the shared address, ports and WAN interface for this site; the values
# below are example defaults, review them before deployment. Scripts keep
# working without editing their source.
#
# Every variable below is read by a script in automation/sbin (or by the
# NetworkManager dispatcher in automation/etc/NetworkManager) and nothing here is
# decorative: the variable set is checked against the scripts. The addresses are
# RFC 5737 placeholders, not a real site.

# Mihomo mixed (HTTP/SOCKS) port and external controller port.
MIHOMO_MIXED_PORT=7890
MIHOMO_CONTROLLER_PORT=9090

# Optional provider-documented mirror of the same subscription link.  Leave
# empty unless your provider publishes one; the updater then uses the single
# link stored in /etc/mihomo/secrets/subscription.url.
SUBSCRIPTION_BACKUP_URL=

# Bound the update attempt; rollback uses a separate recovery allowance.
MIHOMO_SUBSCRIPTION_TIMEOUT_SECONDS=1800
MIHOMO_SUBSCRIPTION_CLEANUP_TIMEOUT_SECONDS=240
MIHOMO_SUBSCRIPTION_FAILURE_COOLDOWN_SECONDS=21600

# The resolver actually advertised to clients and the service that owns it.
# Defaults retain host-only installations; VLAN sites must set their real target
# and its actual upstream (for example the Mihomo DNS listener on port 1053).
DNS_CLIENT_SERVER=127.0.0.1
DNS_CLIENT_PORT=53
DNS_CLIENT_UNIT=dnsmasq
DNS_UPSTREAM_SERVER=127.0.0.1
DNS_UPSTREAM_PORT=5335
DNS_PROBE_DOMAINS='www.baidu.com www.qq.com'

# Interfaces watched by the Home Assistant access guard
# (homeassistant-access-guard.service): traffic to tcp/8123 arriving on either
# one is rejected.
WAN_INTERFACE=wan0
WLAN_INTERFACE=wlan0

# Optional management radio used by the NetworkManager dispatcher in
# automation/etc/NetworkManager/dispatcher.d/.  The UUID guard is empty by
# default, which accepts every connection on that interface.
MANAGEMENT_INTERFACE=wlan0
MIHOMO_MANAGEMENT_CONNECTION_UUID=

# Group -> target mapping consumed by mihomo-reconcile-policy.
MIHOMO_RECONCILE_TARGETS=/etc/mihomo/reconcile-targets.conf
# Stale fallback selection repair; the timer never applies Selector targets.
MIHOMO_AUTOMATION_ENV_FILE=/etc/mihomo-automation.env
MIHOMO_RECONCILE_SECRET_FILE=/etc/mihomo/secrets/dashboard.secret
MIHOMO_RECONCILE_LOCK_FILE=/run/lock/mihomo-reconcile-policy.lock
MIHOMO_RECONCILE_TIMEOUT_SECONDS=15

# Capability manifest read by mihomo-policy-overlay and native measurement policy.
# It holds the service definitions and the curated-pool node labels.
MIHOMO_CAPABILITIES=/etc/mihomo/adaptive/capabilities.yaml

# Public route defaults installed independently so upgrades preserve the
# operator's private capabilities manifest.
MIHOMO_ROUTE_DEFAULTS=/etc/mihomo/adaptive/route-defaults.yaml

# Shared Unix socket for the pinned core and measurement admission service.
MIHOMO_MEASUREMENT_SOCKET=/run/mihomo-measurements/budget.sock

# Egress sample of mihomo-healthcheck: ordinary proxied traffic, never budgeted.
EGRESS_EVERY=300
EGRESS_URL=https://www.gstatic.com/generate_204
# Optional bounded, labelled path samples. If absent, EGRESS_URL remains the
# single compatibility probe. Confirmation counts advance only on fresh samples.
EGRESS_PROBES_FILE=/etc/mihomo/health-probes.conf
EGRESS_ALERT_FAILURES=1
EGRESS_RECOVERY_SUCCESSES=1

# Not published, because nothing reads it: the live site file also carried an
# X_VIDEO_PROBE_URL. It is left out on purpose - a variable no script consumes
# is dead weight in the one file the operator is told to edit.
