#!/bin/sh

set -eu

backup=${1:-}
case "$backup" in
  /var/backups/mosdns-rollout-*.tar.gz) ;;
  *)
    echo "usage: mosdns-rollout-rollback /var/backups/mosdns-rollout-*.tar.gz" >&2
    exit 2
    ;;
esac

# GATEWAY_ROOT is the same staging knob install.sh uses: on the gateway it is
# unset, and a sandboxed run keeps the lock, the pending checks and every
# deletion inside its own tree.  The current directory is the tree root, so
# the destructive paths below stay relative.
root=${GATEWAY_ROOT:-}
root=${root%/}
case "$root" in
  ''|/*) ;;
  *) echo "mosdns-rollout-rollback: invalid GATEWAY_ROOT" >&2; exit 2 ;;
esac
if [ "$root" = "/" ]; then
  root=
fi
cd "${root:-/}"
lock_file=$root/run/lock/mihomo-maintenance.lock
install_pending=var/lib/mihomo-automation/.install-pending
binary_pending=etc/mosdns/backups/transaction.pending
rules_pending=etc/mosdns/rules/pending
subscription_pending=var/lib/mihomo-subscription-backups/transaction.pending

mkdir -p -- "$(dirname "$lock_file")"
exec 8>"$lock_file"
if ! flock -n 8; then
  echo "mosdns-rollout-rollback: maintenance is busy; refusing to stop mosdns" >&2
  exit 1
fi

# Another tool's transaction may be mid-write (or crashed mid-write).  Its
# recovery owns these files; deleting them here would strand the DNS service
# between two half-applied states.
for pending in "$install_pending" "$binary_pending" "$rules_pending" "$subscription_pending"; do
  if [ -e "$pending" ]; then
    echo "mosdns-rollout-rollback: pending transaction ($pending); refusing to continue" >&2
    exit 1
  fi
done

[ -f "$backup" ]
gzip -t "$backup"

# The direct switch is the safety line: until it succeeds, mosdns must keep
# running.  A failure here leaves DNS pointed at a live mosdns.
if ! /usr/local/sbin/mihomo-dns-mode direct; then
  echo "mosdns-rollout-rollback: could not switch DNS to direct; mosdns left running" >&2
  exit 1
fi

direct_active=true
rollback_complete=false
listing_dir=${root}/var/tmp
mkdir -p -- "$listing_dir"
listing=$listing_dir/mosdns-rollback.$$.list
archived_config=$listing_dir/mosdns-rollback.$$.config
restore_dns_on_exit() {
  status=$?
  trap - EXIT HUP INT TERM
  rm -f -- "$listing" "$archived_config"
  if [ "$direct_active" = true ] && [ "$rollback_complete" != true ]; then
    /usr/local/sbin/mihomo-dns-mode auto ||
      echo "mosdns-rollout-rollback: DNS may stay in direct mode" >&2
  fi
  exit "$status"
}
trap restore_dns_on_exit EXIT HUP INT TERM

# Validate the point before any file is overwritten.  A truncated or empty
# archive must fail here, not half-way through the unit removals below.
if ! tar -tzf "$backup" >"$listing"; then
  echo "mosdns-rollout-rollback: cannot list the rollback point; nothing changed" >&2
  exit 1
fi
if ! grep -qx 'etc/mosdns/config.yaml' "$listing"; then
  echo "mosdns-rollout-rollback: rollback point has no MosDNS config; nothing changed" >&2
  exit 1
fi
if grep -Eq '(^/|(^|/)\.\.(/|$))' "$listing"; then
  echo "mosdns-rollout-rollback: rollback point contains unsafe paths; nothing changed" >&2
  exit 1
fi
# The restored config decides whether the rules tree may be removed.  Read it
# from the archive now: a config that references rules with no rules in the
# point is refused before the destructive phase.
if tar -xOf "$backup" etc/mosdns/config.yaml >"$archived_config" 2>/dev/null; then
  if grep -q 'etc/mosdns/rules' "$archived_config" &&
     ! grep -q '^etc/mosdns/rules/' "$listing"; then
    echo "mosdns-rollout-rollback: restored config references rules but the point has none; refusing" >&2
    exit 1
  fi
fi

systemctl disable --now \
  mosdns-healthcheck.timer \
  mosdns-rules-update.timer \
  mosdns-binary-update.timer \
  mosdns.service || true

tar -xzf "$backup" -C .

# Retire only what the point does not carry.  The extraction above already
# restored every member it holds, so an unconditional removal here would delete
# the very files the rollback just brought back.
for artifact in \
  "etc/systemd/system/mosdns-healthcheck.service" \
  "etc/systemd/system/mosdns-healthcheck.timer" \
  "etc/systemd/system/mosdns-rules-update.service" \
  "etc/systemd/system/mosdns-rules-update.timer" \
  "etc/systemd/system/mosdns-binary-update.service" \
  "etc/systemd/system/mosdns-binary-update.timer" \
  "etc/systemd/system/dnsmasq.service.d/boot-safe.conf" \
  "etc/mihomo/dnsmasq-upstreams.mosdns" \
  "usr/local/sbin/mosdns-healthcheck" \
  "usr/local/sbin/mosdns-update-rules" \
  "usr/local/sbin/mosdns-update-binary" \
  "usr/local/sbin/dnsmasq-safe-start" \
  "usr/local/sbin/mosdns-emergency-direct" \
  "usr/local/sbin/mosdns-resume-auto"
do
  grep -Fqx -- "$artifact" "$listing" || rm -f -- "$artifact"
done

# The rules tree belongs to the point.  When the point carries rules, keep the
# ones it just extracted; only remove a tree the restored config cannot use.
if ! grep -q '^etc/mosdns/rules/' "$listing"; then
  rm -rf -- etc/mosdns/rules
fi

systemctl daemon-reload
systemctl enable --now mosdns.service
/usr/local/sbin/mihomo-dns-mode mihomo
rollback_complete=true

echo "Original mosdns and Mihomo DNS configuration restored from $backup"
