#!/bin/sh

set -eu

exec 8>/run/lock/mihomo-maintenance.lock
if ! flock -n 8; then
  echo "mosdns-resume-auto: maintenance is busy; retry after the current change" >&2
  exit 1
fi

systemctl enable --now mosdns.service
systemctl enable --now \
  mosdns-healthcheck.timer \
  mosdns-rules-update.timer \
  mosdns-binary-update.timer
/usr/local/sbin/mihomo-dns-mode auto

echo "Automatic mosdns mode and maintenance are active."
