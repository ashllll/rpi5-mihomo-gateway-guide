#!/usr/bin/python3

"""Apply the local, service-specific policy overlay to a multi-source config."""

from __future__ import annotations

import copy
import hashlib
import json
import os
import re
import runpy
import sys
from pathlib import Path

import yaml

# Local capability manifest: service definitions plus the curated-pool node
# labels.  It is deployment data and never part of this repository.
CAPABILITIES_PATH = os.environ.get(
    "MIHOMO_CAPABILITIES", "/etc/mihomo/adaptive/capabilities.yaml"
)
ROUTE_DEFAULTS_PATH = os.environ.get(
    "MIHOMO_ROUTE_DEFAULTS", "/etc/mihomo/adaptive/route-defaults.yaml"
)

DOWNLOAD_ROUTE_GROUPS = {"Download", "GitHub Download", "GitHub Control", "Model Download", "Package Download"}
VIDEO_ROUTE_GROUPS = {"Streaming", "Social"}


def ordered_existing(candidates: list[str], existing: set[str]) -> list[str]:
    return [name for name in candidates if name in existing]


def replace_group(groups: list[dict], name: str, spec: dict) -> None:
    for index, group in enumerate(groups):
        if group.get("name") == name:
            groups[index] = {"name": name, **spec}
            return
    raise SystemExit(f"required proxy group is missing: {name}")


def upsert_group(groups: list[dict], name: str, spec: dict) -> None:
    for index, group in enumerate(groups):
        if group.get("name") == name:
            groups[index] = {"name": name, **spec}
            return
    groups.append({"name": name, **spec})


def unique(items: list[str]) -> list[str]:
    seen: set[str] = set()
    result: list[str] = []
    for item in items:
        if item not in seen:
            seen.add(item)
            result.append(item)
    return result


def load_capabilities() -> dict:
    path = Path(CAPABILITIES_PATH)
    if not path.is_file():
        return {}
    with path.open(encoding="utf-8") as stream:
        value = yaml.safe_load(stream)
    return value if isinstance(value, dict) else {}


def load_route_defaults() -> dict:
    path = Path(ROUTE_DEFAULTS_PATH)
    with path.open(encoding="utf-8") as stream:
        value = yaml.safe_load(stream)
    if not isinstance(value, dict):
        raise ValueError("invalid route defaults mapping")
    return value


def validated_routes(routes: object, key: str, allowed_groups: set[str]) -> dict:
    if not isinstance(routes, dict):
        raise ValueError(f"invalid {key} route table")
    result = {}
    for route_id, spec in routes.items():
        if (not isinstance(route_id, str)
                or not re.fullmatch(r"[A-Za-z0-9_-]+", route_id)
                or not isinstance(spec, dict)
                or spec.get("group") not in allowed_groups):
            raise ValueError(f"invalid {key} route entry")
        domains = spec.get("domains")
        if not isinstance(domains, list) or not domains:
            raise ValueError(f"invalid {key} domains: route entries require at least one domain")
        for domain in domains:
            if (not isinstance(domain, str) or not domain
                    or any(character.isspace() or character in ",*" for character in domain)):
                raise ValueError(f"invalid {key} domain")
        result[route_id] = {"group": spec["group"], "domains": unique(domains)}
    return result


def _legacy_download_routes(capabilities: dict, defaults: dict) -> dict:
    policy = capabilities.get("download_quality", {})
    if policy is None:
        return {}
    if not isinstance(policy, dict):
        raise ValueError("invalid legacy download_quality policy")
    profiles = policy.get("profiles", {})
    if not isinstance(profiles, dict):
        raise ValueError("invalid legacy download_quality profiles")
    migrated = copy.deepcopy(defaults)
    for route_id, profile in profiles.items():
        if (not isinstance(route_id, str)
                or not re.fullmatch(r"[A-Za-z0-9_-]+", route_id)
                or not isinstance(profile, dict)):
            raise ValueError("invalid legacy download_quality profile")
        domains = profile.get("domains", [])
        if not isinstance(domains, list):
            raise ValueError("invalid legacy download_quality domains")
        if not domains:
            # Old profiles with no domain rules (for example a Social helper)
            # do not override or remove the packaged business routes.
            continue
        group = profile.get("group")
        if group not in DOWNLOAD_ROUTE_GROUPS:
            raise ValueError("legacy download_quality profile uses an unsupported route group")
        for domain in domains:
            if (not isinstance(domain, str) or not domain
                    or any(character.isspace() or character in ",*" for character in domain)):
                raise ValueError("invalid legacy download_quality domain")
        previous = migrated.get(route_id)
        inherited_domains = previous.get("domains", []) if isinstance(previous, dict) else []
        migrated[route_id] = {
            "group": group,
            "domains": unique([*inherited_domains, *domains]),
        }
    return migrated


def resolve_route_tables(capabilities: dict, route_defaults: dict) -> dict:
    """Merge private overrides, old profile routes, and packaged route data."""
    allowed = {
        "download_routes": DOWNLOAD_ROUTE_GROUPS,
        "video_routes": VIDEO_ROUTE_GROUPS,
    }
    result = copy.deepcopy(capabilities)
    for key, groups in allowed.items():
        packaged = validated_routes(route_defaults.get(key), key, groups)
        if not packaged:
            raise ValueError(f"route defaults must define {key}")
        if key == "download_routes":
            effective = _legacy_download_routes(capabilities, packaged)
        else:
            effective = copy.deepcopy(packaged)

        explicit = capabilities.get(key, {})
        if explicit is None:
            # A YAML key left blank is null; treat it as an empty table, not
            # as an invalid override that drops the public defaults.
            explicit = {}
        if not isinstance(explicit, dict):
            raise ValueError(f"invalid {key} route table")
        overrides = validated_routes(explicit, key, groups)
        effective.update(overrides)
        if set(packaged) - set(effective):
            raise ValueError(f"required {key} routes are missing")
        result[key] = effective
    return result


def retire_legacy_quality_providers(config: dict, capabilities: dict, route_defaults: dict) -> None:
    """Drop only file providers matching the retired generator's identity contract."""
    providers = config.get("proxy-providers")
    if providers is None:
        return
    if not isinstance(providers, dict):
        raise ValueError("invalid proxy-provider mapping")
    retired_ids = route_defaults.get("retired_quality_profile_ids", [])
    if (not isinstance(retired_ids, list)
            or any(not isinstance(item, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", item)
                   for item in retired_ids)):
        raise ValueError("invalid retired quality profile IDs")
    owned_ids = set(retired_ids)
    download = capabilities.get("download_quality", {})
    if isinstance(download, dict) and isinstance(download.get("profiles", {}), dict):
        owned_ids.update(
            item for item in download.get("profiles", {})
            if isinstance(item, str) and re.fullmatch(r"[A-Za-z0-9_-]+", item)
        )
    social = capabilities.get("social_quality", {})
    if isinstance(social, dict):
        profiles = social.get("profiles", {})
        if isinstance(profiles, dict):
            profile = profiles.get("x-video")
            if isinstance(profile, dict) and profile.get("group") == "Social":
                owned_ids.add("x-video")

    groups = config.get("proxy-groups", [])
    if not isinstance(groups, list):
        raise ValueError("invalid proxy-group list")
    for provider_name, spec in list(providers.items()):
        if not isinstance(provider_name, str):
            continue
        match = re.fullmatch(r"quality-([A-Za-z0-9_-]+)", provider_name)
        if not match or match.group(1) not in owned_ids or not isinstance(spec, dict):
            continue
        profile_id = match.group(1)
        if spec.get("type") != "file":
            continue
        payload = spec.get("payload")
        if (not isinstance(payload, list) or not payload
                or any(not isinstance(node, dict) or not isinstance(node.get("name"), str)
                       for node in payload)):
            continue
        canonical = sorted(
            (copy.deepcopy(node) for node in payload),
            key=lambda node: str(node.get("name", "")),
        )
        try:
            encoded = json.dumps(
                canonical, sort_keys=True, ensure_ascii=True, separators=(",", ":")
            ).encode("ascii")
        except (TypeError, ValueError):
            continue
        digest = hashlib.sha256(encoded).hexdigest()[:16]
        expected_path = f"./providers/quality-{profile_id}-{digest}.yaml"
        if spec.get("path") != expected_path:
            continue
        referenced = any(
            provider_name in use
            for group in groups if isinstance(group, dict)
            for use in [group.get("use", [])]
            if isinstance(use, list)
        )
        if not referenced:
            providers.pop(provider_name)


def matches_any(name: str, patterns: list[str]) -> bool:
    return any(re.search(pattern, name) for pattern in patterns)


def apply_stability(config: dict, capabilities: dict) -> None:
    """Apply deployment health settings without rebuilding pools or rules."""
    policy = capabilities.get("stability", {})
    overrides = policy.get("groups", {})
    allowed = {"type", "url", "interval", "timeout", "lazy", "tolerance",
               "max-failed-times", "expected-status"}
    # Interval is the detection latency: a group pinned to a dead node keeps
    # failing for at least that long.  The ceiling makes every generated group
    # recoverable within minutes even when the built-in default is stale.
    ceiling = policy.get("max_interval", 180)
    if not isinstance(ceiling, int) or isinstance(ceiling, bool) or ceiling <= 0:
        raise ValueError("stability.max_interval must be a positive integer")
    # A group without an explicit interval falls back to the meter's own probe
    # cadence, so every automatic group is scheduled instead of inheriting a
    # stale value from the previous generation of the file.
    native = capabilities.get("measurement", {}).get("native_interval_seconds", ceiling)
    if not isinstance(native, int) or isinstance(native, bool) or native <= 0:
        native = ceiling
    default_interval = min(native, ceiling)
    for group in config.get("proxy-groups", []):
        options = overrides.get(group.get("name"), {})
        if set(options) - allowed:
            raise ValueError("unsupported stability group fields")
        strategy = options.get("type", group.get("type"))
        if strategy != group.get("type") and not (
                group.get("name") == "Research + AI" and strategy == "select"):
            raise ValueError(f"stability strategy conflicts with {group.get('name')} policy")
        group.update(options)
        if group.get("type") in ("url-test", "fallback", "load-balance"):
            if "interval" not in options:
                group["interval"] = default_interval
            interval = group.get("interval")
            if isinstance(interval, int) and not isinstance(interval, bool) and interval > ceiling:
                group["interval"] = ceiling
    additions = [f"IP-CIDR{('6' if ':' in cidr else '')},{cidr},Telegram,no-resolve"
                 for cidr in policy.get("telegram_cidrs", [])]
    config["rules"] = unique([*additions, *config.get("rules", [])])


def domain_routes(capabilities: dict, key: str, rule_type: str, allowed_groups: set[str]) -> list[str]:
    routes = validated_routes(capabilities.get(key, {}), key, allowed_groups)
    result = []
    for spec in routes.values():
        for domain in spec["domains"]:
            result.append(f"{rule_type},{domain},{spec['group']}")
    return result


def overlay_labels(capabilities: dict, key: str) -> list[str]:
    """Read an ordered node-label list from the deployment manifest.

    Node labels are subscription data: they live in the local manifest
    (/etc/mihomo/adaptive/capabilities.yaml, section ``overlay``) and are never
    part of this repository.  Missing or empty lists are valid and simply leave
    the corresponding curated pool empty.
    """
    overlay = capabilities.get("overlay", {})
    if not isinstance(overlay, dict):
        return []
    value = overlay.get(key, [])
    if not isinstance(value, list):
        return []
    return [str(item) for item in value if str(item).strip()]


def pool_nodes(nodes: set[str], capabilities: dict, key: str) -> list[str]:
    """Resolve one node pool from deployment patterns.

    Node names change on every subscription generation, so pools are expressed
    as regular expressions over the current node set.  A legacy label list
    (``overlay.<key>_nodes``) is still honoured as a fallback so an older
    manifest keeps generating a valid configuration.
    """
    overlay = capabilities.get("overlay", {})
    patterns = overlay.get(f"{key}_patterns") if isinstance(overlay, dict) else None
    if isinstance(patterns, list) and patterns:
        matched = [
            name for name in nodes
            if matches_any(name, [str(pattern) for pattern in patterns])
            and name not in {"DIRECT", "REJECT"}
        ]
        return sorted(matched)
    return ordered_existing(overlay_labels(capabilities, f"{key}_nodes"), nodes)


def bulk_capable_nodes(nodes: set[str], capabilities: dict) -> tuple[list[str], list[str], list[str]]:
    bulk = capabilities.get("roles", {}).get("bulk_download", {})
    if not isinstance(bulk, dict):
        bulk = {}
    stt_prefix = str(bulk.get("stt_prefix", "STT | "))
    bywave_prefix = str(bulk.get("bywave_prefix", "ByWave | "))
    stt_nodes = sorted(name for name in nodes if name.startswith(stt_prefix))
    bywave_nodes = sorted(name for name in nodes if name.startswith(bywave_prefix))

    glados = [
        name
        for name in nodes
        if not name.startswith((stt_prefix, bywave_prefix, "BWB | ", "InfraAPI | "))
        and name not in {"DIRECT", "REJECT"}
    ]
    glados_patterns = bulk.get("glados_patterns", [])
    glados_excludes = bulk.get("glados_exclude_patterns", [])
    if not isinstance(glados_patterns, list):
        glados_patterns = []
    if not isinstance(glados_excludes, list):
        glados_excludes = []
    glados_nodes = sorted(
        name
        for name in glados
        if matches_any(name, [str(pattern) for pattern in glados_patterns])
        and not matches_any(name, [str(pattern) for pattern in glados_excludes])
    )
    explicit = bulk.get("glados_explicit_allow", [])
    if isinstance(explicit, list):
        glados_nodes = unique([*glados_nodes, *[name for name in explicit if name in nodes]])
    return stt_nodes, bywave_nodes, glados_nodes


def main() -> None:
    if len(sys.argv) != 3:
        raise SystemExit("usage: mihomo-policy-overlay INPUT OUTPUT")

    source, destination = sys.argv[1:]
    with open(source, encoding="utf-8") as stream:
        config = yaml.safe_load(stream)
    if not isinstance(config, dict):
        raise SystemExit("configuration root must be a mapping")

    proxies = config.get("proxies")
    groups = copy.deepcopy(config.get("proxy-groups"))
    rules = config.get("rules")
    if not isinstance(proxies, list) or not isinstance(groups, list):
        raise SystemExit("configuration is missing proxies or proxy-groups")
    if not isinstance(rules, list):
        raise SystemExit("configuration is missing rules")

    nodes = {
        proxy.get("name")
        for proxy in proxies
        if isinstance(proxy, dict) and proxy.get("name")
    }
    route_defaults = load_route_defaults()
    capabilities = resolve_route_tables(load_capabilities(), route_defaults)
    secondary_nodes = sorted(name for name in nodes if name.startswith("BWB | "))
    infra_nodes = sorted(name for name in nodes if name.startswith("InfraAPI | "))
    stt_download_nodes, bywave_download_nodes, glados_download_nodes = bulk_capable_nodes(
        nodes, capabilities
    )
    # STT and ByWave are confirmed bulk-capable by the user.  GLaDOS enters
    # bulk pools only through the data-driven capability manifest, which is
    # deliberately narrower than the complete GLaDOS node set.
    stt_bulk_nodes = stt_download_nodes
    bywave_model_nodes = bywave_download_nodes
    bywave_github_nodes = bywave_download_nodes
    stt_model_nodes = stt_bulk_nodes
    stt_github_nodes = stt_bulk_nodes
    glados_model_nodes = glados_download_nodes
    glados_github_nodes = glados_download_nodes
    model_download_nodes = unique([*bywave_model_nodes, *stt_model_nodes, *glados_model_nodes])
    github_download_nodes = unique([*bywave_github_nodes, *stt_github_nodes, *glados_github_nodes])
    download_nodes = unique([*stt_model_nodes, *bywave_model_nodes, *glados_model_nodes])
    github_control_nodes = unique([*bywave_github_nodes, *stt_github_nodes])

    # Every pool is expressed as a pattern over the freshly merged node set
    # (`overlay.media_patterns`, `overlay.ai_patterns`, `overlay.auto_patterns`,
    # `overlay.developer_patterns`, `overlay.tw_fixed_patterns`), so a refresh
    # that renames every node keeps working.
    media_nodes = pool_nodes(nodes, capabilities, "media")
    streaming_nodes = media_nodes
    social_nodes = media_nodes
    telegram_nodes = media_nodes

    ai_group = next(
        (group for group in groups if group.get("name") == "Research + AI"),
        None,
    )
    measurement = runpy.run_path(str(Path(__file__).with_name("mihomo-measurement-policy")))
    restored_ai = measurement["owned_group_members"](
        ai_group or {}, config.get("proxy-providers", {}), nodes)
    ai_source_nodes = [
        name
        for name in (restored_ai if restored_ai is not None else (ai_group or {}).get("proxies", []))
        if name in nodes
        and not str(name).startswith(("STT | ", "ByWave | ", "BWB | ", "InfraAPI | "))
    ]
    # The AI candidate order is static: deployment-selected nodes lead, then
    # eligible subscription nodes.  Mihomo fallback uses this order without
    # runtime scoring or reordering.
    ai_nodes = pool_nodes(nodes, capabilities, "ai")
    ai_nodes = unique([*ai_nodes, *ai_source_nodes])

    auto_nodes = unique([*pool_nodes(nodes, capabilities, "auto"), *secondary_nodes, *infra_nodes])
    developer_nodes = unique([*pool_nodes(nodes, capabilities, "developer"), *secondary_nodes, *infra_nodes])
    tw_fixed_nodes = pool_nodes(nodes, capabilities, "tw_fixed")
    for name, candidates in (
        ("Auto", auto_nodes),
        ("Developer", developer_nodes),
        ("Streaming", streaming_nodes),
        ("Social", social_nodes),
        ("Telegram", telegram_nodes),
        ("Research + AI", ai_nodes),
        ("Download", download_nodes),
        ("STT Download", stt_model_nodes),
        ("ByWave Download", bywave_model_nodes),
        ("STT GitHub Download", stt_github_nodes),
        ("ByWave GitHub Download", bywave_github_nodes),
        ("GitHub Control", github_control_nodes),
        ("GitHub Download", github_download_nodes),
        ("Model Download", model_download_nodes),
        ("Package Download", download_nodes),
        ("TW Fixed IP", tw_fixed_nodes),
    ):
        if not candidates:
            raise SystemExit(f"no usable subscription nodes for {name}")

    replace_group(
        groups,
        "Auto",
        {
            "type": "url-test",
            "proxies": auto_nodes,
            "url": "https://www.gstatic.com/generate_204",
            "interval": 180,
            "tolerance": 100,
            "lazy": True,
            "timeout": 5000,
            "max-failed-times": 2,
            "expected-status": 204,
        },
    )
    replace_group(
        groups,
        "Developer",
        {
            "type": "url-test",
            "proxies": developer_nodes,
            "url": "https://github.com/favicon.ico",
            "interval": 180,
            "tolerance": 80,
            "lazy": True,
            "timeout": 6000,
            "max-failed-times": 2,
            "expected-status": 200,
        },
    )
    replace_group(
        groups,
        "Research + AI",
        {
            "type": "fallback",
            "proxies": ai_nodes,
            "url": "https://api.openai.com/v1/models",
            "interval": 180,
            "lazy": False,
            "timeout": 8000,
            "max-failed-times": 2,
            "expected-status": 401,
        },
    )
    replace_group(
        groups,
        "Streaming",
        {
            "type": "fallback",
            "proxies": streaming_nodes,
            "url": "https://www.youtube.com/generate_204",
            "interval": 900,
            "lazy": False,
            "timeout": 5000,
            "max-failed-times": 3,
            "expected-status": 204,
        },
    )
    upsert_group(
        groups,
        "Social",
        {
            "type": "fallback",
            "proxies": social_nodes,
            "url": "https://x.com/robots.txt",
            "interval": 120,
            "lazy": False,
            "timeout": 7000,
            "max-failed-times": 2,
            "expected-status": 200,
        },
    )
    upsert_group(
        groups,
        "Telegram",
        {
            "type": "fallback",
            "proxies": telegram_nodes,
            "url": "https://core.telegram.org/",
            "interval": 120,
            "lazy": False,
            "timeout": 7000,
            "max-failed-times": 2,
            "expected-status": 200,
        },
    )
    replace_group(groups, "TW Fixed IP", {"type": "select", "proxies": tw_fixed_nodes})

    # Hand-curated selectors are rebuilt from patterns for the same reason the
    # pools are: a refresh renames every node, and a selector left holding the
    # previous generation's names is exactly what made regeneration fail.
    selections = capabilities.get("selections", {})
    if isinstance(selections, dict) and "STT" not in selections:
        # Older manifests have no selector entry for this existing provider
        # group. Refresh its leaves without changing its strategy or metadata.
        # Retire only our generated ownership before adding explicit members;
        # otherwise native measurement sees mixed old/new ownership on refresh.
        for group in groups:
            if group.get("name") == "STT":
                owned = measurement["owned_group_members"](
                    group, config.get("proxy-providers", {}), nodes)
                if owned is None and group.get("use") and not group.get("proxies"):
                    # A user provider owns these leaves and filters. Adding a
                    # proxy list would change its routing/measurement contract.
                    continue
                if owned is not None:
                    health = config["proxy-providers"][group["use"][0]].get("health-check", {})
                    group.setdefault("url", health.get("url"))
                    group.setdefault("expected-status", health.get("expected-status", "*"))
                    group.pop("use", None)
                    group.pop("filter", None)
                group["proxies"] = list(stt_download_nodes)
    if isinstance(selections, dict):
        known_groups = {group.get("name") for group in groups}
        for name, spec in selections.items():
            if not isinstance(spec, dict):
                continue
            patterns = [str(pattern) for pattern in spec.get("patterns", [])]
            matched = [node for node in sorted(nodes)
                       if matches_any(node, patterns)] if patterns else []
            referenced = [str(item) for item in spec.get("members", [])
                          if str(item) in known_groups]
            members = unique([*referenced, *matched])
            if not members:
                continue
            entry = {"type": str(spec.get("type", "select")), "proxies": members}
            if any(group.get("name") == name for group in groups):
                replace_group(groups, name, entry)
            else:
                upsert_group(groups, name, entry)


    # Provider child groups remain available, while service routes test the
    # combined authorized leaf nodes through one shared, lightweight URLTest.
    download_probe = "https://www.gstatic.com/generate_204"
    upsert_group(
        groups,
        "STT Download",
        {
            "type": "url-test",
            "proxies": stt_model_nodes,
            "url": download_probe,
            "interval": 900,
            "lazy": True,
            "tolerance": 120,
            "timeout": 5000,
            "max-failed-times": 3,
            "expected-status": 204,
        },
    )
    upsert_group(
        groups,
        "ByWave Download",
        {
            "type": "url-test",
            "proxies": bywave_model_nodes,
            "url": download_probe,
            "interval": 900,
            "lazy": True,
            "tolerance": 120,
            "timeout": 5000,
            "max-failed-times": 3,
            "expected-status": 204,
        },
    )
    if glados_download_nodes:
        upsert_group(
            groups,
            "GLaDOS Download",
            {
                "type": "url-test",
                "proxies": glados_download_nodes,
                "url": download_probe,
                "interval": 900,
                "lazy": True,
                "tolerance": 150,
                "timeout": 5000,
                "max-failed-times": 3,
                "expected-status": 204,
            },
        )
    else:
        # Retained selectors/rules may still reference this owned child. Keep a
        # deny target so revocation neither revives old leaves nor routes direct.
        upsert_group(groups, "GLaDOS Download", {"type": "select", "proxies": ["REJECT"]})
    upsert_group(
        groups,
        "STT GitHub Download",
        {
            "type": "url-test",
            "proxies": stt_github_nodes,
            "url": download_probe,
            "interval": 900,
            "lazy": True,
            "tolerance": 120,
            "timeout": 5000,
            "max-failed-times": 3,
            "expected-status": 204,
        },
    )
    upsert_group(
        groups,
        "ByWave GitHub Download",
        {
            "type": "url-test",
            "proxies": bywave_github_nodes,
            "url": download_probe,
            "interval": 900,
            "lazy": True,
            "tolerance": 120,
            "timeout": 5000,
            "max-failed-times": 3,
            "expected-status": 204,
        },
    )
    if glados_github_nodes:
        upsert_group(
            groups,
            "GLaDOS GitHub Download",
            {
                "type": "url-test",
                "proxies": glados_github_nodes,
                "url": download_probe,
                "interval": 900,
                "lazy": True,
                "tolerance": 150,
                "timeout": 5000,
                "max-failed-times": 3,
                "expected-status": 204,
            },
        )
    else:
        upsert_group(groups, "GLaDOS GitHub Download", {"type": "select", "proxies": ["REJECT"]})
    upsert_group(
        groups,
        "GitHub Control",
        {
            "type": "fallback",
            "proxies": github_control_nodes,
            "url": "https://github.com/robots.txt",
            "interval": 300,
            "lazy": False,
            "timeout": 6000,
            "max-failed-times": 1,
            "expected-status": 200,
        },
    )
    upsert_group(
        groups,
        "GitHub Download",
        {
            "type": "url-test",
            "proxies": github_download_nodes,
            "url": download_probe,
            "interval": 900,
            "tolerance": 120,
            "lazy": True,
            "timeout": 5000,
            "max-failed-times": 3,
            "expected-status": 204,
        },
    )
    upsert_group(
        groups,
        "Model Download",
        {
            "type": "url-test",
            "proxies": model_download_nodes,
            "url": download_probe,
            "interval": 900,
            "tolerance": 120,
            "lazy": True,
            "timeout": 5000,
            "max-failed-times": 3,
            "expected-status": 204,
        },
    )
    upsert_group(
        groups,
        "Download",
        {
            "type": "url-test",
            "proxies": download_nodes,
            "url": download_probe,
            "interval": 900,
            "tolerance": 120,
            "lazy": True,
            "timeout": 5000,
            "max-failed-times": 3,
            "expected-status": 204,
        },
    )
    upsert_group(
        groups,
        "Package Download",
        {
            "type": "url-test",
            "proxies": download_nodes,
            "url": download_probe,
            "interval": 900,
            "tolerance": 120,
            "lazy": True,
            "timeout": 5000,
            "max-failed-times": 3,
            "expected-status": 204,
        },
    )

    if secondary_nodes:
        upsert_group(
            groups,
            "BWB Backup",
            {
                "type": "fallback",
                "proxies": secondary_nodes,
                "url": "https://www.gstatic.com/generate_204",
                "interval": 180,
                "lazy": False,
                "timeout": 6000,
                "max-failed-times": 2,
                "expected-status": 204,
            },
        )
        for group in groups:
            if group.get("name") != "Default Proxy":
                continue
            members = group.get("proxies")
            if not isinstance(members, list):
                raise SystemExit("Default Proxy does not contain a proxy list")
            members = [member for member in members if member != "BWB Backup"]
            insert_at = members.index("Auto") + 1 if "Auto" in members else 0
            members.insert(insert_at, "BWB Backup")
            group["proxies"] = members
            break

    if infra_nodes:
        upsert_group(
            groups,
            "InfraAPI Backup",
            {
                "type": "fallback",
                "proxies": infra_nodes,
                "url": "https://www.gstatic.com/generate_204",
                "interval": 300,
                "lazy": True,
                "timeout": 6000,
                "max-failed-times": 2,
                "expected-status": 204,
            },
        )
        for group in groups:
            if group.get("name") != "Default Proxy":
                continue
            members = group.get("proxies")
            if not isinstance(members, list):
                raise SystemExit("Default Proxy does not contain a proxy list")
            members = [member for member in members if member != "InfraAPI Backup"]
            insert_at = members.index("Auto") + 1 if "Auto" in members else 0
            members.insert(insert_at, "InfraAPI Backup")
            group["proxies"] = members
            break

    direct_prefix = [
        "RULE-SET,private-ip,DIRECT,no-resolve",
        "RULE-SET,game-domain,DIRECT",
        "RULE-SET,game-cn-domain,DIRECT",
        "RULE-SET,steam-domain,DIRECT",
        "RULE-SET,cn-domain,DIRECT",
        "RULE-SET,cn-ip,DIRECT,no-resolve",
    ]
    download_overrides = [
        *domain_routes(
            capabilities, "download_routes", "DOMAIN",
            DOWNLOAD_ROUTE_GROUPS,
        ),
        # GitHub release assets and container images, while normal browsing
        # continues to use the latency-optimized Developer group.
        "DOMAIN,ghcr.io,Download",
        "DOMAIN,registry-1.docker.io,Download",
        "DOMAIN-SUFFIX,production.cloudflare.docker.com,Download",
        # Model, dataset, and AI asset downloads.
        "DOMAIN-SUFFIX,huggingface.co,Model Download",
        "DOMAIN-SUFFIX,hf.co,Model Download",
        "DOMAIN-SUFFIX,cdn-lfs.huggingface.co,Model Download",
        "DOMAIN-SUFFIX,cdn-lfs-us-1.huggingface.co,Model Download",
        "DOMAIN-SUFFIX,cdn-lfs-eu-1.huggingface.co,Model Download",
        "DOMAIN-SUFFIX,civitai.com,Model Download",
        "DOMAIN-SUFFIX,replicate.delivery,Model Download",
        "DOMAIN-SUFFIX,kaggle.com,Model Download",
        "DOMAIN-SUFFIX,download.pytorch.org,Model Download",
        "DOMAIN-SUFFIX,download.tensorflow.org,Model Download",
        "DOMAIN-SUFFIX,ngc.nvidia.com,Model Download",
        "DOMAIN-SUFFIX,ollama.com,Model Download",
        "DOMAIN-SUFFIX,registry.ollama.ai,Model Download",
        "DOMAIN-SUFFIX,storage.googleapis.com,Model Download",
        "DOMAIN-SUFFIX,s3.amazonaws.com,Model Download",
        "DOMAIN,cdn.openai.com,Model Download",
        "DOMAIN,files.oaiusercontent.com,Model Download",
        # Operating-system and development-tool installers/updates.
        "DOMAIN-SUFFIX,download.microsoft.com,Download",
        "DOMAIN-SUFFIX,dl.delivery.mp.microsoft.com,Download",
        "DOMAIN-SUFFIX,vscode.download.prss.microsoft.com,Download",
        "DOMAIN-SUFFIX,swdownload.apple.com,Download",
        "DOMAIN-SUFFIX,updates.cdn-apple.com,Download",
        "DOMAIN-SUFFIX,download.jetbrains.com,Download",
        "DOMAIN-SUFFIX,download.mozilla.org,Download",
        "DOMAIN-SUFFIX,adobedownloads.edgesuite.net,Download",
        "DOMAIN-SUFFIX,ardownload.adobe.com,Download",
    ]
    service_overrides = [
        # AI domains use the explicitly ordered Research + AI fallback group.
        "DOMAIN-SUFFIX,openai.com,Research + AI",
        "DOMAIN-SUFFIX,chatgpt.com,Research + AI",
        "DOMAIN-SUFFIX,oaistatic.com,Research + AI",
        "DOMAIN-SUFFIX,oaiusercontent.com,Research + AI",
        "DOMAIN-SUFFIX,anthropic.com,Research + AI",
        "DOMAIN-SUFFIX,claude.ai,Research + AI",
        "DOMAIN-SUFFIX,gemini.google.com,Research + AI",
        "DOMAIN-SUFFIX,generativelanguage.googleapis.com,Research + AI",
        "DOMAIN-SUFFIX,aistudio.google.com,Research + AI",
        "DOMAIN-SUFFIX,ai.google.dev,Research + AI",
        "DOMAIN-SUFFIX,notebooklm.google.com,Research + AI",
        "DOMAIN-SUFFIX,scholar.google.com,Research + AI",
        "DOMAIN-SUFFIX,perplexity.ai,Research + AI",
        "DOMAIN-SUFFIX,x.ai,Research + AI",
        "DOMAIN-SUFFIX,grok.com,Research + AI",
        "DOMAIN-SUFFIX,cursor.com,Research + AI",
        "DOMAIN-SUFFIX,cursor.sh,Research + AI",
        "DOMAIN-SUFFIX,cursorapi.com,Research + AI",
        *domain_routes(capabilities, "video_routes", "DOMAIN-SUFFIX", {"Streaming", "Social"}),
        "DOMAIN-SUFFIX,telegram.org,Telegram",
        "DOMAIN-SUFFIX,t.me,Telegram",
        "DOMAIN-SUFFIX,telegram.me,Telegram",
        "DOMAIN-SUFFIX,telegra.ph,Telegram",
        "DOMAIN-SUFFIX,telesco.pe,Telegram",
        "DOMAIN-KEYWORD,telegram,Telegram",
        # Developer traffic is tested against GitHub itself.
        "DOMAIN-SUFFIX,github.com,GitHub Download",
        "DOMAIN-SUFFIX,github.io,Developer",
        "DOMAIN-SUFFIX,githubusercontent.com,GitHub Download",
        "DOMAIN-SUFFIX,githubassets.com,GitHub Download",
        "DOMAIN-SUFFIX,ghcr.io,Developer",
        "DOMAIN-SUFFIX,github.dev,Developer",
        # Generic Google assets should use the fast default path, not AI fixed IP.
        "DOMAIN-SUFFIX,gmail.com,Default Proxy",
        "DOMAIN-SUFFIX,googlemail.com,Default Proxy",
        "DOMAIN-KEYWORD,google,Default Proxy",
    ]

    prefix_set = set(direct_prefix)
    normalized_rules = [
        *direct_prefix,
        *download_overrides,
        *service_overrides,
        *[
            rule
            for rule in rules
            if isinstance(rule, str)
            and rule not in prefix_set
            and not rule.startswith("PROCESS-")
        ],
    ]

    config["proxy-groups"] = groups
    config["rules"] = unique(normalized_rules)
    config["unified-delay"] = False
    # Rebuild the owned business groups and rules first. Only after their old
    # references are gone may exact legacy file-provider owners be retired.
    retire_legacy_quality_providers(config, capabilities, route_defaults)
    apply_stability(config, capabilities)
    media = runpy.run_path(str(Path(__file__).with_name("mihomo-media-policy")))
    media["configure"](config, capabilities)
    measurement["configure_measurement"](config, capabilities)
    with open(destination, "w", encoding="utf-8") as stream:
        yaml.safe_dump(
            config,
            stream,
            allow_unicode=True,
            sort_keys=False,
            default_flow_style=False,
            width=4096,
        )


if __name__ == "__main__":
    main()
