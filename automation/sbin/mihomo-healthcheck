#!/bin/sh
# Observe local Mihomo forwarding structure; public egress is a separate signal.
#
#   (no args)          timer mode: recover a stopped core and observe
#   --observe-only     same observation without lock or recovery
#   --startup-check N wait for TUN + redirect + filter + policy route
#   --egress           strictly test proxied public egress now
#   --state            print the last recorded status line
set -eu
umask 077
state_dir=/run/mihomo-healthcheck
install -d -m 700 "$state_dir"
mixed_port=${MIHOMO_MIXED_PORT:-7890}
egress_every=${EGRESS_EVERY:-300}
egress_url=${EGRESS_URL:-https://www.gstatic.com/generate_204}
probes_file=${EGRESS_PROBES_FILE:-/etc/mihomo/health-probes.conf}
alert_failures=${EGRESS_ALERT_FAILURES:-1}
recovery_successes=${EGRESS_RECOVERY_SUCCESSES:-1}
alert=/usr/local/sbin/mihomo-alert

usage='usage: mihomo-healthcheck [--observe-only|--startup-check [seconds]|--egress|--state]'
case "${1:-}" in
  '') mode=timer; wait_s=0 ;;
  --observe-only) mode=observe; wait_s=0 ;;
  --egress) mode=egress; wait_s=0 ;;
  --state) mode=state; wait_s=0 ;;
  --startup-check)
    mode=startup
    if [ "${2:-}" = '' ]; then
      if [ "$(cut -d. -f1 /proc/uptime)" -lt 300 ]; then wait_s=75; else wait_s=20; fi
    else
      wait_s=$2
    fi
    ;;
  *) echo "$usage" >&2; exit 2 ;;
esac

if [ "$mode" = timer ]; then
for threshold in "$alert_failures" "$recovery_successes"; do
  case "$threshold" in ''|*[!0-9]*) exit 2 ;; esac
  [ "$threshold" -ge 1 ] || exit 2
done
fi

if [ "$mode" = state ]; then
  [ -s "$state_dir/status" ] || { echo 'no status recorded'; exit 1; }
  cat "$state_dir/status"
  case "$(cat "$state_dir/status")" in *business=failed*) exit 1 ;; esac
  exit 0
fi

maintenance=0
if [ "$mode" = timer ]; then
  # The subscription updater shares this lock while rewriting config/restarting.
  exec 8>/run/lock/mihomo-maintenance.lock
  flock -n 8 || maintenance=1
fi

started=$(systemctl show mihomo -p ActiveEnterTimestamp --value 2>/dev/null || true)
[ -n "$started" ] || started=-5min
probe() {
  tun_ok=0; redirect_ok=0; filter_ok=0; route_ok=0
  ip link show Mihomo >/dev/null 2>&1 && tun_ok=1
  nft list table inet mihomo 2>/dev/null | grep -q 'redirect to :' && redirect_ok=1
  nft list table inet rp_filter >/dev/null 2>&1 && filter_ok=1
  ip rule show 2>/dev/null | grep -q '^9000:' && route_ok=1
  cur=$(nft list table inet mihomo 2>/dev/null \
    | awk '/counter packets/{sub(/.*counter packets /,"");sub(/ .*/,"");s+=$1} END{print s+0}')
}
kernel_ok() {
  [ "$tun_ok" = 1 ] && [ "$redirect_ok" = 1 ] &&
    [ "$filter_ok" = 1 ] && [ "$route_ok" = 1 ]
}
base_business() {
  case "$mode_name" in
    process-inactive|process-stopping) business=failed; return ;;
  esac
  if kernel_ok; then
    if [ -n "$prev_packets" ] && [ "$cur" -gt "$prev_packets" ]; then business=verified
    else business=idle
    fi
  else
    business=failed
  fi
}

invalid_profile() {
  printf 'configuration=fail reason=invalid-profile\n' >"$details"
  mv "$details" "$state_dir/paths"
  echo fail
}

egress_probe() {
  records="primary|proxy|204|$egress_url"
  [ ! -r "$probes_file" ] || records=$(cat "$probes_file")
  passed=0; sampled=0
  details=$state_dir/paths.$$
  : >"$details"
  while IFS='|' read -r label path expected target extra; do
    case "$label" in ''|\#*) continue ;; *[!A-Za-z0-9_.-]*) invalid_profile; return ;; esac
    case "$expected" in ''|*[!0-9,]*) invalid_profile; return ;; esac
    case "$target" in http://*|https://*) ;; *) invalid_profile; return ;; esac
    sampled=$((sampled + 1))
    [ "$sampled" -le 6 ] && [ -z "$extra" ] || { invalid_profile; return; }
    transfer_ok=1
    case "$path" in
      proxy) code=$(curl -sS -m 6 -o /dev/null -w '%{http_code}' --socks5-hostname "127.0.0.1:$mixed_port" "$target" 2>/dev/null) || transfer_ok=0 ;;
      direct) code=$(curl -sS -m 6 -o /dev/null -w '%{http_code}' --noproxy '*' "$target" 2>/dev/null) || transfer_ok=0 ;;
      *) invalid_profile; return ;;
    esac
    result=fail
    if [ "$transfer_ok" = 1 ] && [ -n "$code" ]; then
      case ",$expected," in *",$code,"*) result=ok; passed=$((passed + 1)) ;; esac
    fi
    printf '%s=%s status=%s path=%s\n' "$label" "$result" "$code" "$path" >>"$details"
  done <<EOF
$records
EOF
  mv "$details" "$state_dir/paths"
  if [ "$passed" -eq 0 ]; then echo fail
  elif [ "$passed" -eq "$sampled" ]; then echo ok
  else echo partial
  fi
}

record_sample() {
  failures=0; successes=0
  case "$egress" in
    ok) successes=$(( $(cat "$state_dir/egress_successes" 2>/dev/null || echo 0) + 1 )) ;;
    fail|partial) failures=$(( $(cat "$state_dir/egress_failures" 2>/dev/null || echo 0) + 1 )) ;;
  esac
  printf '%s\n' "$failures" >"$state_dir/egress_failures"
  printf '%s\n' "$successes" >"$state_dir/egress_successes"
}

probe
if [ "$mode" = startup ]; then
  deadline=$(( $(date +%s) + wait_s ))
  while ! kernel_ok; do
    [ "$(date +%s)" -ge "$deadline" ] && break
    sleep 1
    probe
  done
  # A previous core's egress success says nothing about this startup. Leave
  # the external check to the timer without blocking the local structure gate.
  printf 'unknown\n' >"$state_dir/egress"
  printf '0\n' >"$state_dir/egress_at"
  printf '0\n' >"$state_dir/egress_failures"
  printf '0\n' >"$state_dir/egress_successes"
fi

if [ "$mode" = egress ]; then
  result=$(egress_probe)
  printf '%s\n' "$result" >"$state_dir/egress"
  printf '%s\n' "$(date +%s)" >"$state_dir/egress_at"
  echo "egress=$result"
  [ "$result" = ok ]
fi

prev_packets=$(cat "$state_dir/packets" 2>/dev/null || echo '')
printf '%s\n' "$cur" >"$state_dir/packets"
fatal=$(journalctl -u mihomo --since "$started" -o cat 2>/dev/null \
  | grep -m1 -E 'gVisor is not included|Start TUN listening error|parse config error' || true)

mode_name=process-running
action=none
process_state=$(systemctl is-active mihomo 2>/dev/null || true)
case "$process_state" in
  active) ;;
  activating) mode_name=process-activating ;;
  reloading) mode_name=process-reloading ;;
  deactivating) mode_name=process-stopping ;;
  *) mode_name=process-inactive ;;
esac
base_business

egress=$(cat "$state_dir/egress" 2>/dev/null || echo unknown)
if [ "$mode" = timer ] && [ "$maintenance" = 0 ] && [ "$business" != failed ]; then
  last_at=$(cat "$state_dir/egress_at" 2>/dev/null || echo 0)
  if [ $(( $(date +%s) - last_at )) -ge "$egress_every" ]; then
    egress=$(egress_probe)
    record_sample
    printf '%s\n' "$(date +%s)" >"$state_dir/egress_at"
    printf '%s\n' "$egress" >"$state_dir/egress"
  fi
fi
[ "$business" = failed ] || { { [ "$egress" != fail ] && [ "$egress" != partial ]; } || business=degraded; }

# A stopped core gets an immediate bounded recovery attempt. A running core with
# broken local forwarding structure needs three observations before restarting.
if [ "$mode" = timer ] && [ "$maintenance" = 0 ]; then
  case "$mode_name" in
    process-inactive) restart_due=1 ;;
    process-stopping|process-activating|process-reloading)
      printf '0\n' >"$state_dir/fail_streak"
      restart_due=0 ;;
    *)
      if [ "$business" = failed ]; then
        streak=$(( $(cat "$state_dir/fail_streak" 2>/dev/null || echo 0) + 1 ))
        printf '%s\n' "$streak" >"$state_dir/fail_streak"
        restart_due=0
        [ "$streak" -lt 3 ] || restart_due=1
      else
        printf '0\n' >"$state_dir/fail_streak"
        restart_due=0
      fi
      ;;
  esac

  if [ "$restart_due" = 1 ]; then
    now=$(date +%s)
    restarted_at=$(cat "$state_dir/restarted_at" 2>/dev/null || echo 0)
    if [ $(( now - restarted_at )) -ge 3600 ]; then
      logger -t mihomo-healthcheck "gateway process or forwarding structure failed; requesting restart"
      printf '%s\n' "$now" >"$state_dir/restarted_at"
      action=restart
      if systemctl restart mihomo; then
        if systemctl is-active --quiet mihomo; then
          mode_name=process-restarted
          probe
          mode_name=process-restarted
          base_business
        else
          mode_name=process-inactive
          business=failed
        fi
      else
        process_state=$(systemctl is-active mihomo 2>/dev/null || true)
        case "$process_state" in
          active)
            probe
            mode_name=process-running
            base_business ;;
          activating) mode_name=process-activating; base_business ;;
          reloading) mode_name=process-reloading; base_business ;;
          deactivating) mode_name=process-stopping; business=failed ;;
          *) mode_name=process-inactive; business=failed ;;
        esac
      fi
      # The old core's cached egress result cannot verify the restarted core.
      printf 'unknown\n' >"$state_dir/egress"
      printf '0\n' >"$state_dir/egress_at"
      egress=unknown
      printf '0\n' >"$state_dir/egress_failures"
      printf '0\n' >"$state_dir/egress_successes"
      [ "$business" = failed ] || { { [ "$egress" != fail ] && [ "$egress" != partial ]; } || business=degraded; }
    fi
  fi
fi

printf '%s mode=%s action=%s business=%s tun=%s redirect=%s filter=%s route=%s egress=%s packets=%s maintenance=%s fatal=%s\n' \
  "$(date -Is)" "$mode_name" "$action" "$business" "$tun_ok" "$redirect_ok" "$filter_ok" "$route_ok" \
  "$egress" "$cur" "$maintenance" "${fatal:-none}" >"$state_dir/status"

# Notify only from the timer. Keep a pending edge until delivery succeeds so a
# temporary notifier outage cannot erase it when the gateway later recovers.
if [ "$mode" = timer ] && [ "$maintenance" = 0 ] && [ -x "$alert" ]; then
  last_notified=$(cat "$state_dir/last_notified" 2>/dev/null || echo '')
  pending_file=$state_dir/pending_notification
  desired_state=; desired_key=; desired_message=
  case "$business:$egress" in
    failed:*)
      if [ "$last_notified" != failed ]; then
        desired_state=failed; desired_key=mihomo-failed
        desired_message="网关核心或本地转发结构失败：business=failed packets=$cur"
      fi ;;
    degraded:fail|degraded:partial)
      if [ "$last_notified" != degraded ] && [ "$(cat "$state_dir/egress_failures" 2>/dev/null || echo 0)" -ge "$alert_failures" ]; then
        desired_state=degraded; desired_key=mihomo-degraded
        desired_message="出站路径抽样异常（$egress）；保留核心及现有 DIRECT 规则。$(tr '\n' ';' <"$state_dir/paths" 2>/dev/null || true)"
      fi ;;
    idle:ok|verified:ok)
      if [ "$(cat "$state_dir/egress_successes" 2>/dev/null || echo 0)" -ge "$recovery_successes" ]; then
      case "$last_notified" in
        failed)
          desired_state=healthy; desired_key=mihomo-recovery
          desired_message="核心与本地转发结构已恢复：business=$business egress=ok" ;;
        degraded)
          desired_state=healthy; desired_key=mihomo-egress-recovery
          desired_message="代理出口探测已恢复：business=$business egress=ok" ;;
      esac
      fi ;;
    idle:unknown|verified:unknown)
      if [ "$last_notified" = failed ]; then
        desired_state=healthy; desired_key=mihomo-recovery
        desired_message='核心与本地转发结构已恢复；代理出口尚未探测，egress=unknown'
      fi ;;
  esac
  if [ -n "$desired_state" ]; then
    printf '%s\t%s\t%s\n' "$desired_state" "$desired_key" "$desired_message" >"$pending_file.tmp"
    mv "$pending_file.tmp" "$pending_file"
  else
    : >"$pending_file"
  fi
  if [ -s "$pending_file" ]; then
    IFS="$(printf '\t')" read -r pending_state pending_key pending_message <"$pending_file" || true
    if [ -n "${pending_state:-}" ] && "$alert" --health "$pending_message" "$pending_key"; then
      printf '%s\n' "$pending_state" >"$state_dir/last_notified.tmp"
      mv "$state_dir/last_notified.tmp" "$state_dir/last_notified"
      : >"$state_dir/pending_notification"
    fi
  fi
fi

[ "$maintenance" = 1 ] && exit 0
[ "$business" = failed ] && exit 1
exit 0
