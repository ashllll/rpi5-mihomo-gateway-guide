#!/bin/sh
# Passive observer for the mihomo gateway. Reads kernel state; the one active
# check (egress, at most every 5 minutes) goes through the proxy port and is
# ordinary traffic, not a measurement probe, so it never spends budget.
#
#   (no args)          timer mode: restart a dead process, then observe
#   --observe-only     same probe, no lock and no restart; exit 1 when failed
#   --startup-check N  wait up to N seconds for TUN + hooks (default: 20, or 75
#                      during the first 5 minutes after boot)
#   --egress           run the egress probe now and print the result
#
# The startup-check mode exists because `mihomo -t` validates the config but
# cannot prove the TUN device or its nftables hooks exist: on 2026-10-25 a core
# built without gVisor started cleanly, passed `-t`, and black-holed every
# proxied connection while domestic traffic kept working.
set -eu
umask 077
state_dir=/run/mihomo-healthcheck
install -d -m 700 "$state_dir"
lan_ip=${GATEWAY_LAN_IP:-127.0.0.1}
mixed_port=${MIHOMO_MIXED_PORT:-7890}
egress_every=${EGRESS_EVERY:-300}
egress_url=${EGRESS_URL:-https://www.gstatic.com/generate_204}
alert=/usr/local/sbin/mihomo-alert

usage='usage: mihomo-healthcheck [--observe-only|--startup-check [seconds]|--egress]'
case "${1:-}" in
  '') mode=timer; wait_s=0 ;;
  --observe-only) mode=observe; wait_s=0 ;;
  --egress) mode=egress; wait_s=0 ;;
  --startup-check)
    mode=startup
    if [ "${2:-}" = '' ]; then
      # A cold boot can be slower than a restart. The gate still has to pass -
      # the longer window only avoids a false red while interfaces settle.
      if [ "$(cut -d. -f1 /proc/uptime)" -lt 300 ]; then wait_s=75; else wait_s=20; fi
    else
      wait_s=$2
    fi
    ;;
  *) echo "$usage" >&2; exit 2 ;;
esac

if [ "$mode" = timer ]; then
  # The subscription updater holds the same lock while it rewrites config and
  # restarts the core, so skipping one tick is correct.
  exec 8>/run/lock/mihomo-maintenance.lock
  flock -n 8 || exit 0
fi

started=$(systemctl show mihomo -p ActiveEnterTimestamp --value 2>/dev/null || true)
[ -n "$started" ] || started=-5min
probe() {
  tun_ok=0; redirect_ok=0; filter_ok=0; route_ok=0
  ip link show Mihomo >/dev/null 2>&1 && tun_ok=1
  nft list table inet mihomo >/dev/null 2>&1 && redirect_ok=1
  nft list table inet rp_filter >/dev/null 2>&1 && filter_ok=1
  ip rule show 2>/dev/null | grep -q '^9000:' && route_ok=1
  cur=$(nft list table inet mihomo 2>/dev/null \
    | awk '/counter packets/{sub(/.*counter packets /,"");sub(/ .*/,"");s+=$1} END{print s+0}')
}
ok() { [ "$tun_ok" = 1 ] && [ "$redirect_ok" = 1 ] && [ "$filter_ok" = 1 ] && [ "$route_ok" = 1 ]; }

# Egress proof: a 204 fetched through the proxy port shows the whole chain
# (core -> outbound -> node -> internet) works, which the packet counter alone
# cannot. SOCKS5 hostname mode also proves the proxied DNS path.
egress_probe() {
  code=$(curl -sS -m 6 -o /dev/null -w '%{http_code}' \
    --socks5-hostname "$lan_ip:$mixed_port" "$egress_url" 2>/dev/null || true)
  [ "$code" = 204 ] && echo ok || echo fail
}

probe
if [ "$mode" = startup ]; then
  deadline=$(( $(date +%s) + wait_s ))
  while ! ok; do
    [ "$(date +%s)" -ge "$deadline" ] && break
    sleep 1
    probe
  done
fi

if [ "$mode" = egress ]; then
  result=$(egress_probe)
  printf '%s\n' "$result" >"$state_dir/egress"
  printf '%s\n' "$(date +%s)" >"$state_dir/egress_at"
  echo "egress=$result"
  [ "$result" = ok ]
fi

prev_business=$(sed -n 's/.*business=\([a-z]*\).*/\1/p' "$state_dir/status" 2>/dev/null | head -1 || true)
prev=$(cat "$state_dir/packets" 2>/dev/null || echo '')
printf '%s\n' "$cur" >"$state_dir/packets"
# Informational only: a fatal line from an earlier run must never fail a fresh
# start, so journal text is recorded but is not part of the decision.
fatal=$(journalctl -u mihomo --since "$started" -o cat 2>/dev/null \
  | grep -m1 -E 'gVisor is not included|Start TUN listening error|parse config error' || true)

mode_name=process-running
action=none
state=$(systemctl is-active mihomo 2>/dev/null || true)
# An ExecStartPost probe runs while the unit is still "activating", which is a
# healthy state and must not be reported as an inactive process.
case "$state" in
  active|activating|reloading) ;;
  *)
  mode_name=process-inactive
  if [ "$mode" = timer ]; then
    logger -t mihomo-healthcheck "Mihomo is inactive; requesting restart"
    systemctl restart mihomo
    action=restart
    systemctl is-active --quiet mihomo && mode_name=process-restarted
  fi
  ;;
esac

if [ "$mode_name" = process-inactive ]; then
  # Kernel state can outlive a dying process for a moment; a gateway without a
  # core is down no matter what the tables say.
  business=failed
elif ok; then
  if [ -n "$prev" ] && [ "$cur" -gt "$prev" ]; then business=verified; else business=idle; fi
else
  business=failed
fi

# Timer mode owns the egress sample; it costs one proxied request, no budget.
egress=$(cat "$state_dir/egress" 2>/dev/null || echo unknown)
if [ "$mode" = timer ] && [ "$business" != failed ]; then
  last_at=$(cat "$state_dir/egress_at" 2>/dev/null || echo 0)
  if [ $(( $(date +%s) - last_at )) -ge "$egress_every" ]; then
    egress=$(egress_probe)
    printf '%s\n' "$(date +%s)" >"$state_dir/egress_at"
    printf '%s\n' "$egress" >"$state_dir/egress"
  fi
fi
# A failed egress sample after a healthy one is a gateway fault, not a slow probe.
if [ "$business" = verified ] && [ "$egress" = fail ]; then business=degraded; fi

printf '%s mode=%s action=%s business=%s tun=%s redirect=%s filter=%s route=%s egress=%s packets=%s fatal=%s\n' \
  "$(date -Is)" "$mode_name" "$action" "$business" "$tun_ok" "$redirect_ok" "$filter_ok" "$route_ok" \
  "$egress" "$cur" "${fatal:-none}" >"$state_dir/status"

# Transitions only: a stable fault must not spam the phone, and recovery is sent
# once. Start failures are covered by the unit's OnFailure, not by this probe.
if [ "$mode" = timer ] && [ -x "$alert" ]; then
  case "${prev_business}:${business}" in
    failed:verified|failed:idle|failed:degraded|degraded:verified)
      "$alert" --health "网关已恢复：business=$business egress=$egress" health || true ;;
    verified:failed|idle:failed|degraded:failed|verified:degraded)
      "$alert" --health "网关异常：business=$business egress=$egress packets=$cur" health || true ;;
  esac
fi

[ "$business" = failed ] && exit 1
exit 0
