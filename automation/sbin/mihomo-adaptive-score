#!/usr/bin/python3

"""Collect per-service Mihomo node quality in shadow mode.

The collector never changes a proxy group or a selector.  It uses Mihomo's
small delay endpoint for a rotating sample of candidates and stores an EWMA,
failure streak, cooldown and score for a later policy-application stage.
"""

from __future__ import annotations

import json
import fcntl
import os
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlencode
from urllib.request import Request, urlopen

import yaml


CONFIG_PATH = Path("/etc/mihomo/config.yaml")
CAPABILITIES_PATH = Path(
    os.environ.get("MIHOMO_CAPABILITIES", "/etc/mihomo/adaptive/capabilities.yaml")
)
SECRET_PATH = Path("/etc/mihomo/secrets/dashboard.secret")
STATE_PATH = Path("/var/lib/mihomo-adaptive/scores.json")
# Deployment parameters: the controller listens on the gateway LAN address,
# which the deployer records in /etc/mihomo-automation.env.
GATEWAY_LAN_IP = os.environ.get("GATEWAY_LAN_IP", "10.77.0.1")
CONTROLLER_PORT = os.environ.get("MIHOMO_CONTROLLER_PORT", "9090")
CONTROLLER = f"http://{GATEWAY_LAN_IP}:{CONTROLLER_PORT}"
REQUEST_TIMEOUT = 10
MAX_WORKERS = 4
COOLDOWN_SECONDS = 15 * 60


def load_yaml(path: Path) -> dict:
    with path.open(encoding="utf-8") as stream:
        value = yaml.safe_load(stream)
    if not isinstance(value, dict):
        raise RuntimeError(f"invalid YAML mapping: {path}")
    return value


def load_state() -> dict:
    try:
        with STATE_PATH.open(encoding="utf-8") as stream:
            value = json.load(stream)
        return value if isinstance(value, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def api_get(path: str, secret: str) -> dict:
    request = Request(
        f"{CONTROLLER}{path}",
        headers={"Authorization": f"Bearer {secret}"},
    )
    with urlopen(request, timeout=REQUEST_TIMEOUT) as response:
        value = json.load(response)
    if not isinstance(value, dict):
        raise RuntimeError("controller returned a non-object response")
    return value


def flatten_group(name: str, groups: dict[str, dict], node_names: set[str]) -> list[str]:
    result: list[str] = []
    visiting: set[str] = set()

    def visit(item: str) -> None:
        if item in node_names:
            result.append(item)
            return
        if item in visiting:
            return
        group = groups.get(item)
        if not isinstance(group, dict):
            return
        visiting.add(item)
        for member in group.get("proxies", []) or []:
            if isinstance(member, str):
                visit(member)
        visiting.remove(item)

    visit(name)
    return list(dict.fromkeys(result))


def choose_sample(candidates: list[str], limit: int, cursor: int) -> tuple[list[str], int]:
    if not candidates:
        return [], 0
    if len(candidates) <= limit:
        return candidates, 0
    start = cursor % len(candidates)
    selected = [candidates[(start + offset) % len(candidates)] for offset in range(limit)]
    return selected, (start + limit) % len(candidates)


def probe(node: str, target: str, secret: str, expected: str = "200-399") -> dict:
    started = time.monotonic()
    query = urlencode({"url": target, "timeout": "6000", "expected": expected})
    path = f"/proxies/{quote(node, safe='')}/delay?{query}"
    try:
        value = api_get(path, secret)
        delay = value.get("delay")
        if isinstance(delay, bool) or not isinstance(delay, (int, float)) or delay <= 0:
            raise RuntimeError("controller returned no valid delay")
        # This core can return delay>0 even when expected HTTP status fails.
        # Selection uses per-URL state, not the global transport 'alive' bit.
        details = api_get(f"/proxies/{quote(node, safe='')}", secret)
        if details.get("extra", {}).get(target, {}).get("alive") is not True:
            raise RuntimeError("probe HTTP status did not satisfy expected range")
        return {
            "node": node,
            "ok": True,
            "delay_ms": round(float(delay), 1),
            "elapsed_ms": round((time.monotonic() - started) * 1000, 1),
        }
    except (HTTPError, URLError, OSError, RuntimeError, ValueError) as error:
        return {
            "node": node,
            "ok": False,
            "error": type(error).__name__,
            "elapsed_ms": round((time.monotonic() - started) * 1000, 1),
        }


def update_node(previous: dict, result: dict, now: float) -> dict:
    current = dict(previous) if isinstance(previous, dict) else {}
    samples = int(current.get("samples", 0) or 0)
    failures = int(current.get("consecutive_failures", 0) or 0)
    samples += 1
    if result["ok"]:
        delay = float(result["delay_ms"])
        old_ewma = current.get("ewma_delay_ms")
        ewma = delay if not isinstance(old_ewma, (int, float)) else old_ewma * 0.65 + delay * 0.35
        failures = 0
        current.update(
            {
                "ewma_delay_ms": round(ewma, 1),
                "last_delay_ms": round(delay, 1),
                "last_success_at": now,
                "consecutive_failures": 0,
                "cooldown_until": 0,
                "samples": samples,
                # Higher is better; this is intentionally only a ranking
                # signal.  Later stages combine it with throughput/stability.
                "quality_score": round(1000.0 / (ewma + 50.0), 4),
            }
        )
    else:
        failures += 1
        current.update(
            {
                "consecutive_failures": failures,
                "last_failure_at": now,
                "last_error": result.get("error", "probe-failed"),
                "cooldown_until": now + COOLDOWN_SECONDS if failures >= 3 else current.get("cooldown_until", 0),
                "quality_score": round(float(current.get("quality_score", 0.0) or 0.0) * 0.7, 4),
                "samples": samples,
            }
        )
    current["last_test_at"] = now
    return current


def atomic_write(value: dict) -> None:
    STATE_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix="scores.", dir=STATE_PATH.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(value, stream, ensure_ascii=False, indent=2, sort_keys=True)
            stream.write("\n")
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, STATE_PATH)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def main() -> int:
    lock_handle = open("/run/lock/mihomo-maintenance.lock", "a", encoding="utf-8")
    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("mihomo-adaptive-score skipped: maintenance lock is held")
        return 0

    config = load_yaml(CONFIG_PATH)
    capabilities = load_yaml(CAPABILITIES_PATH)
    secret = SECRET_PATH.read_text(encoding="utf-8").strip()
    if not secret:
        raise RuntimeError("Mihomo controller secret is empty")

    proxies = config.get("proxies", [])
    node_names = {
        item.get("name")
        for item in proxies
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }
    groups = {
        item.get("name"): item
        for item in config.get("proxy-groups", [])
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }
    services = capabilities.get("services", {})
    if not isinstance(services, dict):
        raise RuntimeError("capabilities.services must be a mapping")

    state = load_state()
    state.setdefault("version", 1)
    state.setdefault("mode", "shadow")
    state.setdefault("services", {})
    state.setdefault("cursors", {})
    now = time.time()
    jobs: list[tuple[str, str, str, str]] = []
    samples_by_service: dict[str, list[str]] = {}

    for service, spec in services.items():
        if not isinstance(spec, dict):
            continue
        target = spec.get("url")
        group_names = spec.get("groups", [])
        if not isinstance(target, str) or not isinstance(group_names, list):
            continue
        candidates: list[str] = []
        for group_name in group_names:
            if isinstance(group_name, str):
                candidates.extend(flatten_group(group_name, groups, node_names))
        candidates = list(dict.fromkeys(candidates))
        limit = int(spec.get("sample_limit", 8) or 8)
        cursor = int(state["cursors"].get(service, 0) or 0)
        selected, next_cursor = choose_sample(candidates, max(1, limit), cursor)
        state["cursors"][service] = next_cursor
        samples_by_service[service] = selected
        for node in selected:
            jobs.append((service, node, target, str(spec.get("expected", "200-399"))))

    results_by_service: dict[str, list[dict]] = {service: [] for service in samples_by_service}
    with ThreadPoolExecutor(max_workers=MAX_WORKERS) as executor:
        futures = {executor.submit(probe, node, target, secret, expected): (service, node)
                   for service, node, target, expected in jobs}
        for future in as_completed(futures):
            service, _node = futures[future]
            results_by_service.setdefault(service, []).append(future.result())

    total = 0
    successful = 0
    for service, results in results_by_service.items():
        service_state = state["services"].setdefault(service, {"nodes": {}})
        nodes_state = service_state.setdefault("nodes", {})
        for result in results:
            total += 1
            successful += int(result["ok"])
            node = result["node"]
            nodes_state[node] = update_node(nodes_state.get(node, {}), result, now)
        service_state.update(
            {
                "updated_at": now,
                "candidate_count": len(
                    list(
                        dict.fromkeys(
                            node
                            for group_name in services[service].get("groups", [])
                            if isinstance(group_name, str)
                            for node in flatten_group(group_name, groups, node_names)
                        )
                    )
                ),
                "sample_count": len(results),
                "success_count": sum(1 for result in results if result["ok"]),
            }
        )

    state["updated_at"] = now
    atomic_write(state)
    print(
        "mihomo-adaptive-score mode=shadow services=%d tested=%d success=%d state=%s"
        % (len(results_by_service), total, successful, STATE_PATH)
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"mihomo-adaptive-score failed: {error}", file=sys.stderr)
        raise
