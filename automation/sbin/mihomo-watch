#!/bin/sh
# Watch the gateway-wide conditions that no single unit notices itself: failed
# units, thermal throttling, disk, memory, and the WAN link. Every condition is
# edge-triggered through /run/mihomo-watch/<key>: a standing problem sends once
# and then a recovery message when it clears, so the timer can run every couple
# of minutes without turning into a pager.
#
#   mihomo-watch                run every check once (used by the timer)
#   mihomo-watch --self-test    send one message per alert type, no evaluation
#
# Delivery reuses mihomo-alert (ServerChan + Bark, /etc/mihomo-alert.env), so a
# broken notifier is logged and never takes the gateway down. Thresholds:
#   WATCH_TEMP_C=80  WATCH_DISK_PCT=90  WATCH_MEM_MB=512  WATCH_WAN_IF=wan0
set -u
umask 077
env_file=/etc/mihomo-alert.env
state_dir=/run/mihomo-watch
alert=/usr/local/sbin/mihomo-alert

# Site file first: it may override every default below.
[ -r "$env_file" ] && . "$env_file"
title=${ALERT_TITLE:-树莓派网关}
temp_c=${WATCH_TEMP_C:-80}
disk_pct=${WATCH_DISK_PCT:-90}
mem_mb=${WATCH_MEM_MB:-512}
wan_if=${WATCH_WAN_IF:-wan0}

mkdir -p "$state_dir"

push() { # key message
  "$alert" --health "$2" "$1" >/dev/null 2>&1 || logger -t mihomo-watch "alert failed: $2"
}
trip() { # key message — report once while the condition holds
  [ -e "$state_dir/$1" ] && return 0
  : >"$state_dir/$1"
  logger -t mihomo-watch "raised: $2"
  push "$1" "$2"
}
relax() { # key label — drop the condition and report the recovery
  [ -e "$state_dir/$1" ] || return 0
  rm -f "$state_dir/$1"
  logger -t mihomo-watch "cleared: $2"
  push "$1-recovered" "$title | 已恢复：$2"
}

check_units() {
  failed=$(systemctl --failed --plain --no-legend 2>/dev/null | awk '{print $1}' | tr '\n' ' ')
  for unit in $failed; do
    case "$unit" in
      *alert@* | mihomo-watch*) continue ;;
    esac
    trip "unit:$unit" "$title | systemd 单元失败：$unit"
  done
  for marker in "$state_dir"/unit:*; do
    [ -e "$marker" ] || continue
    unit=${marker##*/unit:}
    case " $failed " in
      *" $unit "*) continue ;;
    esac
    relax "unit:$unit" "单元 $unit"
  done
}

check_temp() {
  command -v vcgencmd >/dev/null 2>&1 || return 0
  temp=$(vcgencmd measure_temp 2>/dev/null | sed -n 's/temp=\([0-9.]*\).*/\1/p')
  throttled=$(vcgencmd get_throttled 2>/dev/null | sed -n 's/.*throttled=0x\([0-9a-f]*\).*/\1/p')
  throttled=${throttled:-0}
  hot=$(awk -v t="${temp:-0}" -v lim="$temp_c" 'BEGIN{print (t >= lim) ? 1 : 0}')
  # 0x1 undervoltage, 0x2 arm frequency capped, 0x4 currently throttled
  now=$(( 0x$throttled & 0x7 ))
  if [ "$hot" = 1 ] || [ "$now" -ne 0 ]; then
    trip temp "$title | 温度异常：${temp}C（上限 ${temp_c}C），throttled=0x$throttled"
  else
    relax temp "温度 ${temp}C，throttled=0x$throttled"
  fi
}

check_disk() {
  used=$(df -P / | awk 'NR==2 { gsub(/%/, "", $5); print $5 }')
  [ -n "$used" ] || return 0
  if [ "$used" -ge "$disk_pct" ]; then
    trip disk "$title | 磁盘使用率 ${used}%（上限 ${disk_pct}%）"
  else
    relax disk "磁盘使用率 ${used}%"
  fi
}

check_mem() {
  avail=$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo)
  [ -n "$avail" ] || return 0
  if [ "$avail" -lt "$mem_mb" ]; then
    trip mem "$title | 可用内存 ${avail}MB（下限 ${mem_mb}MB）"
  else
    relax mem "可用内存 ${avail}MB"
  fi
}

check_wan() {
  link=$(cat "/sys/class/net/$wan_if/operstate" 2>/dev/null)
  route=$(ip -4 route show default dev "$wan_if" 2>/dev/null)
  gateway=$(printf '%s\n' "$route" | sed -n 's/.*via \([0-9.]*\).*/\1/p' | head -1)
  reason=
  [ "$link" = up ] || reason="${reason}${wan_if} 链路 ${link:-missing}；"
  [ -n "$route" ] || reason="${reason}无默认路由；"
  [ -n "$gateway" ] || reason="${reason}无网关；"
  if [ -z "$reason" ] && ! ping -c2 -W2 -I "$wan_if" "$gateway" >/dev/null 2>&1; then
    reason="网关 $gateway 不可达；"
  fi
  if [ -n "$reason" ]; then
    trip wan "$title | WAN 异常（${wan_if}）：${reason%；}"
  else
    relax wan "WAN ${wan_if} 网关 $gateway 可达"
  fi
}

self_test() {
  # One message per type so the operator can confirm every push class lands.
  push self-test:unit "$title | 自检：systemd 单元失败类"
  push self-test:temp "$title | 自检：温度/降频类"
  push self-test:disk "$title | 自检：磁盘类"
  push self-test:mem "$title | 自检：内存类"
  push self-test:wan "$title | 自检：WAN/网络类"
  logger -t mihomo-watch "self-test sent 5 alert types"
}

case "${1:-}" in
  --self-test) self_test ;;
  '') check_units; check_temp; check_disk; check_mem; check_wan ;;
  *) echo 'usage: mihomo-watch [--self-test]' >&2; exit 2 ;;
esac
