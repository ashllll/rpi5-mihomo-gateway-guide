#!/bin/sh
# Watch the gateway-wide conditions that no single unit notices itself: failed
# units, thermal throttling, disk, memory, and the WAN link. Every condition is
# edge-triggered through /run/mihomo-watch/<key>: a standing problem sends once
# and then a recovery message when it clears, so the timer can run every couple
# of minutes without turning into a pager.
#
#   mihomo-watch                run every check once (used by the timer)
#   mihomo-watch --self-test    send one message per alert type, no evaluation
#
# Delivery reuses mihomo-alert (ServerChan + Bark, /etc/mihomo-alert.env), so a
# broken notifier is logged and never takes the gateway down. Thresholds:
#   WATCH_TEMP_C=80  WATCH_DISK_PCT=90  WATCH_MEM_MB=512  WATCH_WAN_IF=wan0
#   WATCH_DNS_BYPASS_IF=proxy20  WATCH_DNS_BYPASS_TARGET=<upstream resolver>
#
# The DNS-bypass probe rides on a kernel-log rule (table inet dns_bypass, hook
# priority -151) that only logs and never drops: a client that asks the upstream
# router for names gets answers this gateway cannot correct, and the proxied
# connection then dies on TLS. We cannot repair that per packet, so we report the
# device (address, DHCP name, MAC) the moment it happens.
set -u
umask 077
env_file=/etc/mihomo-alert.env
state_dir=/run/mihomo-watch
alert=/usr/local/sbin/mihomo-alert
media_config=/etc/mihomo/config.yaml

# Site file first: it may override every default below.
[ -r "$env_file" ] && . "$env_file"
title=${ALERT_TITLE:-树莓派网关}
temp_c=${WATCH_TEMP_C:-80}
disk_pct=${WATCH_DISK_PCT:-90}
mem_mb=${WATCH_MEM_MB:-512}
wan_if=${WATCH_WAN_IF:-wan0}
bypass_if=${WATCH_DNS_BYPASS_IF:-proxy20}
bypass_target=${WATCH_DNS_BYPASS_TARGET:-192.0.2.1}

mkdir -p "$state_dir"

push() { # key message
  if "$alert" --health "$2" "$1" >/dev/null 2>&1; then
    return 0
  fi
  logger -t mihomo-watch "alert failed: $2"
  return 1
}
trip() { # key message — report once while the condition holds
  [ -e "$state_dir/$1" ] && return 0
  if push "$1" "$2"; then
    : >"$state_dir/$1"
    logger -t mihomo-watch "raised: $2"
  fi
}
relax() { # key label — drop the condition and report the recovery
  [ -e "$state_dir/$1" ] || return 0
  if push "$1-recovered" "$title | 已恢复：$2"; then
    rm -f "$state_dir/$1"
    logger -t mihomo-watch "cleared: $2"
  fi
}

check_units() {
  failed_output=$(systemctl --failed --plain --no-legend 2>/dev/null) || return 0
  failed=$(printf '%s\n' "$failed_output" | awk '{print $1}' | tr '\n' ' ')
  for unit in $failed; do
    case "$unit" in
      *alert@* | mihomo-watch*) continue ;;
    esac
    trip "unit:$unit" "$title | systemd 单元失败：$unit"
  done
  for marker in "$state_dir"/unit:*; do
    [ -e "$marker" ] || continue
    unit=${marker##*/unit:}
    case " $failed " in
      *" $unit "*) continue ;;
    esac
    relax "unit:$unit" "单元 $unit"
  done
}

check_temp() {
  command -v vcgencmd >/dev/null 2>&1 || return 0
  temp_raw=$(vcgencmd measure_temp 2>/dev/null) || return 0
  throttled_raw=$(vcgencmd get_throttled 2>/dev/null) || return 0
  temp=$(printf '%s\n' "$temp_raw" | sed -n \
    -e "s/^temp=\\([0-9][0-9]*\\.[0-9][0-9]*\\)'C$/\\1/p" \
    -e "s/^temp=\\([0-9][0-9]*\\)'C$/\\1/p")
  throttled=$(printf '%s\n' "$throttled_raw" | sed -n 's/^throttled=0x\([0-9a-fA-F][0-9a-fA-F]*\)$/\1/p')
  awk -v value="$temp" 'BEGIN { exit !(value ~ /^[0-9]+([.][0-9]+)?$/) }' || return 0
  case "$throttled" in ''|*[!0-9a-fA-F]*) return 0 ;; esac
  [ "$temp_raw" = "temp=$temp'C" ] || return 0
  [ "$throttled_raw" = "throttled=0x$throttled" ] || return 0
  hot=$(awk -v t="$temp" -v lim="$temp_c" 'BEGIN{print (t >= lim) ? 1 : 0}')
  # 0x1 undervoltage, 0x2 arm frequency capped, 0x4 currently throttled
  now=$(( 0x$throttled & 0x7 ))
  if [ "$hot" = 1 ] || [ "$now" -ne 0 ]; then
    trip temp "$title | 温度异常：${temp}C（上限 ${temp_c}C），throttled=0x$throttled"
  else
    relax temp "温度 ${temp}C，throttled=0x$throttled"
  fi
}

check_disk() {
  used=$(df -P / | awk 'NR==2 { gsub(/%/, "", $5); print $5 }')
  [ -n "$used" ] || return 0
  if [ "$used" -ge "$disk_pct" ]; then
    trip disk "$title | 磁盘使用率 ${used}%（上限 ${disk_pct}%）"
  else
    relax disk "磁盘使用率 ${used}%"
  fi
}

check_mem() {
  avail=$(awk '/^MemAvailable:/ { print int($2 / 1024) }' /proc/meminfo)
  [ -n "$avail" ] || return 0
  if [ "$avail" -lt "$mem_mb" ]; then
    trip mem "$title | 可用内存 ${avail}MB（下限 ${mem_mb}MB）"
  else
    relax mem "可用内存 ${avail}MB"
  fi
}

check_wan() {
  link=$(cat "/sys/class/net/$wan_if/operstate" 2>/dev/null)
  route=$(ip -4 route show default dev "$wan_if" 2>/dev/null)
  gateway=$(printf '%s\n' "$route" | sed -n 's/.*via \([0-9.]*\).*/\1/p' | head -1)
  reason=
  [ "$link" = up ] || reason="${reason}${wan_if} 链路 ${link:-missing}；"
  [ -n "$route" ] || reason="${reason}无默认路由；"
  [ -n "$gateway" ] || reason="${reason}无网关；"
  if [ -z "$reason" ] && ! ping -c2 -W2 -I "$wan_if" "$gateway" >/dev/null 2>&1; then
    reason="网关 $gateway 不可达；"
  fi
  if [ -n "$reason" ]; then
    trip wan "$title | WAN 异常（${wan_if}）：${reason%；}"
  else
    relax wan "WAN ${wan_if} 网关 $gateway 可达"
  fi
}

check_dns_bypass() {
  # Observation only: the rule logs dport 53 aimed at the upstream resolver and
  # carries no verdict, so a client that bypasses this gateway still browses --
  # it just gets poisoned answers, which is what the alert is for.
  command -v nft >/dev/null 2>&1 || return 0
  command -v journalctl >/dev/null 2>&1 || return 0
  nft list table inet dns_bypass >/dev/null 2>&1 || nft -f - <<EOF
table inet dns_bypass {
  chain prerouting {
    type filter hook prerouting priority -151; policy accept;
    iifname != "$bypass_if" return
    ip daddr $bypass_target meta l4proto { tcp, udp } th dport 53 log prefix "dns-bypass " level info limit rate 6/minute
  }
}

EOF
  now=$(date +%s)
  since=$(cat "$state_dir/dns-bypass-last" 2>/dev/null || echo $((now - 600)))
  [ "$since" -ge "$now" ] && since=$((now - 600))
  seen=$(journalctl -k --since "@$since" -o cat 2>/dev/null \
    | grep 'dns-bypass ' | sed -n 's/.*SRC=\([0-9.]*\).*/\1/p' | sort -u)
  printf '%s' "$now" >"$state_dir/dns-bypass-last"
  [ -n "$seen" ] || return 0
  for ip in $seen; do
    name=$(awk -v ip="$ip" '$3==ip {print $4}' /run/dnsmasq-vlan-pilot/leases 2>/dev/null | head -1)
    [ "$name" = '*' ] && name=
    mac=$(ip neigh show "$ip" 2>/dev/null | sed -n 's/.*lladdr \([0-9a-f:]*\).*/\1/p' | head -1)
    who=${name:-未知主机名}${mac:+, $mac}
    logger -t mihomo-watch "dns-bypass: $ip $who -> $bypass_target"
    push "dns-bypass:$ip" "$title | 设备绕过网关 DNS：$ip（$who）正在向 $bypass_target 查询，会拿到污染答案"
  done
}

check_media() {
  command -v python3 >/dev/null 2>&1 || return 0
  [ -r "$media_config" ] || return 0
  observations=$(python3 - "$media_config" 2>/dev/null <<'PY'
import re
import sys
from pathlib import Path
import yaml

config_path = Path(sys.argv[1])
try:
    config = yaml.safe_load(config_path.read_text())
    if not isinstance(config, dict):
        raise ValueError("invalid config")
    groups = config.get("proxy-groups", [])
    providers = config.get("proxy-providers", {})
    if not isinstance(groups, list) or not isinstance(providers, dict):
        raise ValueError("invalid media configuration")
except Exception:
    sys.exit(1)

root = config_path.parent.resolve()
for group in groups:
    if not isinstance(group, dict) or group.get("empty-fallback") != "REJECT":
        continue
    group_name = group.get("name")
    if not isinstance(group_name, str) or not group_name or re.search(r"[/\x00-\x1f\x7f]", group_name):
        continue
    uses = group.get("use", [])
    if not isinstance(uses, list):
        continue
    for name in uses:
        if not isinstance(name, str) or not re.fullmatch(r"media-admission-[0-9a-f]{16}", name):
            continue
        provider = providers.get(name)
        if not isinstance(provider, dict) or provider.get("type") != "file":
            continue
        if provider.get("path") != f"./providers/{name}.yaml":
            continue
        provider_dir = root / "providers"
        provider_path = provider_dir / f"{name}.yaml"
        if provider_dir.is_symlink() or provider_path.is_symlink() or not provider_path.is_file():
            continue
        try:
            value = yaml.safe_load(provider_path.read_text())
            if not isinstance(value, dict) or not isinstance(value.get("proxies"), list):
                continue
            proxy_defs = value["proxies"]
            if any(not isinstance(proxy, dict) or not isinstance(proxy.get("name"), str)
                   or not isinstance(proxy.get("type"), str) for proxy in proxy_defs):
                continue
        except Exception:
            continue
        state = "healthy" if any(proxy["type"].lower() != "reject" for proxy in proxy_defs) else "empty"
        print(f"{group_name}\t{state}")
PY
) || return 0
  [ -n "$observations" ] || return 0
  printf '%s\n' "$observations" | while IFS="$(printf '\t')" read -r group state; do
    [ -n "$group" ] || continue
    case "$state" in
      empty) trip "media-empty:$group" "$title | 媒体代理池为空：$group（仅 REJECT）" ;;
      healthy) relax "media-empty:$group" "媒体代理池 $group 已有可用候选" ;;
    esac
  done
}

self_test() {
  # One message per type so the operator can confirm every push class lands.
  push self-test:unit "$title | 自检：systemd 单元失败类"
  push self-test:temp "$title | 自检：温度/降频类"
  push self-test:disk "$title | 自检：磁盘类"
  push self-test:mem "$title | 自检：内存类"
  push self-test:wan "$title | 自检：WAN/网络类"
  logger -t mihomo-watch "self-test sent 5 alert types"
}

case "${1:-}" in
  --self-test) self_test ;;
  '') check_units; check_temp; check_disk; check_mem; check_wan; check_dns_bypass; check_media ;;
  *) echo 'usage: mihomo-watch [--self-test]' >&2; exit 2 ;;
esac
