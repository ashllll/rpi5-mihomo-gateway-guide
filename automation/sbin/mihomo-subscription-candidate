#!/usr/bin/python3
"""Build a subscription candidate without changing the running gateway."""
from __future__ import annotations

import argparse
import copy
import os
from pathlib import Path
import subprocess
import sys
import tempfile

import yaml

NOTICE_PREFIXES = ("注：", "注意：", "剩余流量", "套餐到期", "更新订阅")
IGNORED_TYPES = {"direct", "reject", "reject-drop", "pass", "compatible"}


def usable_extra(path: Path) -> list[dict]:
    with path.open(encoding="utf-8") as stream:
        config = yaml.safe_load(stream)
    proxies = config.get("proxies") if isinstance(config, dict) else None
    if not isinstance(proxies, list) or not proxies or len(proxies) > 2000:
        raise SystemExit("extra subscription exceeds limits or does not contain proxies")
    if any(not isinstance(proxy, dict) or not proxy.get("name") or not proxy.get("type") for proxy in proxies):
        raise SystemExit("extra subscription contains an invalid proxy entry")
    real = [proxy for proxy in proxies if proxy["type"] not in IGNORED_TYPES
            and not str(proxy["name"]).strip().startswith(NOTICE_PREFIXES)]
    if not real:
        raise SystemExit("extra subscription does not contain usable proxy nodes")
    return real


def merge_sources(current_path: Path, subscription_path: Path, manifest_path: Path) -> dict:
    with open(current_path, encoding="utf-8") as stream:
        current = yaml.safe_load(stream)
    with open(subscription_path, encoding="utf-8") as stream:
        subscription = yaml.safe_load(stream)

    if not isinstance(current, dict) or not isinstance(subscription, dict):
        raise SystemExit("configuration root must be a mapping")

    # Upstream shape is whatever the airport publishes: a full clash profile or
    # a bare proxy list normalized from base64.  Only the node set is taken from
    # the subscription; the group skeleton always comes from the running config
    # so a subscription that ships airport-branded groups cannot rename or drop
    # the deployment's own topology.
    proxies = subscription.get("proxies")
    groups = current.get("proxy-groups")
    if not isinstance(proxies, list) or not proxies:
        raise SystemExit("subscription does not contain proxies")
    if not isinstance(groups, list) or not groups:
        raise SystemExit("current configuration does not contain proxy-groups")
    if len(proxies) > 2000:
        raise SystemExit("subscription exceeds safety limits")

    with open(manifest_path, encoding="utf-8") as manifest:
        extra_sources = [line.rstrip("\n").split("|", 2) for line in manifest if line.strip()]

    # A retained current config already contains the previous extra-source nodes.
    # Source identifiers are reserved prefixes, so remove those nodes before
    # appending the newly downloaded or last-known-good versions.
    extra_prefixes = tuple(f"{source_id} | " for source_id, _path, _fresh in extra_sources)
    proxies = [
        copy.deepcopy(proxy)
        for proxy in proxies
        if not (
            isinstance(proxy, dict)
            and isinstance(proxy.get("name"), str)
            and proxy["name"].startswith(extra_prefixes)
        )
    ]

    proxy_names = [item.get("name") for item in proxies if isinstance(item, dict)]
    group_names = [item.get("name") for item in groups if isinstance(item, dict)]
    if len(proxy_names) != len(proxies) or any(not name for name in proxy_names):
        raise SystemExit("subscription contains an invalid proxy entry")
    if len(group_names) != len(groups) or any(not name for name in group_names):
        raise SystemExit("subscription contains an invalid proxy-group entry")
    if len(set(proxy_names)) != len(proxy_names):
        raise SystemExit("subscription contains duplicate proxy names")
    if len(set(group_names)) != len(group_names):
        raise SystemExit("subscription contains duplicate proxy-group names")

    for source_id, source_path, _fresh in extra_sources:
        real_proxies = copy.deepcopy(usable_extra(Path(source_path)))
        old_names = [proxy.get("name") for proxy in real_proxies]
        if any(not name for name in old_names) or len(set(old_names)) != len(old_names):
            raise SystemExit(f"{source_id} contains invalid or duplicate proxy names")

        rename = {name: f"{source_id} | {name}" for name in old_names}
        for proxy in real_proxies:
            proxy["name"] = rename[proxy["name"]]
            for field in ("dialer-proxy", "detour"):
                if proxy.get(field) in rename:
                    proxy[field] = rename[proxy[field]]
        proxies.extend(real_proxies)
    # A successful refresh fully replaces the node set: the retry branch in
    # mihomo-update-subscription keeps the current nodes when the provider is
    # unreachable, so leftovers from an older generation never accumulate here.
    proxy_names = [proxy.get("name") for proxy in proxies]
    if len(proxies) > 4000 or len(set(proxy_names)) != len(proxy_names):
        raise SystemExit("merged subscriptions exceed limits or contain duplicate names")

    # Every group is rebuilt by mihomo-policy-overlay from the freshly merged
    # node set, so the skeleton only needs to carry the names and static policy
    # fields forward.  Stale member names must not survive a refresh.
    groups = copy.deepcopy(groups)

    merged = copy.deepcopy(current)
    merged["proxies"] = proxies
    merged["proxy-groups"] = groups
    return merged


def prepare(current: Path, subscription: Path, extras: Path, destination: Path, status: Path) -> None:
    inputs = {path.resolve() for path in (current, subscription, extras)}
    if destination.resolve() in inputs or status.resolve() in inputs or destination.resolve() == status.resolve():
        raise SystemExit("candidate and status outputs must be distinct from the inputs and each other")
    merged = merge_sources(current, subscription, extras)
    # Intermediate files stay behind the candidate seam. The standalone overlay
    # remains the policy implementation used by both commands.
    with tempfile.TemporaryDirectory(prefix="candidate-", dir=destination.parent) as raw:
        work = Path(raw)
        source = work / "merged.yaml"
        result = work / "candidate.yaml"
        # Preserve escaped name controls until the overlay can reject them.
        source.write_text(yaml.safe_dump(merged, allow_unicode=False, sort_keys=False, width=4096))
        subprocess.run(
            [sys.executable, str(Path(__file__).with_name("mihomo-policy-overlay")), str(source), str(result)],
            check=True,
        )
        with current.open(encoding="utf-8") as stream:
            before = yaml.safe_load(stream)
        with result.open(encoding="utf-8") as stream:
            after = yaml.safe_load(stream)
        os.chmod(result, 0o600)
        result.replace(destination)
        status.write_text("unchanged\n" if before == after else "changed\n", encoding="ascii")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    validate = commands.add_parser("validate-extra")
    validate.add_argument("source", type=Path)
    build = commands.add_parser("prepare")
    for name in ("current", "subscription", "extras", "destination", "status"):
        build.add_argument(name, type=Path)
    args = parser.parse_args()
    if args.command == "validate-extra":
        usable_extra(args.source)
    else:
        prepare(args.current, args.subscription, args.extras, args.destination, args.status)


if __name__ == "__main__":
    main()
