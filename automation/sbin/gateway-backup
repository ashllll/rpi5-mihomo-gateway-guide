#!/usr/bin/env python3
"""Create a whole-machine rollback point for the Raspberry Pi gateway.

The archive is self-describing: ``gateway-rollout.json`` travels with the
files, records every file's size, mode and sha256, the release_id that was
installed when the point was taken, the enabled/disabled state of every
managed systemd unit, and metadata-only entries for secrets.  A consumer can
therefore validate the point without trusting any state outside the archive.

Six categories are captured:

* mihomo config and policy (config.yaml, config.local.yaml, adaptive policy,
  providers, the read-only status agent);
* MosDNS config and rules, including custom-*.txt and the release the current
  symlink points at;
* dnsmasq upstream files;
* the nftables front door, its includes and the distro unit drop-in;
* secret metadata only - existence, mode and size are recorded, values are
  never read, hashed or written to the archive.  ``rp5-agent.token`` is
  regenerated by ``gateway-restore``;
* the managed systemd unit files and their enable/disable state.

Naming is ``/var/backups/gateway-rollout-<UTC time>-<release_id first 12>.tar.gz``.
The newest ``--keep`` (default 5) points are retained.  Five is one complete
automatic cycle (install, subscription apply, MosDNS update, core/DNS switch)
plus one manual point, with a bounded disk footprint.

The producer is read-only with respect to the gateway: it takes its own
non-blocking serialization lock, never the maintenance lock, so it can be
called from inside a transaction that already holds that lock.  A point taken
while another transaction is pending is still a valid file set, but the
manifest records ``pending_at_generation`` and the restore side refuses to
apply it: only a clean pre-change point may be restored silently.

Usage:
    gateway-backup [--reason TEXT] [--release-id HEX64] [--keep N]

Exit codes: 0 written, 1 refused/failed, 2 usage.
"""
import argparse
import fcntl
import hashlib
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time

FORMAT = 1
KIND = "gateway-rollout"
MANIFEST_NAME = "gateway-rollout.json"
DEFAULT_KEEP = 5
MAX_KEEP = 50
LOCK_TIMEOUT_S = 30

BACKUP_DIR = "var/backups"
INSTALLED_MANIFEST = "var/lib/mihomo-automation/installed-manifest.json"
SNAPSHOT_LOCK = "run/lock/gateway-rollout.lock"
SYSTEMCTL = "/usr/bin/systemctl"
CORE_SWAP_STATE = "var/lib/mihomo-swap/state.json"

SECRETS_DIR = "etc/mihomo/secrets"
TOKEN_PATH = "etc/mihomo/secrets/rp5-agent.token"
SECRET_EXTRA_PATHS = (
    "etc/mihomo-automation.env",
    "etc/mihomo-alert.env",
)
# The secret category is metadata-only.  A mutation flips this to False and
# the rollback check must then see the secret value inside the archive.
SECRETS_ARE_METADATA_ONLY = True

PENDING_PATHS = (
    "var/lib/mihomo-automation/.install-pending",
    "var/lib/mihomo-subscription-backups/transaction.pending",
    "etc/mosdns/backups/transaction.pending",
    "etc/mosdns/rules/pending",
)

# Managed systemd units are the files installed by automation/install.sh plus
# the distribution units whose drop-ins this repository owns.
UNIT_PREFIXES = ("mihomo", "mosdns", "dnsmasq", "rp5-agent", "homeassistant", "nftables")
EXTRA_UNITS = ("dnsmasq.service", "nftables.service")
UNIT_STATES = {"enabled", "enabled-runtime", "disabled", "static", "masked",
               "generated", "indirect", "transient", "not-found", "unknown"}

CATEGORY_ORDER = (
    "mihomo-config",
    "mosdns-rules",
    "dnsmasq-upstreams",
    "nftables",
    "secrets",
    "units",
)

EXPLICIT_FILES = {
    "mihomo-config": (
        "etc/mihomo/config.yaml",
        "etc/mihomo/config.local.yaml",
        "etc/mihomo/adaptive/capabilities.yaml",
        "etc/mihomo/adaptive/route-defaults.yaml",
        "etc/mihomo/reconcile-targets.conf",
        "etc/mihomo/health-probes.conf",
        "usr/local/sbin/rp5-agent.py",
    ),
    "mosdns-rules": (
        "etc/mosdns/config.yaml",
    ),
    "dnsmasq-upstreams": (
        "etc/dnsmasq-upstreams.conf",
        "etc/mihomo/dnsmasq-upstreams.direct",
        "etc/mihomo/dnsmasq-upstreams.mihomo",
        "etc/mihomo/dnsmasq-upstreams.mosdns",
        "etc/dnsmasq.d/resolver.conf",
        "etc/dnsmasq-vlan-pilot.conf",
    ),
    "nftables": (
        "etc/nftables.conf",
        "etc/systemd/system/nftables.service.d/override.conf",
    ),
}

PRUNE = (
    {"dir": "etc/mosdns/rules", "patterns": ["custom-*.txt"]},
    {"dir": "etc/nftables.d", "patterns": ["*.nft"]},
)


class Refused(Exception):
    pass


def gateway_root():
    value = os.environ.get("GATEWAY_ROOT", "/")
    if value in ("", "/"):
        return ""
    if not value.startswith("/"):
        raise Refused("invalid GATEWAY_ROOT: %s" % value)
    return value.rstrip("/")


def rooted(root, relative):
    return os.path.join(root, relative) if root else "/" + relative


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def release_from_manifest(root):
    path = rooted(root, INSTALLED_MANIFEST)
    try:
        with open(path, "r", encoding="utf-8") as handle:
            payload = json.load(handle)
    except (OSError, ValueError) as error:
        raise Refused("cannot read the installed manifest %s: %s" % (path, error))
    release = payload.get("release_id") if isinstance(payload, dict) else None
    if not isinstance(release, str) or not re.fullmatch(r"[0-9a-f]{64}", release):
        raise Refused("installed manifest has no valid release_id")
    return release


def pending_at_generation(root):
    found = []
    for relative in PENDING_PATHS:
        if os.path.lexists(rooted(root, relative)):
            found.append(relative)
    state_path = rooted(root, CORE_SWAP_STATE)
    try:
        with open(state_path, "r", encoding="utf-8") as handle:
            state = json.load(handle)
        if isinstance(state, dict) and state.get("phase") == "swapping":
            found.append(CORE_SWAP_STATE + " (phase=swapping)")
    except (OSError, ValueError):
        pass
    return found


def run_systemctl(*args):
    try:
        result = subprocess.run([SYSTEMCTL, *args], capture_output=True,
                                text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return 127, ""
    return result.returncode, (result.stdout or "").strip()


def unit_state(unit):
    code, output = run_systemctl("is-enabled", unit)
    value = output.splitlines()[0].strip() if output else ""
    if value in UNIT_STATES:
        return value
    if value:
        return "unknown"
    if code == 0:
        return "enabled"
    return "unknown"


def managed_unit_candidates(root):
    units = set(EXTRA_UNITS)
    base = rooted(root, "etc/systemd/system")
    try:
        names = os.listdir(base)
    except OSError:
        names = []
    for name in names:
        if not name.endswith((".service", ".timer")):
            continue
        if name.startswith(UNIT_PREFIXES):
            units.add(name)
    return sorted(units)


def add_regular(files, root, relative, category):
    path = rooted(root, relative)
    try:
        if not os.path.isfile(path) or os.path.islink(path):
            return
        with open(path, "rb") as handle:
            data = handle.read()
        info = os.stat(path)
    except OSError:
        return
    files[relative] = {
        "category": category,
        "type": "file",
        "mode": "%04o" % (info.st_mode & 0o777),
        "size": len(data),
        "sha256": sha256(data),
        "_data": data,
    }


def add_tree(files, root, relative, category, pattern=None):
    base = rooted(root, relative)
    for directory, _dirs, names in os.walk(base, followlinks=False):
        for name in sorted(names):
            path = os.path.join(directory, name)
            if os.path.islink(path):
                continue
            if pattern and not re.fullmatch(pattern, name):
                continue
            if not os.path.isfile(path):
                continue
            rel = os.path.relpath(path, root if root else "/")
            add_regular(files, root, rel, category)


def add_mosdns_rules(files, root):
    base_rel = "etc/mosdns/rules"
    base = rooted(root, base_rel)
    if not os.path.isdir(base):
        return
    current = os.path.join(base, "current")
    target = None
    if os.path.islink(current):
        target = os.readlink(current)
        if not re.fullmatch(r"releases/[A-Za-z0-9._-]+", target):
            raise Refused("mosdns rules/current points outside releases/: %r" % target)
        files[base_rel + "/current"] = {
            "category": "mosdns-rules",
            "type": "symlink",
            "target": target,
        }
        resolved = os.path.join(base, target)
        for directory, _dirs, names in os.walk(resolved, followlinks=False):
            for name in sorted(names):
                path = os.path.join(directory, name)
                if os.path.islink(path) or not os.path.isfile(path):
                    continue
                rel = os.path.relpath(path, root if root else "/")
                add_regular(files, root, rel, "mosdns-rules")
    elif os.path.isdir(current):
        add_tree(files, root, base_rel + "/current", "mosdns-rules")
    # Custom rules live beside the release tree and are part of the point.
    for name in sorted(os.listdir(base)):
        if re.fullmatch(r"custom-.*\.txt", name):
            add_regular(files, root, base_rel + "/" + name, "mosdns-rules")


def add_unit_files(files, root):
    base_rel = "etc/systemd/system"
    base = rooted(root, base_rel)
    if not os.path.isdir(base):
        return
    for directory, dirs, names in os.walk(base, followlinks=False):
        dirs[:] = sorted(dirs)
        for name in sorted(names):
            path = os.path.join(directory, name)
            if os.path.islink(path) or not os.path.isfile(path):
                continue
            rel = os.path.relpath(path, root if root else "/")
            top = os.path.relpath(path, base).split(os.sep)[0]
            if not top.startswith(UNIT_PREFIXES):
                continue
            if top == "nftables.service.d":
                continue  # the nftables category owns this drop-in
            if not rel.endswith((".service", ".timer", ".conf")):
                continue
            add_regular(files, root, rel, "units")


def collect_files(root):
    files = {}
    for category, relatives in EXPLICIT_FILES.items():
        for relative in relatives:
            add_regular(files, root, relative, category)
    add_tree(files, root, "etc/mihomo/providers", "mihomo-config")
    add_mosdns_rules(files, root)
    add_tree(files, root, "etc/nftables.d", "nftables", r".*\.nft")
    if not SECRETS_ARE_METADATA_ONLY:
        add_tree(files, root, SECRETS_DIR, "secrets")
        for relative in SECRET_EXTRA_PATHS:
            add_regular(files, root, relative, "secrets")
    add_unit_files(files, root)
    return files


def collect_secrets(root):
    entries = []
    candidates = []
    try:
        for name in sorted(os.listdir(rooted(root, SECRETS_DIR))):
            candidates.append(SECRETS_DIR + "/" + name)
    except OSError:
        pass
    candidates.extend(SECRET_EXTRA_PATHS)
    for relative in candidates:
        path = rooted(root, relative)
        try:
            info = os.stat(path)
        except OSError:
            continue
        if not os.path.isfile(path) or os.path.islink(path):
            continue
        entry = {
            "path": relative,
            "mode": "%04o" % (info.st_mode & 0o777),
            "size": info.st_size,
        }
        if relative == TOKEN_PATH:
            entry["min_length_ok"] = info.st_size >= 16
        entries.append(entry)
    return entries


def collect_units(root):
    units = []
    for unit in managed_unit_candidates(root):
        state = unit_state(unit)
        units.append({"unit": unit, "state": state})
    return units


def build_manifest(root, release, reason, files, secrets, units, pending):
    counts = {name: 0 for name in CATEGORY_ORDER}
    for entry in files.values():
        counts[entry["category"]] += 1
    counts["secrets"] = len(secrets)
    for entry in units:
        counts["units"] += 1
    records = []
    for relative in sorted(files):
        entry = files[relative]
        record = {"path": relative, "category": entry["category"],
                  "type": entry["type"]}
        if entry["type"] == "symlink":
            record["target"] = entry["target"]
        else:
            record.update(mode=entry["mode"], size=entry["size"],
                          sha256=entry["sha256"])
        records.append(record)
    return {
        "format": FORMAT,
        "kind": KIND,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "release_id": release,
        "reason": reason,
        "categories": counts,
        "files": records,
        "secrets": secrets,
        "units": units,
        "prune": [dict(item) for item in PRUNE],
        "pending_at_generation": pending,
        "excluded_runtime_state": [
            "var/lib/mihomo-subscription-backups/next-update",
            "var/lib/mihomo-subscription-backups/last-failure",
            "var/lib/mihomo-subscription-backups/retry-count",
            "run/mihomo-healthcheck/",
            "run/mihomo-dnsmasq-guard/",
        ],
    }


def write_archive(root, path, manifest, files):
    payload = json.dumps(manifest, indent=1, sort_keys=False).encode("utf-8") + b"\n"
    for relative in sorted(files):
        entry = files[relative]
        if entry["type"] == "file":
            if sha256(entry["_data"]) != entry["sha256"]:
                raise Refused("file changed while snapshotting: " + relative)
    descriptor, temporary = tempfile.mkstemp(prefix=".gateway-rollout.",
                                             suffix=".tmp", dir=os.path.dirname(path))
    try:
        with os.fdopen(descriptor, "wb") as handle:
            with tarfile.open(fileobj=handle, mode="w:gz") as archive:
                info = tarfile.TarInfo(MANIFEST_NAME)
                info.size = len(payload)
                info.mode = 0o600
                info.mtime = int(time.time())
                archive.addfile(info, io.BytesIO(payload))
                for relative in sorted(files):
                    entry = files[relative]
                    item = tarfile.TarInfo(relative)
                    item.mtime = int(time.time())
                    if entry["type"] == "symlink":
                        item.type = tarfile.SYMTYPE
                        item.linkname = entry["target"]
                        item.mode = 0o777
                        archive.addfile(item)
                        continue
                    item.size = len(entry["_data"])
                    item.mode = int(entry["mode"], 8)
                    archive.addfile(item, io.BytesIO(entry["_data"]))
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        directory = os.open(os.path.dirname(path) or ".", os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def prune_points(directory, keep):
    names = [name for name in os.listdir(directory)
             if re.fullmatch(r"gateway-rollout-\d{8}T\d{6}Z-[0-9a-f]{12}\.tar\.gz", name)]
    names.sort()
    for name in names[:-keep] if keep else names:
        os.unlink(os.path.join(directory, name))


def snapshot_lock(root):
    path = rooted(root, SNAPSHOT_LOCK)
    os.makedirs(os.path.dirname(path) or ".", mode=0o755, exist_ok=True)
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.time() + LOCK_TIMEOUT_S
    while True:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return descriptor
        except BlockingIOError:
            if time.time() >= deadline:
                os.close(descriptor)
                raise Refused("another rollback point is being written; timed out")
            time.sleep(0.2)


def main(argv=None):
    parser = argparse.ArgumentParser(add_help=True, description=__doc__)
    parser.add_argument("--reason", default="manual")
    parser.add_argument("--release-id")
    parser.add_argument("--keep", type=int, default=DEFAULT_KEEP)
    args = parser.parse_args(argv)
    if not 1 <= args.keep <= MAX_KEEP:
        parser.error("--keep must be between 1 and %d" % MAX_KEEP)
    os.umask(0o077)
    try:
        root = gateway_root()
        if args.release_id is not None:
            if not re.fullmatch(r"[0-9a-f]{64}", args.release_id):
                raise Refused("--release-id must be 64 lowercase hex characters")
            release = args.release_id
        else:
            release = release_from_manifest(root)
        directory = rooted(root, BACKUP_DIR)
        if os.path.islink(directory):
            raise Refused("refusing a symlinked backup directory: " + directory)
        os.makedirs(directory, mode=0o755, exist_ok=True)
        lock = snapshot_lock(root)
        try:
            files = collect_files(root)
            secrets = collect_secrets(root)
            units = collect_units(root)
            pending = pending_at_generation(root)
            manifest = build_manifest(root, release, args.reason, files, secrets,
                                      units, pending)
            stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
            name = "gateway-rollout-%s-%s.tar.gz" % (stamp, release[:12])
            path = os.path.join(directory, name)
            write_archive(root, path, manifest, files)
            prune_points(directory, args.keep)
        finally:
            os.close(lock)
    except Refused as error:
        print("gateway-backup: refusing: %s" % error, file=sys.stderr)
        return 1
    except (OSError, ValueError, tarfile.TarError) as error:
        print("gateway-backup: failed: %s" % error, file=sys.stderr)
        return 1
    counts = manifest["categories"]
    print("gateway-backup: archive=%s release=%s reason=%s categories=%s secrets=%d units=%d pending=%s" % (
        path, release, args.reason,
        ",".join("%s:%d" % (name, counts[name]) for name in CATEGORY_ORDER),
        len(secrets), len(units), len(pending)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
