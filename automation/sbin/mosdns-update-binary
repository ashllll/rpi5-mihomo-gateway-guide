#!/bin/sh

set -eu
umask 027

exec 9>/run/lock/mosdns-binary-update.lock
flock -n 9 || exit 0

backup_root=/etc/mosdns/backups
pending_file=$backup_root/transaction.pending
maintenance_lock=/run/lock/mihomo-maintenance.lock
# Deployment parameters.  See automation/env/automation.env.example; copy it to
# /etc/mihomo-automation.env and adjust the values before the first run.
if [ -r /etc/mihomo-automation.env ]; then
  . /etc/mihomo-automation.env
fi
: "${MIHOMO_MIXED_PORT:=7890}"
proxy=http://127.0.0.1:${MIHOMO_MIXED_PORT}
work_dir=$(mktemp -d /var/tmp/mosdns-binary.XXXXXX)
test_pid=
update_started=false
rolling_back=false
pending_phase=
pending_old_sha=
pending_new_sha=
pending_backup=
old_sha=
new_sha=
backup_path=

sync_path() {
  python3 -c 'import os, sys
descriptor = os.open(sys.argv[1], os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)' "$1"
}

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  if [ -n "$test_pid" ] && kill -0 "$test_pid" 2>/dev/null; then
    kill -TERM "$test_pid" 2>/dev/null || true
    wait "$test_pid" 2>/dev/null || true
  fi
  if [ "$update_started" = true ] && [ -s "$pending_file" ] && [ "$rolling_back" != true ]; then
    rolling_back=true
    if rollback_transaction; then
      logger -t mosdns-update-binary "Interrupted update rolled back to the previous mosdns"
    else
      logger -t mosdns-update-binary "Interrupted update rollback failed; pending record retained"
    fi
  fi
  case "$work_dir" in
    /var/tmp/mosdns-binary.*) rm -rf -- "$work_dir" ;;
  esac
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

fetch() {
  output=$1
  url=$2
  # Direct first: the host's own traffic bypasses the tunnel, so a direct
  # fetch bills no proxy traffic. Fall back to the mixed port when blocked.
  curl --fail --location --silent --show-error \
    --connect-timeout 3 --max-time 30 \
    --proto '=https' --tlsv1.2 \
    --output "$output" "$url" ||
  curl --fail --location --silent --show-error \
    --proxy "$proxy" \
    --connect-timeout 10 --max-time 180 \
    --retry 2 --retry-delay 2 \
    --proto '=https' --tlsv1.2 \
    --output "$output" "$url"
}

write_pending() {
  pending_phase=$1
  pending_old_sha=$2
  pending_new_sha=$3
  pending_backup=$4
  temporary=$pending_file.tmp.$$
  {
    printf 'format=1\n'
    printf 'kind=binary\n'
    printf 'phase=%s\n' "$pending_phase"
    printf 'old_sha256=%s\n' "$pending_old_sha"
    printf 'new_sha256=%s\n' "$pending_new_sha"
    printf 'backup=%s\n' "$pending_backup"
  } >"$temporary" || { rm -f -- "$temporary"; return 1; }
  chmod 600 "$temporary" || { rm -f -- "$temporary"; return 1; }
  sync_path "$temporary" || { rm -f -- "$temporary"; return 1; }
  mv -f -- "$temporary" "$pending_file" || { rm -f -- "$temporary"; return 1; }
  sync_path "$pending_file"
}

read_pending() {
  pending_phase=
  pending_old_sha=
  pending_new_sha=
  pending_backup=
  kind=
  while IFS='=' read -r key value; do
    case "$key" in
      format) [ "$value" = 1 ] || return 1 ;;
      kind) kind=$value ;;
      phase) pending_phase=$value ;;
      old_sha256) pending_old_sha=$value ;;
      new_sha256) pending_new_sha=$value ;;
      backup) pending_backup=$value ;;
    esac
  done <"$pending_file"
  [ "$kind" = binary ] || return 1
  case "$pending_phase" in
    prepared|applied|committed|restoring) ;;
    *) return 1 ;;
  esac
  case "$pending_old_sha" in
    *[!0-9a-f]*|'') return 1 ;;
  esac
  case "$pending_new_sha" in
    *[!0-9a-f]*|'') return 1 ;;
  esac
  [ "${#pending_old_sha}" -eq 64 ] || return 1
  [ "${#pending_new_sha}" -eq 64 ] || return 1
  case "$pending_backup" in
    "$backup_root"/binary-*/mosdns) ;;
    *) return 1 ;;
  esac
}

clear_pending() {
  rm -f -- "$pending_file"
  sync_path "$backup_root"
}

restore_binary() {
  backup=$1
  install -o root -g root -m 755 "$backup" /usr/local/bin/mosdns.new || return 1
  sync_path /usr/local/bin/mosdns.new || return 1
  mv -f -- /usr/local/bin/mosdns.new /usr/local/bin/mosdns || return 1
  sync_path /usr/local/bin
}

file_sha256() {
  sha256sum "$1" | cut -d' ' -f1
}

# A pending record is the only durable description of an update in flight.  A
# record that is not committed means the new binary never completed its health
# gate, so the only verifiable core is the recorded old one.
recover_pending() {
  [ -s "$pending_file" ] || return 0
  if ! read_pending; then
    logger -t mosdns-update-binary "Pending update record is invalid; refusing to guess"
    return 1
  fi
  current_sha=$(file_sha256 /usr/local/bin/mosdns) || return 1
  case "$pending_phase" in
    committed)
      if [ "$current_sha" = "$pending_new_sha" ]; then
        clear_pending
        logger -t mosdns-update-binary "Committed update already passed its health gate"
        return 0
      fi
      logger -t mosdns-update-binary "Committed update no longer matches the live binary"
      return 1
      ;;
  esac
  if [ "$current_sha" = "$pending_old_sha" ]; then
    clear_pending
    logger -t mosdns-update-binary "Pending update had not replaced the live binary; record cleared"
    return 0
  fi
  if [ "$(file_sha256 "$pending_backup")" != "$pending_old_sha" ]; then
    logger -t mosdns-update-binary "Pending backup does not match the recorded old sha256"
    return 1
  fi
  write_pending restoring "$pending_old_sha" "$pending_new_sha" "$pending_backup" || return 1
  if ! restore_binary "$pending_backup"; then
    logger -t mosdns-update-binary "Could not restore the recorded old binary"
    return 1
  fi
  if ! systemctl restart mosdns.service; then
    logger -t mosdns-update-binary "Could not restart mosdns after restoring the old binary"
    return 1
  fi
  if /usr/local/sbin/mosdns-healthcheck; then
    logger -t mosdns-update-binary "Interrupted update rolled back; the old binary is healthy"
  else
    logger -t mosdns-update-binary "Interrupted update rolled back; the old binary failed its health check"
  fi
  clear_pending
}

rollback_transaction() {
  [ -n "$backup_path" ] || return 1
  write_pending restoring "$old_sha" "$new_sha" "$backup_path" || return 1
  if ! restore_binary "$backup_path"; then
    logger -t mosdns-update-binary "Restoring the previous binary failed"
    return 1
  fi
  systemctl restart mosdns.service || true
  if ! /usr/local/sbin/mosdns-healthcheck; then
    logger -t mosdns-update-binary "Previous binary failed its post-rollback health check"
  fi
  clear_pending
}

# Recovery is the first thing a new run does, before any network access and
# before the version string is trusted: a pending record decides the state.
if [ -s "$pending_file" ]; then
  if [ "${MOSDNS_UPDATE_DRY_RUN:-0}" = 1 ]; then
    logger -t mosdns-update-binary "A pending update recovery is required before a dry run"
    exit 1
  fi
  exec 8>"$maintenance_lock"
  if ! flock -n 8; then
    logger -t mosdns-update-binary "Pending update recovery is waiting for maintenance"
    exit 1
  fi
  if ! recover_pending; then
    exit 1
  fi
  exit 0
fi

fetch "$work_dir/release.json" \
  https://api.github.com/repos/IrineSistiana/mosdns/releases/latest

tag=$(jq -er 'select(.draft == false and .prerelease == false) | .tag_name' \
  "$work_dir/release.json")
case "$tag" in
  v[0-9]*.[0-9]*.[0-9]*) ;;
  *) exit 1 ;;
esac

current=$(/usr/local/bin/mosdns version | awk '{print $1}')
case "$current" in
  "$tag"|"$tag"-*)
    [ "${MOSDNS_UPDATE_DRY_RUN:-0}" = 1 ] || exit 0
    ;;
esac

asset_url=$(jq -er \
  '.assets[] | select(.name == "mosdns-linux-arm64.zip") | .browser_download_url' \
  "$work_dir/release.json")
asset_digest=$(jq -er \
  '.assets[] | select(.name == "mosdns-linux-arm64.zip") | .digest' \
  "$work_dir/release.json")
case "$asset_url" in
  https://github.com/IrineSistiana/mosdns/releases/download/*/mosdns-linux-arm64.zip)
    ;;
  *) exit 1 ;;
esac
case "$asset_digest" in
  sha256:*) ;;
  *) exit 1 ;;
esac

fetch "$work_dir/mosdns.zip" "$asset_url"
expected_sha256=${asset_digest#sha256:}
actual_sha256=$(sha256sum "$work_dir/mosdns.zip" | cut -d' ' -f1)
[ "$actual_sha256" = "$expected_sha256" ]

unzip -p "$work_dir/mosdns.zip" mosdns >"$work_dir/mosdns"
chmod 0755 "$work_dir/mosdns"
candidate_version=$("$work_dir/mosdns" version | awk '{print $1}')
case "$candidate_version" in
  "$tag"|"$tag"-*) ;;
  *) exit 1 ;;
esac

test_dns_port=$((30000 + $$ % 9000))
test_api_port=$((50000 + $$ % 9000))
sed \
  -e "s#127.0.0.1:5335#127.0.0.1:$test_dns_port#g" \
  -e "s#127.0.0.1:9091#127.0.0.1:$test_api_port#g" \
  /etc/mosdns/config.yaml >"$work_dir/config.yaml"

"$work_dir/mosdns" start -c "$work_dir/config.yaml" -d /etc/mosdns \
  >"$work_dir/validation.log" 2>&1 &
test_pid=$!

validated=false
attempt=1
while [ "$attempt" -le 40 ]; do
  if ! kill -0 "$test_pid" 2>/dev/null; then
    break
  fi
  cn_answer=$(dig @127.0.0.1 -p "$test_dns_port" baidu.com A \
    +time=2 +tries=1 +short 2>/dev/null |
    awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { print; exit }')
  proxy_answer=$(dig @127.0.0.1 -p "$test_dns_port" openai.com A \
    +time=2 +tries=1 +short 2>/dev/null |
    awk '/^198\.1[89]\.[0-9]+\.[0-9]+$/ { print; exit }')
  if [ -n "$cn_answer" ] && [ -n "$proxy_answer" ] &&
     curl --fail --silent --max-time 1 \
       "http://127.0.0.1:$test_api_port/metrics" >/dev/null 2>&1; then
    validated=true
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.25
done

if [ "$validated" != true ]; then
  logger -t mosdns-update-binary "candidate $tag failed validation"
  sed -n '1,100p' "$work_dir/validation.log" >&2
  exit 1
fi

kill -TERM "$test_pid"
wait "$test_pid" || true
test_pid=

if [ "${MOSDNS_UPDATE_DRY_RUN:-0}" = 1 ]; then
  logger -t mosdns-update-binary "mosdns $tag passed candidate validation"
  exit 0
fi

# Recovery happens before the version check: a pending record, not the version
# string, decides whether the live binary may be trusted.
if [ -s "$pending_file" ]; then
  exec 8>"$maintenance_lock"
  if ! flock -n 8; then
    logger -t mosdns-update-binary "Pending update recovery is waiting for maintenance"
    exit 1
  fi
  if ! recover_pending; then
    exit 1
  fi
  exit 0
fi

# Only download and candidate validation happen outside the maintenance lock;
# every step that replaces the live binary or restarts mosdns holds it.
exec 8>"$maintenance_lock"
if ! flock -n 8; then
  logger -t mosdns-update-binary "Maintenance is active; candidate discarded"
  exit 0
fi
if [ -s "$pending_file" ]; then
  if ! recover_pending; then
    exit 1
  fi
  exit 0
fi

timestamp=$(date +%Y%m%d-%H%M%S)
backup_dir=$backup_root/binary-$timestamp
install -d -o root -g root -m 755 "$backup_dir"
cp -p /usr/local/bin/mosdns "$backup_dir/mosdns"
sync_path "$backup_dir/mosdns"
sync_path "$backup_dir"
old_sha=$(file_sha256 /usr/local/bin/mosdns)
new_sha=$(file_sha256 "$work_dir/mosdns")
backup_path=$backup_dir/mosdns
write_pending prepared "$old_sha" "$new_sha" "$backup_path"

update_started=true
install -o root -g root -m 755 "$work_dir/mosdns" /usr/local/bin/mosdns.new
sync_path /usr/local/bin/mosdns.new
mv -f -- /usr/local/bin/mosdns.new /usr/local/bin/mosdns
sync_path /usr/local/bin
write_pending applied "$old_sha" "$new_sha" "$backup_path"

if systemctl restart mosdns.service &&
   /usr/local/sbin/mosdns-healthcheck; then
  write_pending committed "$old_sha" "$new_sha" "$backup_path"
  clear_pending
  update_started=false
  logger -t mosdns-update-binary "mosdns updated from $current to $candidate_version"
  find "$backup_root" -mindepth 1 -maxdepth 1 -type d -name 'binary-*' \
    -printf '%T@ %p\n' | sort -nr | awk 'NR > 3 { print $2 }' |
    while IFS= read -r old_backup; do
      case "$old_backup" in
        "$backup_root"/binary-*) rm -rf -- "$old_backup" ;;
      esac
    done
  exit 0
fi

logger -t mosdns-update-binary "mosdns $tag failed after install; rolling back"
if rollback_transaction; then
  logger -t mosdns-update-binary "mosdns $tag rolled back to $current"
else
  logger -t mosdns-update-binary "mosdns $tag rollback failed; pending record retained"
fi
update_started=false
exit 1
