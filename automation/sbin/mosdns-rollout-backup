#!/usr/bin/env python3
"""Create the MosDNS-rollout rollback point consumed by mosdns-rollout-rollback.

This is the producer that was missing from the documented pair.  The consumer
has always accepted ``/var/backups/mosdns-rollout-*.tar.gz``; this script
writes exactly that shape:

* ``etc/mosdns/config.yaml`` and the rules tree (custom-*.txt plus the release
  the ``current`` symlink points at, symlink preserved);
* the MosDNS systemd units and the dnsmasq boot-safe drop-in;
* the MosDNS helper scripts and the dnsmasq upstream files the rollback
  switches between;
* ``mosdns-rollout.json`` with size/mode/sha256 of every member.

The archive never contains ``/etc/mihomo/secrets``.  Naming is
``/var/backups/mosdns-rollout-<UTC time>-<release_id first 12>.tar.gz`` and
the newest ``--keep`` (default 5) points are retained.

Usage:
    mosdns-rollout-backup [--release-id HEX64] [--keep N]

Exit codes: 0 written, 1 refused/failed, 2 usage.
"""
import argparse
import fcntl
import hashlib
import io
import json
import os
import re
import subprocess
import sys
import tarfile
import tempfile
import time

FORMAT = 1
KIND = "mosdns-rollout"
MANIFEST_NAME = "mosdns-rollout.json"
DEFAULT_KEEP = 5
MAX_KEEP = 50
LOCK_TIMEOUT_S = 30

BACKUP_DIR = "var/backups"
INSTALLED_MANIFEST = "var/lib/mihomo-automation/installed-manifest.json"
SNAPSHOT_LOCK = "run/lock/mosdns-rollout-backup.lock"

EXPLICIT_FILES = (
    "etc/mosdns/config.yaml",
    "etc/systemd/system/dnsmasq.service.d/boot-safe.conf",
    "usr/local/sbin/mosdns-healthcheck",
    "usr/local/sbin/mosdns-update-rules",
    "usr/local/sbin/mosdns-update-binary",
    "usr/local/sbin/dnsmasq-safe-start",
    "usr/local/sbin/mosdns-emergency-direct",
    "usr/local/sbin/mosdns-resume-auto",
    "etc/mihomo/dnsmasq-upstreams.direct",
    "etc/mihomo/dnsmasq-upstreams.mihomo",
    "etc/mihomo/dnsmasq-upstreams.mosdns",
)
UNIT_DIR = "etc/systemd/system"
UNIT_PREFIX = "mosdns"
RULES_DIR = "etc/mosdns/rules"
CURRENT_LINK = RULES_DIR + "/current"


class Refused(Exception):
    pass


def gateway_root():
    value = os.environ.get("GATEWAY_ROOT", "/")
    if value in ("", "/"):
        return ""
    if not value.startswith("/"):
        raise Refused("invalid GATEWAY_ROOT: %s" % value)
    return value.rstrip("/")


def rooted(root, relative):
    return os.path.join(root, relative) if root else "/" + relative


def sha256(data):
    return hashlib.sha256(data).hexdigest()


def release_from_manifest(root):
    path = rooted(root, INSTALLED_MANIFEST)
    try:
        with open(path, "r", encoding="utf-8") as handle:
            payload = json.load(handle)
    except (OSError, ValueError) as error:
        raise Refused("cannot read the installed manifest %s: %s" % (path, error))
    release = payload.get("release_id") if isinstance(payload, dict) else None
    if not isinstance(release, str) or not re.fullmatch(r"[0-9a-f]{64}", release):
        raise Refused("installed manifest has no valid release_id")
    return release


def add_file(files, root, relative):
    path = rooted(root, relative)
    if os.path.islink(path) or not os.path.isfile(path):
        return
    with open(path, "rb") as handle:
        data = handle.read()
    info = os.stat(path)
    files[relative] = {
        "type": "file",
        "mode": "%04o" % (info.st_mode & 0o777),
        "size": len(data),
        "sha256": sha256(data),
        "_data": data,
    }


def collect(root):
    files = {}
    for relative in EXPLICIT_FILES:
        add_file(files, root, relative)
    base = rooted(root, UNIT_DIR)
    try:
        names = sorted(os.listdir(base))
    except OSError:
        names = []
    for name in names:
        if name.startswith(UNIT_PREFIX) and name.endswith((".service", ".timer", ".conf")):
            add_file(files, root, UNIT_DIR + "/" + name)
    rules = rooted(root, RULES_DIR)
    if os.path.isdir(rules):
        for name in sorted(os.listdir(rules)):
            if re.fullmatch(r"custom-.*\.txt", name):
                add_file(files, root, RULES_DIR + "/" + name)
        link = rooted(root, CURRENT_LINK)
        if os.path.islink(link):
            target = os.readlink(link)
            if not re.fullmatch(r"releases/[A-Za-z0-9._-]+", target):
                raise Refused("mosdns rules/current points outside releases/: %r" % target)
            files[CURRENT_LINK] = {"type": "symlink", "target": target}
            resolved = os.path.join(rules, target)
            for directory, _dirs, names in os.walk(resolved, followlinks=False):
                for name in sorted(names):
                    path = os.path.join(directory, name)
                    if os.path.islink(path) or not os.path.isfile(path):
                        continue
                    add_file(files, root, os.path.relpath(path, root if root else "/"))
        elif os.path.isdir(link):
            for directory, _dirs, names in os.walk(link, followlinks=False):
                for name in sorted(names):
                    path = os.path.join(directory, name)
                    if os.path.islink(path) or not os.path.isfile(path):
                        continue
                    add_file(files, root, os.path.relpath(path, root if root else "/"))
    return files


def build_manifest(release, files):
    records = []
    for relative in sorted(files):
        entry = files[relative]
        if entry["type"] == "symlink":
            records.append({"path": relative, "type": "symlink",
                            "target": entry["target"]})
        else:
            records.append({"path": relative, "type": "file",
                            "mode": entry["mode"], "size": entry["size"],
                            "sha256": entry["sha256"]})
    return {
        "format": FORMAT,
        "kind": KIND,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "release_id": release,
        "files": records,
        "consumer": "mosdns-rollout-rollback /var/backups/mosdns-rollout-*.tar.gz",
    }


def write_archive(path, manifest, files):
    payload = json.dumps(manifest, indent=1).encode("utf-8") + b"\n"
    descriptor, temporary = tempfile.mkstemp(prefix=".mosdns-rollout.",
                                             suffix=".tmp", dir=os.path.dirname(path))
    try:
        with os.fdopen(descriptor, "wb") as handle:
            with tarfile.open(fileobj=handle, mode="w:gz") as archive:
                info = tarfile.TarInfo(MANIFEST_NAME)
                info.size = len(payload)
                info.mode = 0o600
                info.mtime = int(time.time())
                archive.addfile(info, io.BytesIO(payload))
                for relative in sorted(files):
                    entry = files[relative]
                    item = tarfile.TarInfo(relative)
                    item.mtime = int(time.time())
                    if entry["type"] == "symlink":
                        item.type = tarfile.SYMTYPE
                        item.linkname = entry["target"]
                        item.mode = 0o777
                        archive.addfile(item)
                        continue
                    item.size = len(entry["_data"])
                    item.mode = int(entry["mode"], 8)
                    archive.addfile(item, io.BytesIO(entry["_data"]))
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        directory = os.open(os.path.dirname(path) or ".", os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def prune_points(directory, keep):
    names = [name for name in os.listdir(directory)
             if re.fullmatch(r"mosdns-rollout-\d{8}T\d{6}Z-[0-9a-f]{12}\.tar\.gz", name)]
    names.sort()
    for name in names[:-keep] if keep else names:
        os.unlink(os.path.join(directory, name))


def snapshot_lock(root):
    path = rooted(root, SNAPSHOT_LOCK)
    os.makedirs(os.path.dirname(path) or ".", mode=0o755, exist_ok=True)
    descriptor = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    deadline = time.time() + LOCK_TIMEOUT_S
    while True:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return descriptor
        except BlockingIOError:
            if time.time() >= deadline:
                os.close(descriptor)
                raise Refused("another MosDNS rollback point is being written; timed out")
            time.sleep(0.2)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--release-id")
    parser.add_argument("--keep", type=int, default=DEFAULT_KEEP)
    args = parser.parse_args(argv)
    if not 1 <= args.keep <= MAX_KEEP:
        parser.error("--keep must be between 1 and %d" % MAX_KEEP)
    os.umask(0o077)
    try:
        root = gateway_root()
        if args.release_id is not None:
            if not re.fullmatch(r"[0-9a-f]{64}", args.release_id):
                raise Refused("--release-id must be 64 lowercase hex characters")
            release = args.release_id
        else:
            release = release_from_manifest(root)
        directory = rooted(root, BACKUP_DIR)
        if os.path.islink(directory):
            raise Refused("refusing a symlinked backup directory: " + directory)
        os.makedirs(directory, mode=0o755, exist_ok=True)
        lock = snapshot_lock(root)
        try:
            files = collect(root)
            if "etc/mosdns/config.yaml" not in files:
                raise Refused("there is no MosDNS config to roll back")
            manifest = build_manifest(release, files)
            stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
            name = "mosdns-rollout-%s-%s.tar.gz" % (stamp, release[:12])
            path = os.path.join(directory, name)
            write_archive(path, manifest, files)
            prune_points(directory, args.keep)
        finally:
            os.close(lock)
    except Refused as error:
        print("mosdns-rollout-backup: refusing: %s" % error, file=sys.stderr)
        return 1
    except (OSError, ValueError, tarfile.TarError) as error:
        print("mosdns-rollout-backup: failed: %s" % error, file=sys.stderr)
        return 1
    print("mosdns-rollout-backup: archive=%s release=%s files=%d" % (path, release, len(files)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
