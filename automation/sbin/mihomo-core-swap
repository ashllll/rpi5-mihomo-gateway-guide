#!/usr/bin/env python3
"""Atomic mihomo core swap over two slots, using renameat2(RENAME_EXCHANGE).

    mihomo-core-swap install <candidate> [sha256]   stage a candidate
    mihomo-core-swap activate                       exchange it with the live path
    mihomo-core-swap rollback                       exchange the previous core back
    mihomo-core-swap status                         report slots and state

Both paths always exist, so the swap replaces the live binary in one syscall:
a running core keeps its old inode, a restart picks up the new one. Failure of
the post-swap hash check swaps straight back, so the live path is never left
with a core we cannot name.
"""
import ctypes
import hashlib
import json
import os
import shutil
import sys

LIVE = "/usr/local/bin/mihomo"
BASE = "/usr/local/lib/mihomo-swap"
STATE = os.path.join(BASE, "state.json")
SLOTS = {"a": os.path.join(BASE, "a"), "b": os.path.join(BASE, "b")}
RENAME_EXCHANGE = 2

_libc = ctypes.CDLL(None, use_errno=True)


def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def read_state():
    try:
        with open(STATE, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def write_state(state):
    os.makedirs(BASE, mode=0o755, exist_ok=True)
    staging = STATE + ".stage"
    with open(staging, "w", encoding="utf-8") as handle:
        json.dump(state, handle, indent=2)
    os.chmod(staging, 0o600)
    os.replace(staging, STATE)


def exchange(first, second):
    if _libc.renameat2(-100, first.encode(), -100, second.encode(), RENAME_EXCHANGE) != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))


def emit(payload, code=0):
    print(json.dumps(payload), flush=True)
    return code


def main(argv):
    # The slot directory is created here, not at import: install is the only
    # entry point that writes, and `status` must stay read-only on a clean box.
    os.makedirs(BASE, mode=0o700, exist_ok=True)
    command = argv[1] if len(argv) > 1 else "status"
    if command == "install":
        if len(argv) < 3:
            return emit({"error": "install needs a candidate path"}, 2)
        source = argv[2]
        state = read_state()
        # Reuse the slot that is not the live one, so an activate is always one
        # exchange away from a full rollback.
        slot = "b" if state.get("live") == "a" else "a"
        staging = SLOTS[slot] + ".stage"
        shutil.copyfile(source, staging)
        os.chmod(staging, 0o755)
        got = sha256(staging)
        want = argv[3] if len(argv) > 3 else sha256(source)
        if got != want:
            os.unlink(staging)
            return emit({"error": "sha256 mismatch", "want": want, "got": got}, 2)
        os.replace(staging, SLOTS[slot])
        state.update({"staged": slot, "staged_sha256": got})
        write_state(state)
        return emit({"staged": slot, "sha256": got})

    if command == "activate":
        state = read_state()
        slot = state.get("staged")
        if slot not in SLOTS:
            return emit({"error": "nothing staged"}, 2)
        exchange(LIVE, SLOTS[slot])
        got = sha256(LIVE)
        if got != state.get("staged_sha256"):
            exchange(LIVE, SLOTS[slot])
            return emit({"error": "post-swap verify failed", "got": got}, 1)
        state.update({"live": slot, "live_sha256": got, "rollback_slot": slot, "staged": None})
        write_state(state)
        return emit({"live": slot, "sha256": got})

    if command == "rollback":
        state = read_state()
        slot = state.get("rollback_slot") or state.get("live")
        if slot not in SLOTS:
            return emit({"error": "no rollback target"}, 2)
        before = sha256(LIVE)
        exchange(LIVE, SLOTS[slot])
        state.update({"live": None if state.get("live") == slot else state.get("live"),
                      "live_sha256": None, "rollback_slot": None})
        write_state(state)
        return emit({"rolled_back_from": before, "now": sha256(LIVE), "slot": slot})

    if command == "status":
        return emit({"slots": {name: sha256(path) if os.path.exists(path) else None
                               for name, path in SLOTS.items()},
                     "live": sha256(LIVE) if os.path.exists(LIVE) else None,
                     "state": read_state()})

    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
