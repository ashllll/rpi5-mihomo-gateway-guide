#!/usr/bin/env python3
"""Atomic mihomo core swap over two slots, using renameat2(RENAME_EXCHANGE).

    mihomo-core-swap install <candidate> [sha256]   stage a candidate
    mihomo-core-swap activate                       exchange it with the live path
    mihomo-core-swap rollback                       exchange the previous core back
    mihomo-core-swap status                         report slots and state

Both paths always exist, so the swap replaces the live binary in one syscall:
a running core keeps its old inode, a restart picks up the new one. Failure of
the post-swap hash check swaps straight back, so the live path is never left
with a core we cannot name.
"""
import ctypes
import hashlib
import json
import os
import shutil
import sys

LIVE = "/usr/local/bin/mihomo"
BASE = "/usr/local/lib/mihomo-swap"
STATE = os.path.join(BASE, "state.json")
SLOTS = {"a": os.path.join(BASE, "a"), "b": os.path.join(BASE, "b")}
RENAME_EXCHANGE = 2

_libc = ctypes.CDLL(None, use_errno=True)


def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def fsync_path(path):
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def fsync_dir(path):
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def read_state():
    try:
        with open(STATE, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def write_state(state):
    os.makedirs(BASE, mode=0o755, exist_ok=True)
    staging = STATE + ".stage"
    with open(staging, "w", encoding="utf-8") as handle:
        json.dump(state, handle, indent=2)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(staging, 0o600)
    fsync_path(staging)
    os.replace(staging, STATE)
    fsync_dir(BASE)


def exchange(first, second):
    if _libc.renameat2(-100, first.encode(), -100, second.encode(), RENAME_EXCHANGE) != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err))


def emit(payload, code=0):
    print(json.dumps(payload), flush=True)
    return code


def main(argv):
    # The slot directory is created here, not at import: install is the only
    # entry point that writes, and `status` must stay read-only on a clean box.
    os.makedirs(BASE, mode=0o700, exist_ok=True)
    command = argv[1] if len(argv) > 1 else "status"
    if command == "install":
        if len(argv) < 3:
            return emit({"error": "install needs a candidate path"}, 2)
        source = argv[2]
        state = read_state()
        # Reuse the slot that is not the live one, so an activate is always one
        # exchange away from a full rollback.
        slot = "b" if state.get("live") == "a" else "a"
        staging = SLOTS[slot] + ".stage"
        shutil.copyfile(source, staging)
        os.chmod(staging, 0o755)
        fsync_path(staging)
        got = sha256(staging)
        want = argv[3] if len(argv) > 3 else sha256(source)
        if got != want:
            os.unlink(staging)
            return emit({"error": "sha256 mismatch", "want": want, "got": got}, 2)
        os.replace(staging, SLOTS[slot])
        fsync_dir(BASE)
        state.update({"staged": slot, "staged_sha256": got})
        write_state(state)
        return emit({"staged": slot, "sha256": got})

    if command == "activate":
        state = read_state()
        slot = state.get("staged")
        if slot not in SLOTS:
            return emit({"error": "nothing staged"}, 2)
        new_sha = state.get("staged_sha256")
        if not os.path.exists(SLOTS[slot]) or sha256(SLOTS[slot]) != new_sha:
            return emit({"error": "staged slot does not match the recorded sha256"}, 2)
        old_sha = sha256(LIVE) if os.path.exists(LIVE) else None
        # Write-ahead intent: fsynced before the exchange, so a crash between
        # the swap and the post-swap state write has one recoverable direction.
        intent = dict(state)
        intent.update({"phase": "swapping", "swap_slot": slot,
                       "old_sha256": old_sha, "new_sha256": new_sha})
        write_state(intent)
        exchange(LIVE, SLOTS[slot])
        fsync_dir(os.path.dirname(LIVE))
        fsync_dir(BASE)
        got = sha256(LIVE)
        if got != new_sha:
            exchange(LIVE, SLOTS[slot])
            fsync_dir(os.path.dirname(LIVE))
            fsync_dir(BASE)
            write_state(state)
            return emit({"error": "post-swap verify failed", "got": got}, 1)
        state.update({"live": slot, "live_sha256": got, "rollback_slot": slot, "staged": None})
        state.pop("phase", None)
        state.pop("swap_slot", None)
        state.pop("old_sha256", None)
        state.pop("new_sha256", None)
        write_state(state)
        return emit({"live": slot, "sha256": got})

    if command == "rollback":
        state = read_state()
        live_sha = sha256(LIVE) if os.path.exists(LIVE) else None
        phase = state.get("phase")

        def finish(old_sha):
            state.update({"live": None, "live_sha256": old_sha,
                          "rollback_slot": None, "staged": None})
            for key in ("phase", "swap_slot", "old_sha256", "new_sha256"):
                state.pop(key, None)
            write_state(state)
            return emit({"rolled_back_from": live_sha, "now": sha256(LIVE)})

        if phase == "swapping":
            slot = state.get("swap_slot")
            old_sha = state.get("old_sha256")
            new_sha = state.get("new_sha256")
            if slot not in SLOTS:
                return emit({"error": "swap intent names an unknown slot"}, 2)
            if live_sha == old_sha:
                # The intent was durable but the exchange never happened.
                return finish(old_sha)
            if live_sha != new_sha:
                return emit({"error": "live core matches neither side of the swap intent",
                             "live": live_sha, "old": old_sha, "new": new_sha}, 2)
            exchange(LIVE, SLOTS[slot])
            fsync_dir(os.path.dirname(LIVE))
            fsync_dir(BASE)
            if sha256(LIVE) != old_sha:
                return emit({"error": "rollback exchange did not restore the old core",
                             "now": sha256(LIVE)}, 2)
            return finish(old_sha)

        slot = state.get("rollback_slot") or state.get("live")
        staged = state.get("staged")
        if slot not in SLOTS and staged in SLOTS:
            # A crash image from before the intent phase existed: the recorded
            # staged slot tells us which side of the exchange to inspect.
            staged_sha = state.get("staged_sha256")
            slot_sha = sha256(SLOTS[staged]) if os.path.exists(SLOTS[staged]) else None
            if live_sha != staged_sha and slot_sha == staged_sha:
                return emit({"error": "nothing to roll back: staged core was never activated"}, 2)
            if live_sha != staged_sha:
                return emit({"error": "live core does not match the staged transaction"}, 2)
            # The exchange happened and the slot now holds the previous core.
            exchange(LIVE, SLOTS[staged])
            fsync_dir(os.path.dirname(LIVE))
            fsync_dir(BASE)
            old_sha = sha256(LIVE)
            if old_sha == staged_sha:
                return emit({"error": "rollback exchange did not replace the staged core"}, 2)
            return finish(old_sha)
        if slot not in SLOTS:
            return emit({"error": "no rollback target"}, 2)
        if live_sha != state.get("live_sha256"):
            # The state says a different core is live.  Refuse instead of
            # moving the "new" core back over a core we cannot name.
            return emit({"error": "live core does not match the recorded state",
                         "live": live_sha, "recorded": state.get("live_sha256")}, 2)
        before = live_sha
        exchange(LIVE, SLOTS[slot])
        fsync_dir(os.path.dirname(LIVE))
        fsync_dir(BASE)
        now = sha256(LIVE)
        if now == before:
            return emit({"error": "rollback exchange did not change the live core"}, 2)
        return finish(now)

    if command == "status":
        return emit({"slots": {name: sha256(path) if os.path.exists(path) else None
                               for name, path in SLOTS.items()},
                     "live": sha256(LIVE) if os.path.exists(LIVE) else None,
                     "state": read_state()})

    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
