#!/usr/bin/python3

"""Safely apply only persistent probe failures to Mihomo candidate pools.

This is the first actuator stage.  It deliberately does not reorder healthy
nodes or touch AI/streaming groups.  It removes a node from a provider pool
only after the scorer has placed it in cooldown, and restores it after the
cooldown expires.  Every config change is syntax-checked and followed by a
critical-path gate; failures restore the exact pre-change config.
"""

from __future__ import annotations

import copy
import fcntl
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from urllib.error import URLError
from urllib.request import Request, urlopen

import yaml


CONFIG_PATH = Path("/etc/mihomo/config.yaml")
STATE_PATH = Path("/var/lib/mihomo-adaptive/scores.json")
BASE_PATH = Path("/var/lib/mihomo-adaptive/base-pools.json")
BACKUP_ROOT = Path("/var/lib/mihomo-adaptive/backups")
LOCK_PATH = Path("/run/lock/mihomo-maintenance.lock")
# Deployment parameters: the mixed-port proxy listens on the gateway LAN
# address, which the deployer records in /etc/mihomo-automation.env.
GATEWAY_LAN_IP = os.environ.get("GATEWAY_LAN_IP", "10.77.0.1")
MIXED_PORT = os.environ.get("MIHOMO_MIXED_PORT", "7890")
PROXY = f"http://{GATEWAY_LAN_IP}:{MIXED_PORT}"
STATE_MAX_AGE = 20 * 60

# The first actuator stage only quarantines provider download leaves.  AI,
# streaming, social and Telegram remain controlled by their existing groups.
TARGETS = {
    "STT Download": ("model_download", 3),
    "ByWave Download": ("model_download", 3),
    "GLaDOS Download": ("model_download", 1),
    "STT GitHub Download": ("github_download", 3),
    "ByWave GitHub Download": ("github_download", 3),
    "GLaDOS GitHub Download": ("github_download", 1),
}


def load_yaml(path: Path) -> dict:
    with path.open(encoding="utf-8") as stream:
        value = yaml.safe_load(stream)
    if not isinstance(value, dict):
        raise RuntimeError(f"invalid YAML mapping: {path}")
    return value


def load_json(path: Path, default: dict) -> dict:
    try:
        with path.open(encoding="utf-8") as stream:
            value = json.load(stream)
        return value if isinstance(value, dict) else copy.deepcopy(default)
    except (FileNotFoundError, json.JSONDecodeError):
        return copy.deepcopy(default)


def atomic_json(path: Path, value: dict) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(prefix=f"{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(value, stream, ensure_ascii=False, indent=2, sort_keys=True)
            stream.write("\n")
        os.chmod(temp_name, 0o600)
        os.replace(temp_name, path)
    finally:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass


def node_names(config: dict) -> set[str]:
    return {
        item.get("name")
        for item in config.get("proxies", [])
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }


def keep_failed_node(node: str, service_state: dict, now: float) -> bool:
    info = service_state.get("nodes", {}).get(node, {})
    if not isinstance(info, dict):
        return False
    failures = int(info.get("consecutive_failures", 0) or 0)
    cooldown = float(info.get("cooldown_until", 0) or 0)
    return failures >= 3 and cooldown > now


def current_group_map(config: dict) -> dict[str, dict]:
    return {
        item.get("name"): item
        for item in config.get("proxy-groups", [])
        if isinstance(item, dict) and isinstance(item.get("name"), str)
    }


def candidate_config(config: dict, state: dict, base: dict, now: float) -> tuple[dict, dict, list[str]]:
    result = copy.deepcopy(config)
    groups = current_group_map(result)
    all_nodes = node_names(result)
    state_services = state.get("services", {})
    changed: list[str] = []

    for group_name, (service, minimum) in TARGETS.items():
        group = groups.get(group_name)
        if not isinstance(group, dict):
            continue
        current = [
            item for item in group.get("proxies", []) or []
            if isinstance(item, str) and item in all_nodes
        ]
        if not current:
            continue
        known = base.setdefault(group_name, [])
        if not isinstance(known, list):
            known = []
            base[group_name] = known
        known[:] = list(dict.fromkeys([*known, *current]))
        known[:] = [item for item in known if item in all_nodes]
        service_state = state_services.get(service, {})
        healthy = [item for item in known if not keep_failed_node(item, service_state, now)]
        failed = [item for item in known if item not in healthy]
        if len(healthy) < minimum:
            # Never empty a provider pool merely because the scorer is having
            # a bad day.  Keep enough candidates for existing fallback logic.
            desired = known
        else:
            current_healthy = [item for item in current if item in healthy]
            restored = [item for item in healthy if item not in current_healthy]
            desired = [*current_healthy, *restored]
            # Failed nodes are intentionally absent while their cooldown is
            # active; they remain in base-pools.json for automatic recovery.
        if desired != current:
            group["proxies"] = desired
            changed.append(group_name)

    return result, base, changed


def write_candidate(config: dict) -> Path:
    fd, temp_name = tempfile.mkstemp(prefix="mihomo-adaptive-", suffix=".yaml", dir=CONFIG_PATH.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            yaml.safe_dump(
                config,
                stream,
                allow_unicode=True,
                sort_keys=False,
                default_flow_style=False,
                width=4096,
            )
        os.chmod(temp_name, 0o600)
        return Path(temp_name)
    except Exception:
        try:
            os.unlink(temp_name)
        except FileNotFoundError:
            pass
        raise


def run_checked(command: list[str], timeout: int = 30) -> bool:
    try:
        completed = subprocess.run(
            command,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
            check=False,
        )
        return completed.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def status(url: str) -> str:
    command = [
        "curl",
        "--silent",
        "--show-error",
        "--output",
        "/dev/null",
        "--connect-timeout",
        "5",
        "--max-time",
        "12",
        "--write-out",
        "%{http_code}",
        "--proxy",
        PROXY,
        url,
    ]
    try:
        completed = subprocess.run(command, capture_output=True, text=True, timeout=15, check=False)
        return completed.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return "000"


def critical_paths_healthy() -> bool:
    checks = {
        "default": ("https://www.gstatic.com/generate_204", {"204"}),
        "ai": ("https://api.openai.com/v1/models", {"401", "2xx", "3xx", "403"}),
        "streaming": ("https://www.youtube.com/generate_204", {"204"}),
        "github": ("https://github.com/github/gitignore.git/info/refs?service=git-upload-pack", {"2xx", "3xx"}),
        "codeload": ("https://codeload.github.com/github/gitignore/zip/refs/heads/main", {"2xx", "3xx"}),
        "model": ("https://huggingface.co/gpt2/resolve/main/config.json", {"2xx", "3xx"}),
        "telegram": ("https://core.telegram.org/", {"2xx", "3xx"}),
    }
    for _attempt in range(2):
        passed = True
        for url, accepted in checks.values():
            code = status(url)
            if code in accepted:
                continue
            if "2xx" in accepted and code.startswith("2"):
                continue
            if "3xx" in accepted and code.startswith("3"):
                continue
            passed = False
            break
        if passed:
            return True
        time.sleep(2)
    return False


def restore(backup: Path) -> None:
    shutil.copy2(backup, CONFIG_PATH)
    os.chmod(CONFIG_PATH, 0o600)
    run_checked(["systemctl", "reload", "mihomo"], timeout=20)


def main() -> int:
    lock_handle = LOCK_PATH.open("a", encoding="utf-8")
    try:
        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("mihomo-adaptive-apply skipped: maintenance lock is held")
        return 0

    state = load_json(STATE_PATH, {})
    now = time.time()
    updated = float(state.get("updated_at", 0) or 0)
    if not updated or now - updated > STATE_MAX_AGE:
        print("mihomo-adaptive-apply skipped: score state is stale")
        return 0

    config = load_yaml(CONFIG_PATH)
    base = load_json(BASE_PATH, {})
    candidate, base, changed = candidate_config(config, state, base, now)
    atomic_json(BASE_PATH, base)
    if not changed:
        print("mihomo-adaptive-apply no-change")
        return 0

    candidate_path = write_candidate(candidate)
    try:
        if not run_checked(["/usr/local/bin/mihomo", "-t", "-d", "/etc/mihomo", "-f", str(candidate_path)], timeout=30):
            print("mihomo-adaptive-apply rejected: candidate validation failed")
            return 1

        stamp = time.strftime("%Y%m%d-%H%M%S")
        backup_dir = BACKUP_ROOT / stamp
        backup_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
        backup_path = backup_dir / "config.yaml"
        shutil.copy2(CONFIG_PATH, backup_path)
        os.chmod(backup_path, 0o600)

        shutil.copy2(candidate_path, CONFIG_PATH)
        os.chmod(CONFIG_PATH, 0o600)
        if not run_checked(["systemctl", "reload", "mihomo"], timeout=20):
            restore(backup_path)
            print("mihomo-adaptive-apply rolled back: reload failed")
            return 1
        time.sleep(2)
        if not run_checked(["systemctl", "is-active", "--quiet", "mihomo"], timeout=10):
            restore(backup_path)
            print("mihomo-adaptive-apply rolled back: Mihomo inactive")
            return 1
        if not critical_paths_healthy():
            restore(backup_path)
            print("mihomo-adaptive-apply rolled back: critical path gate failed")
            return 1
        print("mihomo-adaptive-apply changed=" + ",".join(changed) + " backup=" + str(backup_path))
        return 0
    finally:
        try:
            candidate_path.unlink()
        except FileNotFoundError:
            pass


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"mihomo-adaptive-apply failed: {error}", file=sys.stderr)
        raise
