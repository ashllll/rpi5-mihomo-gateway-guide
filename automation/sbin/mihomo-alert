#!/bin/sh
# Send actionable gateway status to ServerChan and Bark. Delivery is best effort: a broken
# notifier must never take the gateway down. Callers handle delivery failure
# without stopping forwarding and retry an unacknowledged transition.
#
#   mihomo-alert --test                     send a test message (bypasses the cooldown)
#   mihomo-alert --unit-failed <unit>       report a systemd unit failure
#   mihomo-alert --health <message> <key>   report a health transition
# Known diagnostic-only and unknown events are logged and acknowledged without
# pushing. Return 75 defers a selected event; other failures remain retryable.
#
# Configuration lives in /etc/mihomo-alert.env (mode 0600):
#   SERVERCHAN_SENDKEY=<sendkey>            https://sct.ftqq.com
#   BARK_URL=https://api.day.app/<device-key>
#   ALERT_COOLDOWN=600                      seconds between identical alerts
set -u
umask 077
env_file=/etc/mihomo-alert.env
state_file=/run/mihomo-alert.state
# Source the site file first: it owns the keys and may override any default.
[ -r "$env_file" ] && . "$env_file"
cooldown=${ALERT_COOLDOWN:-600}
title=${ALERT_TITLE:-树莓派网关}
serverchan_base=${SERVERCHAN_BASE:-https://sctapi.ftqq.com}

case "${1:-}" in
  --test) key=test; message="通知链路自检 $(date -Is)" ;;
  --unit-failed) key="unit:$2"; message="systemd 单元失败：$2" ;;
  --health) key=${3:-health}; message=$2 ;;
  *) echo 'usage: mihomo-alert --test | --unit-failed <unit> | --health <message> <key>' >&2; exit 2 ;;
esac

# Health transitions can oscillate; ServerChan's free tier is a handful of
# messages a day, so the generic health key gets its own, larger cooldown.
case "$key" in
  health) cooldown=${ALERT_COOLDOWN_HEALTH:-1800} ;;
esac

# Serialize cooldown bookkeeping with delivery; a busy sender is retryable.
exec 9>"$state_file.lock"
flock -w 1 9 || exit 1

# Keep diagnostic records in the journal; phone notifications describe impact.
formatted=$(python3 - "$key" "$message" "$title" <<'PYFORMAT'
import re, sys
key, raw, site = sys.argv[1:]
recovered = key.endswith(('-recovered', '-recovery'))
base = key[:-10] if key.endswith('-recovered') else key
names = {'ai': 'AI 服务', 'github': 'GitHub', 'video': '视频',
         'domestic': '国内网站', 'primary': '代理网站'}
summary = current = happened = advice = ''
level = 'passive' if recovered else 'active'

def field(name):
    match = re.search(r'\b' + name + r'=(\d)\b', raw)
    return match.group(1) if match else None

if key == 'test' or key.startswith('self-test:'):
    summary = '通知测试'
    current = '这是一条测试消息，不表示网络发生故障。'
    happened = '正在检查手机能否收到网关提醒。'
    advice = '看到这条消息即可，无需处理。'
elif key == 'mihomo-degraded':
    results = re.findall(r'([A-Za-z0-9_.-]+)=(ok|fail) status=([0-9]*) path=(proxy|direct)', raw)
    failed = list(dict.fromkeys(names.get(n, '其他网站') for n, result, _, _ in results if result == 'fail'))
    summary = ('、'.join(failed) + '访问检查异常') if failed else '网站访问检查异常'
    current = '；'.join(names.get(n, '其他网站') + ('：检查通过' if result == 'ok' else '：未能连接' if code in ('', '000') else '：返回异常响应') for n, result, code, _ in results)
    current = (current + '。' if current else '本轮网站访问检查未通过。') + '未通过的项目可能打不开或加载缓慢。'
    happened = '网关本地转发仍在运行，但部分网站访问检查失败；原因尚未确定，不能据此判断所有设备都已断网。'
    advice = '先重试受影响的网站；持续异常时检查或更换代理线路。'
elif key == 'mihomo-failed':
    summary = '经过树莓派的上网连接异常'
    current = '网关转发检查未通过，连接它的设备可能无法上网。'
    happened = '网关未能正常转发连接，自动修复是否成功还未确认。'
    advice = '先检查网线和主路由；如果仍不能上网，需要检查树莓派。'
    level = 'timeSensitive'
elif key in ('mihomo-recovery', 'mihomo-egress-recovery'):
    summary = '网关转发已恢复，网站访问待确认' if 'egress=unknown' in raw else '上网检查已恢复' if key == 'mihomo-recovery' else '网站访问检查已恢复'
    current = '本地转发检查已通过，网站访问尚未检查。' if 'egress=unknown' in raw else '本地转发和本轮网站访问检查已通过。'
    happened = '此前报告的异常已通过相应复查；尚未验证每台设备的实际使用。'
    advice = '重试之前打不开的网站。能正常使用就无需处理。'
elif key.startswith('unit:'):
    unit = base[5:].removesuffix('.service')
    if recovered:
        sys.exit(0)  # Leaving the failed-unit list does not prove functional recovery.
    if unit in ('mihomo-subscription-update', 'mihomo-update-subscription'):
        summary = '代理线路列表更新未完成'
        current = '本次没有确认更新成功；是否影响上网，需要看实际访问结果。'
        happened = '更新代理线路列表时出错。'
        advice = '如果现在还能上网，可以继续使用；下次仍失败时，检查订阅是否过期或失效。'
    elif unit in ('mihomo', 'mosdns', 'dnsmasq', 'dnsmasq-vlan-pilot', 'mihomo-measurement-budget'):
        summary = '网关的联网功能需要检查'
        current = '经过树莓派的设备可能无法上网，实际访问情况尚未确认。'
        happened = '网关的一项必要功能停止工作或启动失败。'
        advice = '重试网页；如果仍打不开，检查树莓派，留意后续上网检查结果。'
        level = 'timeSensitive'
    elif unit in ('mihomo-watch', 'mihomo-healthcheck', 'mosdns-healthcheck', 'mihomo-dnsmasq-guard'):
        summary = '网关自动检查暂时不可用'
        current = '部分故障可能无法被及时发现或自动修复；不代表已经断网。'
        happened = '一次自动检查执行失败。'
        advice = '先确认设备能否上网，并检查树莓派的自动检查功能。'
    elif unit == 'mihomo-media-guard':
        summary = '图片和视频线路筛选暂停'
        current = '暂时无法继续筛掉慢线路；当前播放速度尚未确认。'
        happened = '本次图片和视频线路检查未完成。'
        advice = '如果图片或视频卡顿，先重试或换线路；持续异常再检查树莓派。'
    else:
        sys.exit(0)
elif key in ('mosdns-failed', 'mosdns-degraded', 'mosdns-recovery'):
    if key == 'mosdns-degraded':
        cn, proxy = field('cn'), field('proxy_fake')
        if cn == proxy == '1':
            # Keep the observer unacknowledged: a later real lookup failure may
            # have the same degraded state and must still produce a notification.
            sys.exit(75)
        summary = '部分网站的网址查询异常'
        parts = [('国内网站', cn), ('代理网站', proxy)]
        current = '；'.join(label + ('：网址查询通过' if value == '1' else '：网址查询失败' if value == '0' else '：查询情况未确认') for label, value in parts) + '。部分网站可能打不开。'
        happened = '网关查询网站地址时出现异常，仍保留能用的查询方式。'
        advice = '重试打不开的网站；持续异常时检查树莓派。'
    elif key == 'mosdns-recovery':
        summary = '网址查询检查已恢复'
        current = '国内网站和代理网站的网址查询检查均已通过。'
        happened = '此前失败的网址查询已通过复查。'
        advice = '重试之前打不开的网站。能正常使用就无需处理。'
    else:
        summary = '网址查询异常，正在尝试备用方式'
        current = '设备可能连着 Wi-Fi 却打不开网站，备用方式是否生效尚未确认。'
        happened = '网址查询没有正常应答，已请求切换到备用方式。'
        advice = '稍后重试网页；如果仍打不开，需要检查树莓派。'
        level = 'timeSensitive'
elif base in ('temp', 'disk', 'mem', 'wan'):
    values = re.findall(r'([0-9.]+)(C|MB|%)', raw)
    if base == 'temp':
        temps = [v for v, unit in values if unit == 'C']
        bits = re.search(r'throttled=0x([0-9a-fA-F]+)', raw)
        flags = int(bits.group(1), 16) & 7 if bits else 0
        hot = len(temps) > 1 and float(temps[0]) >= float(temps[1])
        summary = '树莓派温度或供电检查已恢复' if recovered else '树莓派供电不足' if flags & 1 else '树莓派温度偏高' if hot else '树莓派运行速度受到限制'
        current = ('当前温度 ' + temps[0] + '℃。' if temps else '')
        current += '本轮温度和供电检查已通过。' if recovered else ('检测到供电不足。' if flags & 1 else '') + ('温度达到提醒线 ' + temps[1] + '℃。' if hot else '') + ('树莓派正在降低运行速度，网络可能变慢。' if flags & 6 else '')
        current = current or '温度或供电检查未通过，具体读数尚未确认。'
        happened = '此前的温度或供电异常已消失。' if recovered else '硬件状态检查出现异常，可能影响网关稳定性。'
        advice = '无需处理，留意是否再次出现。' if recovered else '检查电源适配器和供电线。' if flags & 1 and not hot else '检查散热；如同时供电不足，也要检查电源和供电线。'
    elif base in ('disk', 'mem'):
        disk = base == 'disk'
        numbers = [v for v, unit in values if unit == ('%' if disk else 'MB')]
        summary = ('树莓派存储空间' if disk else '树莓派可用内存') + ('已回到正常范围' if recovered else '不足')
        current = ('存储空间已用 ' + numbers[0] + '%' if disk else '可用内存剩余 ' + numbers[0] + ' MB') if numbers else '本轮资源检查已通过' if recovered else '本轮资源检查低于可用要求'
        if len(numbers) > 1:
            current += '，提醒线为 ' + numbers[1] + ('%' if disk else ' MB')
        current += '。'
        happened = '此前的资源不足已缓解。' if recovered else '空间不足可能导致配置和日志无法保存。' if disk else '内存不足可能导致网关运行不稳。'
        advice = '无需立即处理，留意是否再次不足。' if recovered else '清理不需要的文件和旧日志。' if disk else '检查是否有额外程序占用过多内存。'
    else:
        summary = '树莓派与主路由的连接已恢复' if recovered else '树莓派连不上主路由'
        current = '网线连接和主路由可达检查已通过；外网是否可用尚未确认。' if recovered else '树莓派到主路由的连接检查未通过，经过它的设备可能无法上网。'
        happened = '此前的连接异常已通过复查。' if recovered else '未检测到正常的上游连接，或主路由没有回应检查。'
        advice = '重试网页确认上网情况。' if recovered else '检查树莓派网线、路由器端口和主路由是否通电。'
        level = 'passive' if recovered else 'timeSensitive'
elif base.startswith('media-empty:'):
    group = {'Social': '推特图片和视频', 'Streaming': '视频播放'}.get(base.split(':', 1)[1], '部分图片和视频')
    summary = group + ('已有达标线路' if recovered else '暂无达标线路')
    current = '已有通过速度检查的线路，实际播放还需重试确认。' if recovered else '当前没有通过速度检查的可用线路，相关图片或视频可能无法加载。'
    happened = '此前缺少的线路已补回。' if recovered else '目前没有线路通过图片和视频的速度筛选。'
    advice = '重试图片或视频，能正常使用就无需处理。' if recovered else '等待后续检查；急需使用时检查或更换代理线路。'
elif key in ('dnsmasq-restart', 'resolver-restart', 'dnsmasq-guard-exhausted', 'resolver-guard-exhausted', 'dns-path-down', 'resolver-silent', 'dns-path-degraded', 'dns-path-recovery'):
    if key in ('dnsmasq-restart', 'resolver-restart'):
        summary = '网站地址查不到，正在自动修复'
        current = '设备可能连着 Wi-Fi 却打不开网站；修复结果还未确认。'
        happened = '网址查询没有回应，已尝试重启相关联网功能。'
        advice = '稍后重试网页；若收到修复失败提醒，需要检查树莓派。'
    elif key in ('dnsmasq-guard-exhausted', 'resolver-guard-exhausted'):
        summary = '网址查询未能自动修复'
        current = '网址查询仍未通过检查，部分或全部网站可能打不开。'
        happened = '自动修复失败或已达到重试上限。'
        advice = '需要检查树莓派和主路由；不要只反复重连 Wi-Fi。'
    elif key == 'dns-path-recovery':
        summary = '设备的网址查询已恢复'
        current = '面向设备的网址查询和后续查询环节均已通过检查。'
        happened = '此前的网址查询异常已通过复查。'
        advice = '重试之前打不开的网站。能正常使用就无需处理。'
    elif key == 'resolver-silent':
        summary = '新打开的网站可能无法加载'
        current = '设备的查询入口仍能回应，但后续网址查询没有回应；已缓存的网站可能还能打开。'
        happened = '网关暂时无法继续获取网站地址。'
        advice = '重试受影响的网站；持续异常时检查树莓派。'
    elif key == 'dns-path-degraded':
        summary = '部分网址查询失败'
        current = '部分网址查询未通过，网站可能偶尔打不开。'
        happened = '不同查询方式的检查结果不一致，尚未确认所有设备都受影响。'
        advice = '先重试网站；持续异常时检查树莓派。'
    else:
        summary = '网站地址查询没有回应'
        current = '设备可能连着 Wi-Fi 却打不开网站。'
        happened = '面向设备的查询入口及后续查询环节都没有回应。'
        advice = '检查树莓派和主路由，留意后续自动修复结果。'
    if key not in ('dns-path-recovery', 'dns-path-degraded', 'resolver-silent'):
        level = 'timeSensitive'
else:
    sys.exit(0)  # Internal events require reviewed user-facing meaning before push.
icon = '✅' if recovered else 'ℹ️' if key == 'test' or key.startswith('self-test:') else '⚠️'
print(level)
print(f'{icon} {summary} · {site}')
print(f'当前：{current}\n发生了什么：{happened}\n建议：{advice}')
PYFORMAT
) || { result=$?; [ "$result" != 75 ] || logger -t mihomo-alert "log-only observation, recheck required: $key"; exit "$result"; }
[ -n "$formatted" ] || { logger -t mihomo-alert "log-only event $key: $message"; exit 0; }
level=$(printf '%s\n' "$formatted" | head -n 1)
title=$(printf '%s\n' "$formatted" | sed -n '2p')
message=$(printf '%s\n' "$formatted" | tail -n +3)

# Pair functional recoveries only with faults accepted by a notification channel.
# Log-only events return success so observers do not retry an intentional filter.
incident=
case "$key" in
  mihomo-failed|mihomo-degraded|mihomo-recovery|mihomo-egress-recovery) incident=gateway ;;
  mosdns-failed|mosdns-degraded|mosdns-recovery) incident=address-query ;;
  dnsmasq-restart|resolver-restart|dnsmasq-guard-exhausted|resolver-guard-exhausted|dns-path-down|resolver-silent|dns-path-degraded|dns-path-recovery) incident=device-address-query ;;
  temp|disk|mem|wan|media-empty:*) incident=${key%-recovered} ;;
  temp-recovered|disk-recovered|mem-recovered|wan-recovered) incident=${key%-recovered} ;;
esac
recovery=0
case "$key" in *-recovered|*-recovery) recovery=1 ;; esac
open_file=$state_file.open
if [ "$recovery" = 1 ] && ! grep -Fxq "$incident" "$open_file" 2>/dev/null; then
  logger -t mihomo-alert "log-only recovery without delivered fault: $key"
  exit 0
fi

if [ "${1:-}" != --test ]; then
  last=$(awk -F'\t' -v k="$key" '$1==k{print $2; exit}' "$state_file" 2>/dev/null || true)
  if [ -n "$last" ] && [ $(( $(date +%s) - last )) -lt "$cooldown" ]; then
    logger -t mihomo-alert "suppressed duplicate: $message"
    # A deferred transition was not delivered; observers must retain it for retry.
    [ "${1:-}" = --health ] && exit 75
    exit 0
  fi
fi


# ServerChan answers HTTP 200 even when the sendkey is wrong; only code==0 is a send.
json_code() {
  python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("code","-"))
except Exception: print("-")' 2>/dev/null || echo -
}
json_detail() {
  python3 -c 'import json,sys
try:
    d=json.load(sys.stdin); print(((d.get("data") or {}).get("error") or d.get("message") or "").replace("\n"," "))
except Exception: print("")' 2>/dev/null || echo ""
}

sc_title=$(python3 -c 'import sys; print(sys.argv[1][:32])' "$title")  # ServerChan caps title at 32 chars
configured=0
delivered=0
if [ -n "${SERVERCHAN_SENDKEY:-}" ]; then
  configured=$((configured + 1))
  # SERVERCHAN_CHANNEL forces a delivery channel (Bark iOS = 8); unset means the
  # channel picked on the sct.ftqq.com site.
  channel_opt=
  [ -n "${SERVERCHAN_CHANNEL:-}" ] && channel_opt="channel=$SERVERCHAN_CHANNEL"
  resp=$(curl -sS -m 8 --data-urlencode "title=$sc_title" \
    --data-urlencode "desp=$message" ${channel_opt:+--data-urlencode "$channel_opt"} \
    "$serverchan_base/$SERVERCHAN_SENDKEY.send" 2>/dev/null || true)
  code=$(printf %s "$resp" | json_code)
  if [ "$code" = 0 ]; then delivered=$((delivered + 1)); sent_channels="${sent_channels:-}serverchan,";
  else logger -t mihomo-alert "serverchan failed (code ${code}): $(printf %s "$resp" | json_detail) $message"; fi
fi
if [ -n "${BARK_URL:-}" ]; then
  configured=$((configured + 1))
  body=$(python3 -c 'import json,sys; print(json.dumps(dict(title=sys.argv[1], body=sys.argv[2], group="树莓派网关", level=sys.argv[3])))' "$title" "$message" "$level")
  resp=$(curl -sS -m 8 -H 'Content-Type: application/json' -d "$body" "$BARK_URL" 2>/dev/null || true)
  code=$(printf %s "$resp" | json_code)
  if [ "$code" = 200 ]; then delivered=$((delivered + 1)); sent_channels="${sent_channels:-}bark,";
  else logger -t mihomo-alert "bark failed (code ${code}): $(printf %s "$resp" | json_detail) $message"; fi
fi

if [ "$delivered" = 0 ]; then
  logger -t mihomo-alert "no channel delivered: $message"
  exit 1
else
  # Only an accepted notification starts cooldown; failed delivery stays retryable.
  {
    printf '%s\t%s\n' "$key" "$(date +%s)"
    awk -F'\t' -v k="$key" '$1!=k' "$state_file" 2>/dev/null | head -n 49 || true
  } >"$state_file.tmp" && mv "$state_file.tmp" "$state_file"
  if [ -n "$incident" ]; then
    {
      awk -v incident="$incident" '$0!=incident' "$open_file" 2>/dev/null || true
      [ "$recovery" = 1 ] || printf '%s\n' "$incident"
    } >"$open_file.tmp" && mv "$open_file.tmp" "$open_file" || exit 1
  fi
  # A delivered alert must leave a trace: without this, "no journal line" is
  # indistinguishable from "sent successfully".
  logger -t mihomo-alert "delivered ${sent_channels%,} ($delivered/$configured): $message"
fi
# --test must exercise every configured channel; a half-delivered self-check is a
# silent outage waiting to happen.
if [ "${1:-}" = --test ] && [ "$delivered" -lt "$configured" ]; then exit 1; fi
exit 0
