#!/bin/sh
# Observe the configured client DNS path; recover its silent dnsmasq, and after a
# run of silent upstream answers escalate to the resolver unit that owns 1053.
set -eu
umask 027
observe=false
case "${1:-}" in
  '') ;;
  --observe-only) observe=true ;;
  *) echo 'usage: mihomo-dnsmasq-guard [--observe-only]' >&2; exit 2 ;;
esac
[ ! -r /etc/mihomo-automation.env ] || . /etc/mihomo-automation.env
client=${DNS_CLIENT_SERVER:-127.0.0.1}
client_port=${DNS_CLIENT_PORT:-53}
unit=${DNS_CLIENT_UNIT:-dnsmasq}
upstream=${DNS_UPSTREAM_SERVER:-127.0.0.1}
upstream_port=${DNS_UPSTREAM_PORT:-5335}
domains=${DNS_PROBE_DOMAINS:-'www.baidu.com www.qq.com'}
resolver_unit=${DNS_RESOLVER_UNIT:-mihomo}
resolver_threshold=${DNS_RESOLVER_FAIL_THRESHOLD:-3}
resolver_gap=${DNS_RESOLVER_RESTART_GAP:-120}
resolver_budget=${DNS_RESOLVER_RESTART_BUDGET:-3}
resolver_window=${DNS_RESOLVER_RESTART_WINDOW:-900}
case "$unit" in ''|-*|*[!A-Za-z0-9_@.:-]*) echo 'invalid DNS client unit' >&2; exit 2 ;; esac
case "$resolver_unit" in ''|-*|*[!A-Za-z0-9_@.:-]*) echo 'invalid DNS resolver unit' >&2; exit 2 ;; esac
for number in "$resolver_threshold" "$resolver_gap" "$resolver_budget" "$resolver_window"; do
  case "$number" in ''|*[!0-9]*) echo 'invalid resolver recovery parameters' >&2; exit 2 ;; esac
done
[ "$resolver_threshold" -ge 1 ] && [ "$resolver_budget" -ge 1 ] && [ "$resolver_window" -ge 1 ] || exit 2
for port in "$client_port" "$upstream_port"; do
  case "$port" in ''|*[!0-9]*) echo 'invalid DNS port' >&2; exit 2 ;; esac
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || exit 2
done
exec 8>/run/lock/mihomo-dnsmasq-guard.lock
flock -n 8 || exit 0
state_dir=/run/mihomo-dnsmasq-guard
status_file=$state_dir/status
last_notified_file=$state_dir/last-notified
install -d -m 755 "$state_dir"
restart_gap=20
restart_budget=3
restart_window=900
alert=/usr/local/sbin/mihomo-alert
now=$(date +%s)
checks=0
for domain in $domains; do checks=$((checks + 1)); done
[ "$checks" -gt 0 ] || exit 2

answers() {
  server=$1; port=$2; transport=$3; got=0
  for domain in $domains; do
    # A nonempty dig error or a CNAME alone does not prove a usable DNS answer.
    if dig @"$server" -p "$port" "$domain" A +time=1 +tries=1 +noall +answer +comments "$transport" 2>/dev/null |
      awk '
        /status: NOERROR,/ { ok=1 }
        $3=="IN" && $4=="A" {
          count=split($5, octets, "."); valid=(count==4)
          for (i=1;i<=count;i++) if (octets[i]!~/^[0-9]+$/ || octets[i]>255) valid=0
          if (valid) address=1
        }
        END { exit !(ok && address) }'; then got=$((got + 1)); fi
  done
  printf '%s' "$got"
}
client_udp=$(answers "$client" "$client_port" +notcp)
client_tcp=$(answers "$client" "$client_port" +tcp)
upstream_udp=$(answers "$upstream" "$upstream_port" +notcp)
upstream_tcp=$(answers "$upstream" "$upstream_port" +tcp)
host_mosdns=$upstream_udp
if [ "$upstream:$upstream_port" != '127.0.0.1:5335' ]; then
  host_mosdns=$(answers 127.0.0.1 5335 +notcp)
fi
lan_answers=$client_udp
resolver_answers=$upstream_udp
client_total=$((client_udp + client_tcp))
upstream_total=$((upstream_udp + upstream_tcp))
action=none; reason=healthy
if [ "$client_total" -eq 0 ] && [ "$upstream_total" -eq 0 ]; then
  reason=resolver-chain-down; action=chain-down
elif [ "$client_total" -eq 0 ]; then
  reason=dnsmasq-silent; action=restart
elif [ "$upstream_total" -eq 0 ]; then
  reason=resolver-silent; action=escalate-resolver
elif [ "$client_udp" -ne "$checks" ] || [ "$client_tcp" -ne "$checks" ] ||
     [ "$upstream_udp" -ne "$checks" ] || [ "$upstream_tcp" -ne "$checks" ]; then
  reason=degraded; action=degraded-watch
fi

# Observations continue during an update. Only the recovery action shares its
# maintenance lock, held until restart finishes so update and recovery cannot race.
maintenance=0
exec 9>/run/lock/mihomo-maintenance.lock
flock -n 9 || maintenance=1
notify() {
  [ "$observe" = false ] || return 1
  [ -x "$alert" ] || return 1
  if "$alert" --health "$2" "$1" >/dev/null 2>&1; then
    if [ "$1" != dns-path-recovery ] && ! grep -Fxq "$1" "$last_notified_file" 2>/dev/null; then
      printf '%s\n' "$1" >>"$last_notified_file"
    fi
    return 0
  fi
  return 1
}

# The resolver that owns the client upstream (1053 on this gateway) is a second
# failure domain.  A single silent observation only alerts: restarting a core
# because of one lost packet drops every live connection.  A run of failures
# escalates to the resolver unit, under the same maintenance lock and a separate
# budget so client recovery and resolver recovery cannot exhaust each other.
resolver_action=none
resolver_fail_streak=$(cat "$state_dir/resolver-failures" 2>/dev/null || echo 0)
case "$resolver_fail_streak" in ''|*[!0-9]*) resolver_fail_streak=0 ;; esac
if [ "$observe" = false ] && [ "$maintenance" = 0 ]; then
  case "$action" in
    chain-down|escalate-resolver)
      resolver_fail_streak=$((resolver_fail_streak + 1))
      printf '%s\n' "$resolver_fail_streak" >"$state_dir/resolver-failures"
      if [ "$resolver_fail_streak" -ge "$resolver_threshold" ]; then
        cutoff=$((now - resolver_window))
        if [ -f "$state_dir/resolver-restarts" ]; then
          awk -v cutoff="$cutoff" '$1 >= cutoff' "$state_dir/resolver-restarts" >"$state_dir/resolver-restarts.tmp"
          mv "$state_dir/resolver-restarts.tmp" "$state_dir/resolver-restarts"
        fi
        used=0; last=0
        [ ! -f "$state_dir/resolver-restarts" ] || used=$(wc -l <"$state_dir/resolver-restarts" | tr -d ' ')
        [ ! -f "$state_dir/resolver-last-restart" ] || last=$(cat "$state_dir/resolver-last-restart")
        case "$last" in *[!0-9]*|'') last=0 ;; esac
        if [ "$used" -ge "$resolver_budget" ]; then
          resolver_action=throttled
          grep -Fxq resolver-guard-exhausted "$last_notified_file" 2>/dev/null || \
            notify resolver-guard-exhausted "DNS resolver $resolver_unit exhausted recovery budget; client=$client_udp/$client_tcp upstream=$upstream_udp/$upstream_tcp" || true
        elif [ $((now - last)) -lt "$resolver_gap" ]; then
          resolver_action=gap
        else
          printf '%s\n' "$now" >>"$state_dir/resolver-restarts"
          printf '%s\n' "$now" >"$state_dir/resolver-last-restart"
          if systemctl restart "$resolver_unit"; then
            resolver_action=restart
            resolver_fail_streak=0
            printf '0\n' >"$state_dir/resolver-failures"
            notify resolver-restart "Requested DNS resolver recovery: $resolver_unit; client=$client_udp/$client_tcp upstream=$upstream_udp/$upstream_tcp" || true
          else
            resolver_action=restart-failed
            notify resolver-guard-exhausted "DNS resolver recovery failed: $resolver_unit" || true
          fi
        fi
      fi ;;
    *)
      printf '0\n' >"$state_dir/resolver-failures"
      resolver_fail_streak=0 ;;
  esac
fi
if [ "$action" = restart ]; then
  if [ "$observe" = true ]; then action='observe-only'
  elif [ "$maintenance" = 1 ]; then action=maintenance
  else
    cutoff=$((now - restart_window))
    if [ -f "$state_dir/restarts" ]; then
      awk -v cutoff="$cutoff" '$1 >= cutoff' "$state_dir/restarts" >"$state_dir/restarts.tmp"
      mv "$state_dir/restarts.tmp" "$state_dir/restarts"
    fi
    used=0; last=0
    [ ! -f "$state_dir/restarts" ] || used=$(wc -l <"$state_dir/restarts" | tr -d ' ')
    [ ! -f "$state_dir/last-restart" ] || last=$(cat "$state_dir/last-restart")
    case "$last" in *[!0-9]*|'') last=0 ;; esac
    if [ "$used" -ge "$restart_budget" ]; then
      action=throttled
      notify dnsmasq-guard-exhausted "DNS client $unit exhausted recovery budget; client=$client_udp/$client_tcp upstream=$upstream_udp/$upstream_tcp" || true
    elif [ $((now - last)) -lt "$restart_gap" ]; then action=restart-gap
    else
      printf '%s\n' "$now" >>"$state_dir/restarts"
      printf '%s\n' "$now" >"$state_dir/last-restart"
      if systemctl restart "$unit"; then
        notify dnsmasq-restart "Requested DNS client recovery: $unit; upstream answers, client UDP and TCP are silent" || true
      else
        action=restart-failed
        notify dnsmasq-guard-exhausted "DNS client recovery failed: $unit" || true
      fi
    fi
  fi
elif [ "$action" = chain-down ]; then
  notify dns-path-down "DNS client and its actual upstream are silent; no client restart: $unit upstream=$upstream:$upstream_port" || true
elif [ "$action" = escalate-resolver ]; then
  notify resolver-silent "DNS client answers but its actual upstream is silent; no client restart: $unit" || true
fi
if [ "$reason" = degraded ] && [ "$observe" = false ] &&
   ! grep -Fxq dns-path-degraded "$last_notified_file" 2>/dev/null; then
  notify dns-path-degraded "DNS path degraded: client UDP/TCP=$client_udp/$client_tcp upstream UDP/TCP=$upstream_udp/$upstream_tcp; passing=$checks" || true
elif [ "$reason" = healthy ] && [ "$observe" = false ] && [ -s "$last_notified_file" ]; then
  if notify dns-path-recovery "DNS path recovered: all $checks client and upstream UDP/TCP checks pass"; then
    : >"$last_notified_file"
  fi
fi
mode=stopped
systemctl is-active --quiet "$unit" && mode=running
printf '%s mode=%s reason=%s lan=%s/%s resolver=%s/%s client_udp=%s client_tcp=%s upstream_udp=%s upstream_tcp=%s host_mosdns=%s unit=%s upstream=%s:%s maintenance=%s action=%s resolver_unit=%s resolver_fail_streak=%s resolver_action=%s\n' \
  "$(date -Is)" "$mode" "$reason" "$lan_answers" "$checks" "$resolver_answers" "$checks" \
  "$client_udp" "$client_tcp" "$upstream_udp" "$upstream_tcp" "$host_mosdns" "$unit" "$upstream" "$upstream_port" "$maintenance" "$action" \
  "$resolver_unit" "$resolver_fail_streak" "$resolver_action" >"$status_file"
exit 0
