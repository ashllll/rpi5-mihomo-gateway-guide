#!/bin/sh

set -eu
umask 027

exec 9>/run/lock/mosdns-rules-update.lock
flock -n 9 || exit 0

rules_root=/etc/mosdns/rules
current_link=$rules_root/current
releases_dir=$rules_root/releases
pending_file=$rules_root/pending
maintenance_lock=/run/lock/mihomo-maintenance.lock
# Deployment parameters.  See automation/env/automation.env.example; copy it to
# /etc/mihomo-automation.env and adjust the values before the first run.
if [ -r /etc/mihomo-automation.env ]; then
  . /etc/mihomo-automation.env
fi
: "${MIHOMO_MIXED_PORT:=7890}"
proxy=http://127.0.0.1:${MIHOMO_MIXED_PORT}
work_dir=$(mktemp -d /var/tmp/mosdns-rules.XXXXXX)
test_pid=
update_started=false
rolling_back=false
pending_phase=
pending_old_target=
pending_new_target=
old_target=
new_target=

sync_path() {
  python3 -c 'import os, sys
descriptor = os.open(sys.argv[1], os.O_RDONLY)
try:
    os.fsync(descriptor)
finally:
    os.close(descriptor)' "$1"
}

cleanup() {
  result=$?
  trap - EXIT HUP INT TERM
  if [ -n "$test_pid" ] && kill -0 "$test_pid" 2>/dev/null; then
    kill -TERM "$test_pid" 2>/dev/null || true
    wait "$test_pid" 2>/dev/null || true
  fi
  if [ "$update_started" = true ] && [ -s "$pending_file" ] && [ "$rolling_back" != true ]; then
    rolling_back=true
    if rollback_transaction; then
      logger -t mosdns-update-rules "Interrupted rules update rolled back to the previous release"
    else
      logger -t mosdns-update-rules "Interrupted rules update rollback failed; pending record retained"
    fi
  fi
  case "$work_dir" in
    /var/tmp/mosdns-rules.*) rm -rf -- "$work_dir" ;;
  esac
  exit "$result"
}
trap cleanup EXIT HUP INT TERM

fetch() {
  output=$1
  url=$2
  # Direct first: the host's own traffic bypasses the tunnel, so a direct
  # fetch bills no proxy traffic. Fall back to the mixed port when blocked.
  curl --fail --location --silent --show-error \
    --connect-timeout 3 --max-time 30 \
    --proto '=https' --tlsv1.2 \
    --output "$output" "$url" ||
  curl --fail --location --silent --show-error \
    --proxy "$proxy" \
    --connect-timeout 10 --max-time 120 \
    --retry 2 --retry-delay 2 \
    --proto '=https' --tlsv1.2 \
    --output "$output" "$url"
}

write_pending() {
  pending_phase=$1
  pending_old_target=$2
  pending_new_target=$3
  temporary=$pending_file.tmp.$$
  {
    printf 'format=1\n'
    printf 'kind=rules\n'
    printf 'phase=%s\n' "$pending_phase"
    printf 'old_target=%s\n' "$pending_old_target"
    printf 'new_target=%s\n' "$pending_new_target"
  } >"$temporary" || { rm -f -- "$temporary"; return 1; }
  chmod 600 "$temporary" || { rm -f -- "$temporary"; return 1; }
  sync_path "$temporary" || { rm -f -- "$temporary"; return 1; }
  mv -f -- "$temporary" "$pending_file" || { rm -f -- "$temporary"; return 1; }
  sync_path "$pending_file"
}

read_pending() {
  pending_phase=
  pending_old_target=
  pending_new_target=
  kind=
  while IFS='=' read -r key value; do
    case "$key" in
      format) [ "$value" = 1 ] || return 1 ;;
      kind) kind=$value ;;
      phase) pending_phase=$value ;;
      old_target) pending_old_target=$value ;;
      new_target) pending_new_target=$value ;;
    esac
  done <"$pending_file"
  [ "$kind" = rules ] || return 1
  case "$pending_phase" in
    prepared|applied|committed|restoring) ;;
    *) return 1 ;;
  esac
  case "$pending_new_target" in
    releases/*[!0-9A-Za-z._-]*|releases/|'') return 1 ;;
  esac
  case "$pending_old_target" in
    '') ;;
    releases/*[!0-9A-Za-z._-]*) return 1 ;;
  esac
}

clear_pending() {
  rm -f -- "$pending_file"
  sync_path "$rules_root"
}

current_target() {
  if [ -L "$current_link" ]; then
    readlink "$current_link"
  else
    printf ''
  fi
}

# Hash the five rule files by content only.  sha256sum prints the path next to
# each digest, so hashing its whole output would compare directory names and
# never match even when the downloaded rules are identical.
content_hash() {
  directory=$1
  for file in direct-list.txt proxy-list.txt apple-cn.txt google-cn.txt geoip-cn.txt; do
    sha256sum "$directory/$file"
  done | awk '{ print $1 }' | sha256sum | cut -d' ' -f1
}

switch_current() {
  target=$1
  new_link=$rules_root/.current.new.$$
  rm -f -- "$new_link"
  ln -s "$target" "$new_link" || return 1
  mv -Tf -- "$new_link" "$current_link" || { rm -f -- "$new_link"; return 1; }
  sync_path "$rules_root"
}

restore_current() {
  target=$1
  if [ -n "$target" ]; then
    [ -d "$rules_root/$target" ] || return 1
    switch_current "$target"
  else
    rm -f -- "$current_link"
    sync_path "$rules_root"
  fi
}

# A rules record that is not committed means the new release never passed its
# health gate.  Restore the recorded old target instead of trusting whatever
# symlink the crash left behind.
recover_pending() {
  [ -s "$pending_file" ] || return 0
  if ! read_pending; then
    logger -t mosdns-update-rules "Pending rules record is invalid; refusing to guess"
    return 1
  fi
  current=$(current_target)
  if [ "$pending_phase" = committed ]; then
    if [ "$current" = "$pending_new_target" ]; then
      clear_pending
      logger -t mosdns-update-rules "Committed rules release already passed its health gate"
      return 0
    fi
    logger -t mosdns-update-rules "Committed rules release no longer matches the current link"
    return 1
  fi
  if [ "$current" = "$pending_old_target" ]; then
    clear_pending
    logger -t mosdns-update-rules "Pending rules update had not switched the current link; record cleared"
    return 0
  fi
  if [ -n "$pending_old_target" ] && [ ! -d "$rules_root/$pending_old_target" ]; then
    logger -t mosdns-update-rules "Pending rules record names a missing old release"
    return 1
  fi
  write_pending restoring "$pending_old_target" "$pending_new_target" || return 1
  if ! restore_current "$pending_old_target"; then
    logger -t mosdns-update-rules "Could not restore the recorded old rules release"
    return 1
  fi
  if ! systemctl restart mosdns.service; then
    logger -t mosdns-update-rules "Could not restart mosdns after restoring the old rules"
    return 1
  fi
  if /usr/local/sbin/mosdns-healthcheck; then
    logger -t mosdns-update-rules "Interrupted rules update rolled back; the old rules are healthy"
  else
    logger -t mosdns-update-rules "Interrupted rules update rolled back; the old rules failed their health check"
  fi
  clear_pending
}

rollback_transaction() {
  [ -n "$new_target" ] || return 1
  write_pending restoring "$old_target" "$new_target" || return 1
  if ! restore_current "$old_target"; then
    logger -t mosdns-update-rules "Restoring the previous rules release failed"
    return 1
  fi
  systemctl restart mosdns.service || true
  if ! /usr/local/sbin/mosdns-healthcheck; then
    logger -t mosdns-update-rules "Previous rules release failed its post-rollback health check"
  fi
  clear_pending
}

# Recovery is the first thing a new run does, before any network access: the
# pending record decides which rules release is current, not the download hash.
if [ -s "$pending_file" ]; then
  if [ "${MOSDNS_UPDATE_DRY_RUN:-0}" = 1 ]; then
    logger -t mosdns-update-rules "A pending rules recovery is required before a dry run"
    exit 1
  fi
  exec 8>"$maintenance_lock"
  if ! flock -n 8; then
    logger -t mosdns-update-rules "Pending rules recovery is waiting for maintenance"
    exit 1
  fi
  if ! recover_pending; then
    exit 1
  fi
  exit 0
fi

fetch "$work_dir/rules-release.json" \
  https://api.github.com/repos/Loyalsoldier/v2ray-rules-dat/releases/latest

for file in direct-list.txt proxy-list.txt apple-cn.txt google-cn.txt; do
  asset_url=$(jq -er --arg name "$file" \
    '.assets[] | select(.name == $name) | .browser_download_url' \
    "$work_dir/rules-release.json")
  asset_digest=$(jq -er --arg name "$file" \
    '.assets[] | select(.name == $name) | .digest' \
    "$work_dir/rules-release.json")
  case "$asset_url" in
    https://github.com/Loyalsoldier/v2ray-rules-dat/releases/download/*/"$file")
      ;;
    *) exit 1 ;;
  esac
  case "$asset_digest" in
    sha256:*) ;;
    *) exit 1 ;;
  esac
  fetch "$work_dir/$file" "$asset_url"
  expected_sha256=${asset_digest#sha256:}
  actual_sha256=$(sha256sum "$work_dir/$file" | cut -d' ' -f1)
  [ "$actual_sha256" = "$expected_sha256" ]
done

fetch "$work_dir/geoip-commit.json" \
  https://api.github.com/repos/Loyalsoldier/geoip/commits/release
geoip_commit=$(jq -er '.sha' "$work_dir/geoip-commit.json")
case "$geoip_commit" in
  *[!0-9a-f]*|'') exit 1 ;;
esac
[ "${#geoip_commit}" -eq 40 ]

fetch "$work_dir/geoip-content.json" \
  "https://api.github.com/repos/Loyalsoldier/geoip/contents/text/cn.txt?ref=$geoip_commit"
geoip_blob=$(jq -er '.sha' "$work_dir/geoip-content.json")
fetch "$work_dir/geoip-cn.txt" \
  "https://raw.githubusercontent.com/Loyalsoldier/geoip/$geoip_commit/text/cn.txt"
geoip_size=$(wc -c <"$work_dir/geoip-cn.txt")
actual_blob=$(
  {
    printf 'blob %s\0' "$geoip_size"
    cat "$work_dir/geoip-cn.txt"
  } | sha1sum | cut -d' ' -f1
)
[ "$actual_blob" = "$geoip_blob" ]

sed -i 's/\r$//' "$work_dir"/*.txt

[ "$(wc -l <"$work_dir/direct-list.txt")" -ge 50000 ]
[ "$(wc -l <"$work_dir/proxy-list.txt")" -ge 10000 ]
[ "$(wc -l <"$work_dir/apple-cn.txt")" -ge 100 ]
[ "$(wc -l <"$work_dir/google-cn.txt")" -ge 50 ]
[ "$(wc -l <"$work_dir/geoip-cn.txt")" -ge 3000 ]

for file in direct-list.txt proxy-list.txt apple-cn.txt google-cn.txt geoip-cn.txt; do
  [ -s "$work_dir/$file" ]
  grep -q '[^[:space:]]' "$work_dir/$file"
done

if [ -f "$current_link/direct-list.txt" ] &&
   [ -f "$current_link/proxy-list.txt" ] &&
   [ -f "$current_link/apple-cn.txt" ] &&
   [ -f "$current_link/google-cn.txt" ] &&
   [ -f "$current_link/geoip-cn.txt" ]; then
  old_hash=$(content_hash "$current_link")
  new_hash=$(content_hash "$work_dir")
  if [ "$old_hash" = "$new_hash" ] &&
     [ "${MOSDNS_UPDATE_DRY_RUN:-0}" != 1 ]; then
    exit 0
  fi
fi

test_dns_port=$((20000 + $$ % 10000))
test_api_port=$((40000 + $$ % 10000))
test_config=$work_dir/config.yaml
sed \
  -e "s#/etc/mosdns/rules/current/direct-list.txt#$work_dir/direct-list.txt#" \
  -e "s#/etc/mosdns/rules/current/proxy-list.txt#$work_dir/proxy-list.txt#" \
  -e "s#/etc/mosdns/rules/current/apple-cn.txt#$work_dir/apple-cn.txt#" \
  -e "s#/etc/mosdns/rules/current/google-cn.txt#$work_dir/google-cn.txt#" \
  -e "s#/etc/mosdns/rules/current/geoip-cn.txt#$work_dir/geoip-cn.txt#" \
  -e "s#127.0.0.1:5335#127.0.0.1:$test_dns_port#g" \
  -e "s#127.0.0.1:9091#127.0.0.1:$test_api_port#g" \
  /etc/mosdns/config.yaml >"$test_config"

/usr/local/bin/mosdns start -c "$test_config" -d "$work_dir" \
  >"$work_dir/validation.log" 2>&1 &
test_pid=$!

validated=false
attempt=1
while [ "$attempt" -le 30 ]; do
  if ! kill -0 "$test_pid" 2>/dev/null; then
    break
  fi
  if curl --fail --silent --max-time 1 \
    "http://127.0.0.1:$test_api_port/metrics" >/dev/null 2>&1; then
    test_answer=$(dig @127.0.0.1 -p "$test_dns_port" baidu.com A \
      +time=2 +tries=1 +short 2>/dev/null |
      awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ { print; exit }')
    if [ -n "$test_answer" ]; then
      validated=true
      break
    fi
  fi
  attempt=$((attempt + 1))
  sleep 0.2
done

if [ "$validated" != true ]; then
  logger -t mosdns-update-rules "candidate rules failed mosdns validation"
  sed -n '1,80p' "$work_dir/validation.log" >&2
  exit 1
fi

kill -TERM "$test_pid"
wait "$test_pid" || true
test_pid=

if [ "${MOSDNS_UPDATE_DRY_RUN:-0}" = 1 ]; then
  logger -t mosdns-update-rules "rules passed download and candidate validation"
  exit 0
fi

# Only download and candidate validation happen outside the maintenance lock;
# switching the current release and restarting mosdns hold it.
exec 8>"$maintenance_lock"
if ! flock -n 8; then
  logger -t mosdns-update-rules "Maintenance is active; candidate discarded"
  exit 0
fi
if [ -s "$pending_file" ]; then
  if ! recover_pending; then
    exit 1
  fi
  exit 0
fi

rules_tag=$(jq -er '.tag_name' "$work_dir/rules-release.json")
case "$rules_tag" in
  *[!0-9A-Za-z._-]*|'') exit 1 ;;
esac
geoip_short=$(printf '%.8s' "$geoip_commit")
version="${rules_tag}-${geoip_short}"
release_dir=$releases_dir/$version
install -d -o root -g root -m 755 "$releases_dir"
install -d -o root -g root -m 755 "$release_dir"
for file in direct-list.txt proxy-list.txt apple-cn.txt google-cn.txt geoip-cn.txt; do
  install -o root -g root -m 644 "$work_dir/$file" "$release_dir/$file"
  sync_path "$release_dir/$file"
done
{
  printf 'rules_release=%s
' "$rules_tag"
  printf 'geoip_commit=%s
' "$geoip_commit"
  sha256sum     "$release_dir/direct-list.txt"     "$release_dir/proxy-list.txt"     "$release_dir/apple-cn.txt"     "$release_dir/google-cn.txt"     "$release_dir/geoip-cn.txt"
} >"$release_dir/source.txt"
chmod 644 "$release_dir/source.txt"
sync_path "$release_dir/source.txt"
sync_path "$release_dir"
sync_path "$releases_dir"

old_target=$(current_target)
new_target=releases/$version
write_pending prepared "$old_target" "$new_target"

update_started=true
switch_current "$new_target"
write_pending applied "$old_target" "$new_target"

if systemctl restart mosdns.service &&
   /usr/local/sbin/mosdns-healthcheck; then
  write_pending committed "$old_target" "$new_target"
  clear_pending
  update_started=false
  logger -t mosdns-update-rules "rules updated successfully"
  current_target_link=$(current_target)
  find "$releases_dir" -mindepth 1 -maxdepth 1 -type d     -printf '%T@ %p
' | sort -nr | awk 'NR > 5 { print $2 }' |
    while IFS= read -r old_release; do
      case "$old_release" in
        "$releases_dir"/*)
          [ "releases/${old_release##*/}" = "$current_target_link" ] ||
            rm -rf -- "$old_release"
          ;;
      esac
    done
  exit 0
fi

logger -t mosdns-update-rules "rules update failed health checks; rolling back"
if rollback_transaction; then
  logger -t mosdns-update-rules "rules update rolled back to $old_target"
else
  logger -t mosdns-update-rules "rules update rollback failed; pending record retained"
fi
update_started=false
exit 1
