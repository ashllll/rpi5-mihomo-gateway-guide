[Unit]
Description=Rank download candidates with bounded workload samples
Wants=network-online.target
After=network-online.target mihomo.service

[Service]
EnvironmentFile=-/etc/mihomo-automation.env
Type=oneshot
ExecStart=/usr/local/sbin/mihomo-download-quality
TimeoutStartSec=120
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/etc/mihomo/providers /var/lib/mihomo-download-quality

