[Unit]
Description=Shared admission budget for Mihomo core health checks

[Service]
EnvironmentFile=-/etc/mihomo-automation.env
Type=simple
ExecStart=/usr/local/sbin/mihomo-measurement-budget
Restart=on-failure
RuntimeDirectory=mihomo-measurements
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mihomo-measurements /run/mihomo-measurements

[Install]
WantedBy=multi-user.target
