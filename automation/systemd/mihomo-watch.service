[Unit]
Description=Gateway-wide anomaly watchdog (failed units, thermal, disk, memory, WAN)
Documentation=file:///var/lib/mihomo-images/build-20261012/repo/automation/README.zh-CN.md
After=network-online.target
Wants=network-online.target
OnFailure=mihomo-alert@%N.service

[Service]
EnvironmentFile=-/etc/mihomo-alert.env
Type=oneshot
ExecStart=/usr/local/sbin/mihomo-watch
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/run
