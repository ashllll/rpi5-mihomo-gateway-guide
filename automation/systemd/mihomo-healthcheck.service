[Unit]
Description=Mihomo process liveness check and stopped-process recovery
Wants=network-online.target
After=network-online.target mihomo.service

[Service]
# Deployment parameters (ports, interfaces; the probe itself uses loopback).
EnvironmentFile=-/etc/mihomo-automation.env
Type=oneshot
ExecStart=/usr/local/sbin/mihomo-healthcheck
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true

