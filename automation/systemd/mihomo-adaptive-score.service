[Unit]
Description=Collect per-service Mihomo node quality scores (shadow mode)
Wants=network-online.target
After=network-online.target mihomo.service

[Service]
# Deployment parameters (GATEWAY_LAN_IP, ports, interfaces).
EnvironmentFile=-/etc/mihomo-automation.env
Type=oneshot
ExecStart=/usr/local/sbin/mihomo-adaptive-score
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/mihomo-adaptive

