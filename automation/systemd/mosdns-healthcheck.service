[Unit]
Description=Verify mosdns split-DNS behavior and select a safe fallback
Wants=network-online.target
After=network-online.target mosdns.service mihomo.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mosdns-healthcheck
RuntimeDirectory=mosdns-healthcheck
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
Nice=10
IOSchedulingClass=idle
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/dnsmasq-upstreams.conf
ProtectHostname=true
ProtectClock=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
